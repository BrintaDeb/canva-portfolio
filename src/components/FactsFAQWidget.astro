        background: rgba(255, 255, 255, 0.05);
      }
    }

    // Panes
    .facts-pane {
      display: none;
      overflow-y: auto;
      max-height: 280px;
      padding-right: 0.25rem;

      &::-webkit-scrollbar {
        width: 3px;
      }

      &::-webkit-scrollbar-track {
