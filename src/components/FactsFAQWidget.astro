---
/**
 * FactsFAQWidget.astro
 * Chic, floating, minimizable client knowledge base.
 * Features quick delivery facts & interactive client FAQ accordion.
 */

const facts = [
  {
    icon: '⚡',
    title: '7-Day Sprint Delivery',
    desc: 'Rapid 7-business-day turnaround for standard websites & complete redesigns.',
  },
  {
    icon: '🎯',
    title: '3, 7, 12 Revisions',
    desc: 'Generous revisions included per tier. Extra revisions flat ₹400/round thereafter.',
  },
  {
    icon: '🔒',
    title: '50/50 Milestones',
    desc: '50% advance on kickoff, 50% only after final sign-off & live production deployment.',
  },
  {
    icon: '📞',
    title: '₹100 Discovery Call',
    desc: 'Instant UPI QR pre-fill for ₹100 direct 1-on-1 private strategy consultation.',
  },
  {
    icon: '🌐',
    title: 'Global Timezone Sync',
    desc: 'Active working overlap across US, UK, Europe, UAE, and Indian Standard Time.',
  },
  {
    icon: '🛠️',
    title: 'Modern Tech Stack',
    desc: 'Next.js App Router, Astro, GSAP Motion, React, Tailwind, Canva Pro & Figma.',
  },
]

const faqs = [
  {
    q: 'How many revisions do I get, and how do extra rounds work?',
    a: 'Each web development package includes 3, 7, or 12 full revision cycles depending on your selected tier. If you ever need additional fine-tuning beyond your package allowance, extra revisions are charged transparently at an honest flat rate of ₹400 per round with rapid 24-hour turnaround.',
  },
  {
    q: 'What is the typical timeline for delivering a project?',
    a: 'Standard portfolio websites, high-converting landing pages, and redesigns are completed and deployed live within 7 business days using our 4-step framework. Custom full-stack web applications and complex e-commerce portals typically take 2 to 3 weeks.',
  },
  {
    q: 'How does the ₹100 Discovery Call work?',
    a: 'Scan the on-page QR code with any UPI app (GPay, PhonePe, Paytm) — it automatically pre-fills ₹100. Send the transaction screenshot or UTR to WhatsApp (+91 87941 74780), and we immediately schedule your dedicated 30-minute 1-on-1 strategy call.',
  },
  {
    q: 'Do you provide design (Canva/Figma) as well as production code?',
    a: 'Yes! We deliver end-to-end design systems, Canva presentation pitch decks, and brand identity in Figma, combined with bespoke, high-performance production code in Next.js, React, and Astro.',
  },
  {
    q: 'Can you redesign and speed up my existing outdated website?',
    a: 'Absolutely. We frequently rebuild slow WordPress, Wix, or Shopify sites into blazing-fast Astro or Next.js architectures, consistently achieving sub-second load speeds and 95+ Google Lighthouse scores.',
  },
  {
    q: 'How do we communicate throughout the project lifecycle?',
    a: 'We provide daily async updates via WhatsApp or a private Slack channel, alongside private Notion project dashboards and recorded Loom video walkthroughs for every milestone.',
  },
]
---

<div class="facts-widget js-facts-widget" id="facts-faq-widget">
  <!-- Minimizable Bottom Pill Bar -->
  <div class="facts-widget__bar js-facts-toggle" title="Click to view Facts & FAQ">
    <div class="facts-widget__badge">
      <span class="facts-widget__dot"></span>
      <span class="facts-widget__icon">💡</span>
    </div>

    <div class="facts-widget__meta">
      <span class="facts-widget__title">Facts &amp; FAQ</span>
      <span class="facts-widget__status">QUICK ANSWERS // 6 FAQS</span>
    </div>

    <button class="facts-widget__btn js-facts-btn" type="button" aria-label="Expand or minimize Facts and FAQ">
      <svg class="icon icon-plus js-icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <svg class="icon icon-minus js-icon-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: none;">
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
  </div>

  <!-- Expandable Knowledge Drawer -->
  <div class="facts-widget__drawer js-facts-drawer">
    <!-- Header -->
    <div class="facts-widget__header">
      <div class="facts-widget__branding">
        <span class="facts-widget__tape-dot"></span>
        <span class="facts-widget__tag">CLIENT GUIDE // KNOWLEDGE BASE</span>
      </div>
      <button type="button" class="facts-widget__close-btn js-facts-close" aria-label="Minimize drawer" title="Minimize [Esc]">✕</button>
    </div>

    <!-- Tabs Nav -->
    <div class="facts-widget__tabs">
      <button type="button" class="facts-tab is-active js-tab-btn" data-tab="faq">
        <span class="facts-tab__icon">❓</span>
        <span>CLIENT FAQ</span>
      </button>
      <button type="button" class="facts-tab js-tab-btn" data-tab="facts">
        <span class="facts-tab__icon">⚡</span>
        <span>QUICK FACTS</span>
      </button>
    </div>

    <!-- Tab Pane 1: FAQs (Accordion) -->
    <div class="facts-pane is-active js-pane" id="pane-faq">
      <div class="facts-accordion">
        {
          faqs.map((faq, index) => (
            <div class={`facts-faq-item js-faq-item ${index === 0 ? 'is-open' : ''}`}>
              <button type="button" class="facts-faq-q js-faq-q">
                <span class="facts-faq-q__num">0{index + 1}</span>
                <span class="facts-faq-q__text">{faq.q}</span>
                <svg class="facts-faq-q__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="facts-faq-a js-faq-a">
                <p>{faq.a}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Tab Pane 2: Quick Facts -->
    <div class="facts-pane js-pane" id="pane-facts">
      <div class="facts-grid">
        {
          facts.map((fact) => (
            <div class="facts-card">
              <div class="facts-card__header">
                <span class="facts-card__icon">{fact.icon}</span>
                <strong class="facts-card__title">{fact.title}</strong>
              </div>
              <p class="facts-card__desc">{fact.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Footer Action -->
    <div class="facts-widget__footer">
      <a
        href="https://wa.me/918794174780?text=Hi%20Brinta!%20I%20have%20a%20question%20about%20your%20services."
        target="_blank"
        rel="noopener noreferrer"
        class="facts-widget__cta"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>Have More Questions? Chat on WhatsApp</span>
        <svg class="facts-widget__cta-arrow" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M7 17L17 7M17 7H7M17 7V17"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  import { audioEngine } from '../utils/AudioEngine.js'

  class FactsFAQWidget {
    el: HTMLElement | null
    bar: HTMLElement | null
    drawer: HTMLElement | null
    btn: HTMLButtonElement | null
    iconPlus: HTMLElement | null
    iconMinus: HTMLElement | null
    tabBtns: NodeListOf<HTMLButtonElement>
    panes: NodeListOf<HTMLElement>
    faqItems: NodeListOf<HTMLElement>

    constructor() {
      this.el = document.getElementById('facts-faq-widget')
      if (!this.el) return

      this.bar = this.el.querySelector('.js-facts-toggle')
      this.drawer = this.el.querySelector('.js-facts-drawer')
      this.btn = this.el.querySelector('.js-facts-btn')
      this.iconPlus = this.el.querySelector('.js-icon-plus')
      this.iconMinus = this.el.querySelector('.js-icon-minus')
      this.tabBtns = this.el.querySelectorAll('.js-tab-btn')
      this.panes = this.el.querySelectorAll('.js-pane')
      this.faqItems = this.el.querySelectorAll('.js-faq-item')

      this.init()
    }

    init() {
      // Toggle expanded drawer on header bar click
      this.bar?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.js-facts-close')) return
        this.toggle()
      })

      // Close button inside drawer
      this.el?.querySelector('.js-facts-close')?.addEventListener('click', (e) => {
        e.stopPropagation()
        this.close()
      })

      // Click outside to close drawer
      document.addEventListener('click', (e) => {
        if (this.el?.classList.contains('is-expanded')) {
          if (!this.el.contains(e.target as Node)) {
            this.close()
          }
        }
      })

      // Keyboard Esc to close
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.el?.classList.contains('is-expanded')) {
          this.close()
        }
      })

      // Tab switcher
      this.tabBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation()
          const targetTab = btn.dataset.tab
          this.switchTab(targetTab)
          audioEngine?.playTab?.()
        })
      })

      // FAQ Accordion items
      this.faqItems.forEach((item) => {
        const qBtn = item.querySelector('.js-faq-q')
        qBtn?.addEventListener('click', (e) => {
          e.stopPropagation()
          const isOpen = item.classList.contains('is-open')
          // Close others for clean single-open accordion feel
          this.faqItems.forEach((other) => other.classList.remove('is-open'))
          if (!isOpen) {
            item.classList.add('is-open')
            audioEngine?.playClick?.()
          }
        })
      })
    }

    toggle() {
      const isExpanded = this.el?.classList.toggle('is-expanded')
      this.updateIcons(!!isExpanded)
      audioEngine?.playTab?.()
    }

    close() {
      this.el?.classList.remove('is-expanded')
      this.updateIcons(false)
    }

    updateIcons(isExpanded: boolean) {
      if (this.iconPlus && this.iconMinus) {
        this.iconPlus.style.display = isExpanded ? 'none' : 'block'
        this.iconMinus.style.display = isExpanded ? 'block' : 'none'
      }
    }

    switchTab(tabName?: string) {
      if (!tabName) return

      this.tabBtns.forEach((b) => {
        b.classList.toggle('is-active', b.dataset.tab === tabName)
      })

      this.panes.forEach((pane) => {
        pane.classList.toggle('is-active', pane.id === `pane-${tabName}`)
      })
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new FactsFAQWidget())
  } else {
    new FactsFAQWidget()
  }
</script>

<style lang="scss">
  .facts-widget {
    position: fixed;
    bottom: max(1.25rem, calc(0.75rem + env(safe-area-inset-bottom, 0px)));
    left: max(1.5rem, calc(1rem + env(safe-area-inset-left, 0px)));
    z-index: 90;

    width: 320px;

    background: color(secondary);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(255, 240, 235, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    font-family: font-family(mono);
    color: color(primary);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);

    display: flex;
    flex-direction: column-reverse;

    @include mq(phone) {
      bottom: max(78px, calc(68px + env(safe-area-inset-bottom, 0px)));
      left: max(16px, calc(12px + env(safe-area-inset-left, 0px)));
      width: auto;
      max-width: fit-content;
      border-radius: 999px;

      .facts-widget__bar {
        padding: 0.45rem 0.65rem;
        gap: 0.45rem;
      }

      .facts-widget__meta {
        display: none;
      }

      .facts-widget__btn {
        margin-left: 0;
        width: 26px;
        height: 26px;
      }

      .facts-widget__drawer {
        display: none;
      }

      &.is-expanded {
        border-radius: 12px;
        width: calc(100vw - 2rem);
        max-width: 360px;

        .facts-widget__meta {
          display: flex;
        }

        .facts-widget__drawer {
          display: flex;
        }
      }
    }

    &.is-expanded {
      border-color: rgba(255, 240, 235, 0.35);
      box-shadow: 0 25px 65px rgba(0, 0, 0, 0.75), 0 0 30px rgba(255, 240, 235, 0.1);

      .facts-widget__drawer {
        display: flex;
        max-height: 480px;
        opacity: 1;
        padding: 0.85rem 0.85rem 0.75rem;
      }

      .facts-widget__bar {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
    }

    &__bar {
      @include flex(row, space-between, center);
      padding: 0.65rem 0.85rem;
      cursor: pointer;
      user-select: none;
      border-radius: 11px;
      transition: background 0.2s ease;

      &:hover {
        background: rgba(255, 255, 255, 0.04);

        .facts-widget__btn {
          background: color(primary);
          color: color(secondary);
          transform: scale(1.08);
        }
      }
    }

    &__badge {
      position: relative;
      @include flex(row, center, center);
      width: 28px;
      height: 28px;
      margin-right: 0.65rem;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      flex-shrink: 0;

      .facts-widget__icon {
        font-size: 13px;
        line-height: 1;
      }

      .facts-widget__dot {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 6px;
        height: 6px;
        background: #facc15;
        border-radius: 50%;
        box-shadow: 0 0 6px #facc15;
        animation: pulseBadge 2s infinite ease-in-out;
      }
    }

    @keyframes pulseBadge {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }

    &__meta {
      flex: 1;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    &__title {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: color(primary);
      text-transform: uppercase;
    }

    &__status {
      font-size: 0.58rem;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.55);
      margin-top: 0.15rem;
      text-transform: uppercase;
    }

    &__btn {
      @include flex(row, center, center);
      width: 28px;
      height: 28px;
      padding: 0;
      margin-left: 0.5rem;

      background: rgba(255, 255, 255, 0.08);
      color: color(primary);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 50%;
      cursor: pointer;
      transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
      flex-shrink: 0;

      .icon {
        width: 14px;
        height: 14px;
      }
    }

    &__drawer {
      display: none;
      flex-direction: column;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      padding: 0 0.85rem;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &__header {
      @include flex(row, space-between, center);
      font-size: 0.58rem;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 0.65rem;

      .facts-widget__tape-dot {
        display: inline-block;
        width: 5px;
        height: 5px;
        background: #facc15;
        border-radius: 50%;
        margin-right: 0.35rem;
      }

      .facts-widget__close-btn {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.75rem;
        cursor: pointer;
        padding: 0.15rem 0.35rem;
