      }
    }

    // Tab 1: FAQ Accordion
    .facts-accordion {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .facts-faq-item {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      overflow: hidden;
