        color: #0c0202;
        border-color: #25d366;
        box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);

        .facts-widget__cta-arrow {
          transform: translate(2px, -2px);
        }
      }

      &-arrow {
        transition: transform 0.2s ease;
      }
    }
  }
</style>
