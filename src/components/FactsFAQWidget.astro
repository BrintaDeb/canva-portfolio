    }

    .facts-card {
      padding: 0.5rem 0.65rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      transition: background 0.2s ease;

      &:hover {
        background: rgba(255, 255, 255, 0.07);
        border-color: rgba(255, 240, 235, 0.16);
      }

      &__header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.2rem;
      }

      &__icon {
        font-size: 11px;
        line-height: 1;
      }

      &__title {
        font: 700 10.5px / 1.2 font-family(fraktion);
