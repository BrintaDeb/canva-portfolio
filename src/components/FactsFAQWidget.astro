        }

        .facts-faq-a {
          max-height: 220px;
          padding: 0.4rem 0.65rem 0.65rem 1.8rem;
          opacity: 1;
        }
      }
    }

    .facts-faq-q {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      width: 100%;
      padding: 0.55rem 0.65rem;
      background: transparent;
      border: none;
      color: color(primary);
      text-align: left;
      cursor: pointer;

      &__num {
        font: 700 9px / 1.3 font-family(fraktion);
        color: #facc15;
        opacity: 0.85;
        flex-shrink: 0;
      }

      &__text {
        flex: 1;
        font: 600 11px / 1.3 font-family(fraktion);
        letter-spacing: 0.01em;
      }

      &__icon {
        flex-shrink: 0;
        margin-top: 2px;
        transition: transform 0.25s ease, color 0.25s ease;
        opacity: 0.7;
      }
    }

    .facts-faq-a {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      padding: 0 0.65rem 0 1.8rem;
