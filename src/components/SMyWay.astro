---
/**
 * SJourneyBooking (formerly SMyWay)
 * Direct 15-Minute Discovery Call Scheduling Hub with Cal.com / Calendly Popup
 */
---

<section id="journey" class="s-journey-booking" data-intersect>
  <div id="my-way" class="u-anchor-target" aria-hidden="true"></div>

  <div class="booking-container">
    <!-- Top Meta Bar -->
    <div class="booking-header">
      <div class="booking-header__left">
        <span class="booking-tag">[ 04 / STRATEGIC DISCOVERY CALL ]</span>
        <span class="booking-pulse-badge">
          <span class="pulse-dot"></span>
          <span>REAL-TIME AVAILABILITY</span>
        </span>
      </div>

      <div class="booking-header__right">
        <span class="tz-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span class="js-visitor-tz">DETECTING TIMEZONE...</span>
          <span class="tz-sep">|</span>
          <span class="js-visitor-time">--:--:--</span>
        </span>
      </div>
    </div>

    <!-- Main Title & Pitch -->
    <div class="booking-hero">
      <h2 class="booking-title">RESERVE A 15-MIN INTRO CALL</h2>
      <p class="booking-subtitle">
        Zero high-pressure sales pitch. A focused, 1-on-1 strategy conversation where we review your product vision, brand positioning, GSAP &amp; WebGL motion requirements, and verify 7-day turnaround feasibility.
      </p>
    </div>

    <!-- Interactive Booking Station Grid -->
    <div class="booking-grid">
      <!-- Left Column: Interactive Slot Selector -->
      <div class="booking-card booking-card--selector">
        <div class="card-inner-header">
          <div class="card-step-badge">STEP 01</div>
          <h3 class="card-heading">SELECT YOUR PREFERRED TIME SLOT</h3>
        </div>

        <!-- Date Tabs -->
        <div class="date-tabs-container">
          <div class="date-tabs-label">UPCOMING BUSINESS SPRINT DAYS:</div>
          <div class="date-tabs js-date-tabs" role="tablist">
            <!-- Dynamically populated via JS -->
          </div>
        </div>

        <!-- Time Slot Chips -->
        <div class="time-slots-container">
          <div class="time-slots-label">AVAILABLE 15-MINUTE INTRO SLOTS:</div>
          <div class="time-slots-grid js-slots-grid">
            <button type="button" class="slot-chip is-active" data-time="11:00 AM – 11:15 AM">
              <span class="chip-status">●</span>
              <span class="chip-time">11:00 AM – 11:15 AM</span>
            </button>
            <button type="button" class="slot-chip" data-time="02:30 PM – 02:45 PM">
              <span class="chip-status">●</span>
              <span class="chip-time">02:30 PM – 02:45 PM</span>
            </button>
            <button type="button" class="slot-chip" data-time="05:00 PM – 05:15 PM">
              <span class="chip-status">●</span>
              <span class="chip-time">05:00 PM – 05:15 PM</span>
            </button>
            <button type="button" class="slot-chip" data-time="08:30 PM – 08:45 PM">
              <span class="chip-status">●</span>
              <span class="chip-time">08:30 PM – 08:45 PM</span>
            </button>
          </div>
        </div>

        <!-- Call Agenda Blueprint -->
        <div class="agenda-blueprint">
          <div class="blueprint-title">[ 15-MINUTE CONVERSATION BLUEPRINT ]</div>
          <div class="blueprint-list">
            <div class="blueprint-row">
              <span class="blueprint-index">01</span>
              <div class="blueprint-info">
                <strong>Objectives &amp; Brand Tone</strong>
                <span>Who is your target buyer and what problem are we solving?</span>
              </div>
            </div>
            <div class="blueprint-row">
              <span class="blueprint-index">02</span>
              <div class="blueprint-info">
                <strong>Architecture &amp; Motion Fit</strong>
                <span>Astro, Next.js, WebGL shader ripples, GSAP kinetics, or CMS.</span>
              </div>
            </div>
            <div class="blueprint-row">
              <span class="blueprint-index">03</span>
              <div class="blueprint-info">
                <strong>Sprint Feasibility &amp; Quote</strong>
                <span>Immediate 7-day turnaround kickoff date &amp; fixed-scope quote.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Booking Execution & Cal.com Popup -->
      <div class="booking-card booking-card--actions">
        <div class="card-inner-header">
          <div class="card-step-badge">STEP 02</div>
          <h3 class="card-heading">CONFIRM YOUR RESERVATION</h3>
        </div>

        <!-- Selected Slot Summary Box -->
        <div class="selection-summary js-selection-summary">
          <div class="summary-label">CURRENT SELECTION</div>
          <div class="summary-details">
            <div class="summary-datetime js-summary-text">
              <strong class="js-summary-day">Monday</strong>, 
              <span class="js-summary-date">Loading...</span> 
              at <span class="js-summary-time">11:00 AM – 11:15 AM</span>
            </div>
            <div class="summary-tz js-summary-tz">Timezone: UTC</div>
          </div>
        </div>

        <!-- Primary Action: WhatsApp Instant Booking -->
        <div class="action-block">
          <a
            href="https://wa.me/917005581453"
            target="_blank"
            rel="noopener noreferrer"
            class="booking-btn booking-btn--wa js-wa-booking-btn"
          >
            <div class="btn-left">
              <span class="btn-tag">[ RECOMMENDED &bull; FASTEST ]</span>
              <span class="btn-text">CONFIRM CALL ON WHATSAPP</span>
            </div>
            <span class="btn-icon">→</span>
          </a>
          <p class="action-caption">Direct WhatsApp chat with Brinta Deb. Auto-reserves your spot in under 60 seconds.</p>
        </div>

        <!-- Secondary Action: Open Cal.com / Calendly Popup -->
        <div class="action-block">
          <button
            type="button"
            class="booking-btn booking-btn--cal js-open-schedule"
          >
            <div class="btn-left">
              <span class="btn-tag">[ ZERO REDIRECT &bull; IN-APP ]</span>
              <span class="btn-text">OPEN CAL.COM / CALENDLY POPUP</span>
            </div>
            <span class="btn-icon">📅</span>
          </button>
          <p class="action-caption">Interactive in-browser calendar modal to pick Google Meet or Zoom slots.</p>
        </div>

        <!-- Tertiary Action: Direct Email Dispatch -->
        <div class="action-block">
          <a
            href="mailto:brintadeb15@gmail.com"
            class="booking-btn booking-btn--email js-email-booking-btn"
          >
            <div class="btn-left">
              <span class="btn-tag">[ ASYNCHRONOUS ]</span>
              <span class="btn-text">CONFIRM VIA EMAIL</span>
            </div>
            <span class="btn-icon">↗</span>
          </a>
        </div>

        <!-- Guarantee Badge -->
        <div class="booking-guarantee">
          <div class="guarantee-icon">✦</div>
          <div class="guarantee-text">
            <strong>100% Zero-Obligation Guarantee:</strong> If we aren't a mutual fit for your timeline or budget, I will gladly refer you to trusted creative engineers from my network.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { audioEngine } from '../utils/AudioEngine.js'

  class JourneyBookingController {
    el: HTMLElement | null
    dateTabsContainer: HTMLElement | null
    slotsGrid: HTMLElement | null
    summaryDayEl: HTMLElement | null
    summaryDateEl: HTMLElement | null
    summaryTimeEl: HTMLElement | null
    summaryTzEl: HTMLElement | null
    waBtn: HTMLAnchorElement | null
    emailBtn: HTMLAnchorElement | null
    tzDisplayEl: HTMLElement | null
    timeDisplayEl: HTMLElement | null

    selectedDate: string
    selectedDayName: string
    selectedTime: string
    visitorTz: string

    constructor() {
      this.el = document.getElementById('journey')
      this.dateTabsContainer = this.el?.querySelector('.js-date-tabs') || null
      this.slotsGrid = this.el?.querySelector('.js-slots-grid') || null
      this.summaryDayEl = this.el?.querySelector('.js-summary-day') || null
      this.summaryDateEl = this.el?.querySelector('.js-summary-date') || null
      this.summaryTimeEl = this.el?.querySelector('.js-summary-time') || null
      this.summaryTzEl = this.el?.querySelector('.js-summary-tz') || null
      this.waBtn = this.el?.querySelector('.js-wa-booking-btn') as HTMLAnchorElement | null
      this.emailBtn = this.el?.querySelector('.js-email-booking-btn') as HTMLAnchorElement | null
      this.tzDisplayEl = this.el?.querySelector('.js-visitor-tz') || null
      this.timeDisplayEl = this.el?.querySelector('.js-visitor-time') || null

      this.visitorTz = 'Asia/Kolkata'
      try {
        this.visitorTz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Asia/Kolkata'
      } catch (_) {}

      this.selectedDate = ''
      this.selectedDayName = ''
      this.selectedTime = '11:00 AM – 11:15 AM'

      this.init()
    }

    init() {
      this.initTimezoneAndClock()
      this.generateDateTabs()
      this.bindSlotClicks()
      this.updateSummaryAndLinks()
    }

    initTimezoneAndClock() {
      if (this.tzDisplayEl) {
        const cleanTz = this.visitorTz.replace(/_/g, ' ')
        this.tzDisplayEl.textContent = cleanTz
      }

      const updateClock = () => {
        if (!this.timeDisplayEl) return
        try {
          const now = new Date()
          const timeStr = new Intl.DateTimeFormat('en-US', {
            timeZone: this.visitorTz,
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true,
          }).format(now)
          this.timeDisplayEl.textContent = timeStr
        } catch (_) {}
      }

      updateClock()
      setInterval(updateClock, 1000)
    }

    generateDateTabs() {
      if (!this.dateTabsContainer) return
      this.dateTabsContainer.innerHTML = ''

      const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

      const today = new Date()
      let businessDaysFound = 0
      let offsetDays = 0

      while (businessDaysFound < 5 && offsetDays < 14) {
        const checkDate = new Date()
        checkDate.setDate(today.getDate() + offsetDays)
        const dayOfWeek = checkDate.getDay()

        if (offsetDays === 0 || (dayOfWeek !== 0 && dayOfWeek !== 6)) {
          const isSelected = businessDaysFound === 0
          const dayName = days[dayOfWeek]
          const monthName = months[checkDate.getMonth()]
          const dayNum = checkDate.getDate()
          const fullDateStr = monthName + ' ' + dayNum + ', ' + checkDate.getFullYear()

          if (isSelected) {
            this.selectedDate = fullDateStr
            this.selectedDayName = dayName
          }

          const btn = document.createElement('button')
          btn.type = 'button'
          btn.className = 'date-tab ' + (isSelected ? 'is-active' : '')
          btn.dataset.fullDate = fullDateStr
          btn.dataset.dayName = dayName
          btn.innerHTML =
            '<span class="tab-day">' + dayName + '</span>' +
            '<span class="tab-num">' + (dayNum < 10 ? '0' + dayNum : dayNum) + '</span>' +
            '<span class="tab-month">' + monthName + '</span>' +
            '<span class="tab-slots">● 4 SLOTS</span>'

          btn.addEventListener('click', () => {
            this.dateTabsContainer?.querySelectorAll('.date-tab').forEach((t) => t.classList.remove('is-active'))
            btn.classList.add('is-active')
            this.selectedDate = fullDateStr
            this.selectedDayName = dayName
            audioEngine.playTab()
            this.updateSummaryAndLinks()
          })

          this.dateTabsContainer.appendChild(btn)
          businessDaysFound++
        }
        offsetDays++
      }
    }

    bindSlotClicks() {
      if (!this.slotsGrid) return
      const chips = this.slotsGrid.querySelectorAll('.slot-chip')
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('is-active'))
          chip.classList.add('is-active')
          this.selectedTime = chip.getAttribute('data-time') || '11:00 AM – 11:15 AM'
          audioEngine.playTab()
          this.updateSummaryAndLinks()
        })
      })
    }

    updateSummaryAndLinks() {
      if (this.summaryDayEl) this.summaryDayEl.textContent = this.selectedDayName
      if (this.summaryDateEl) this.summaryDateEl.textContent = this.selectedDate
      if (this.summaryTimeEl) this.summaryTimeEl.textContent = this.selectedTime
      if (this.summaryTzEl) this.summaryTzEl.textContent = 'Timezone: ' + this.visitorTz

      const message = 'Hi Brinta! I would like to book a 15-minute intro discovery call on ' +
        this.selectedDayName + ' (' + this.selectedDate + ') at ' + this.selectedTime + ' (' + this.visitorTz + '). My product/project details:'
      const encodedMsg = encodeURIComponent(message)

      if (this.waBtn) {
        this.waBtn.href = 'https://wa.me/917005581453?text=' + encodedMsg
      }

      if (this.emailBtn) {
        const subject = encodeURIComponent('15-Min Discovery Call: ' + this.selectedDayName + ' (' + this.selectedDate + ') at ' + this.selectedTime)
        this.emailBtn.href = 'mailto:brintadeb15@gmail.com?subject=' + subject + '&body=' + encodedMsg
      }
    }
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', () => new JourneyBookingController())
    } else {
      new JourneyBookingController()
    }
  }
</script>

<style lang="scss">
  .s-journey-booking {
    position: relative;
    z-index: 5;
    background-color: color(primary);
    color: color(secondary);
    padding: 8rem 0;
    border-top: 1px solid color(secondary);
    border-bottom: 1px solid color(secondary);

    @include mq(tablet) {
      padding: 5rem 0;
    }

    @include mq(phone) {
      padding: 3.5rem 0 6rem;
    }
  }

  .u-anchor-target {
    position: absolute;
    top: 0;
    left: 0;
    height: 0;
    width: 0;
    pointer-events: none;
  }

  .booking-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 4rem;

    @include mq(tablet) {
      padding: 0 2rem;
    }

    @include mq(phone) {
      padding: 0 1rem;
    }
  }

  /* Header Meta Bar */
  .booking-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(var(--color-secondary-rgb, 0, 0, 0), 0.15);
    margin-bottom: 3.5rem;

    @include mq(phone) {
      margin-bottom: 2rem;
    }

    &__left {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
  }

  .booking-tag {
    font-family: font-family(mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color(secondary);
  }

  .booking-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(var(--color-secondary-rgb, 0, 0, 0), 0.25);
    border-radius: 9999px;
    font-family: font-family(mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #10b981;
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.8);
      animation: pulse 1.8s infinite;
    }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .tz-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(var(--color-secondary-rgb, 0, 0, 0), 0.04);
    border: 1px solid rgba(var(--color-secondary-rgb, 0, 0, 0), 0.15);
    border-radius: 4px;
    font-family: font-family(mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: color(secondary);

    .tz-sep {
      opacity: 0.3;
    }
  }

  /* Hero Section */
  .booking-hero {
    max-width: 980px;
    margin-bottom: 4rem;

    @include mq(phone) {
      margin-bottom: 2.5rem;
    }
  }

  .booking-title {
    font-family: font-family(bigger);
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 0.92;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem 0;
    color: color(secondary);
  }

  .booking-subtitle {
    font-family: font-family(editorial);
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.45;
    color: color(secondary);
    opacity: 0.88;
    margin: 0;
    max-width: 820px;
  }

  /* Booking Grid */
  .booking-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;

    @include mq(desktop-sm) {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Cards */
  .booking-card {
    border: 1px solid color(secondary);
    padding: 2.5rem;
    background-color: color(primary);
    position: relative;
    display: flex;
    flex-direction: column;

    @include mq(phone) {
      padding: 1.25rem 1rem;
    }

    &--actions {
      background: rgba(var(--color-secondary-rgb, 0, 0, 0), 0.015);
    }
  }

  .card-inner-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(var(--color-secondary-rgb, 0, 0, 0), 0.12);
  }

  .card-step-badge {
    font-family: font-family(mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.5rem;
    background: color(secondary);
    color: color(primary);
  }

  .card-heading {
    font-family: font-family(mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
  }

  /* Date Tabs */
  .date-tabs-container {
    margin-bottom: 2rem;
  }

  .date-tabs-label,
  .time-slots-label {
    font-family: font-family(mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.75;
    margin-bottom: 0.85rem;
  }

  .date-tabs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.6rem;

    @include mq(phone) {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.5rem;
      padding-bottom: 0.4rem;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }
  }

  :global(.date-tab) {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.85rem 0.5rem;
    background: transparent;
    border: 1px solid rgba(var(--color-secondary-rgb, 0, 0, 0), 0.2);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    color: color(secondary);

    @include mq(phone) {
      flex: 0 0 76px;
      scroll-snap-align: start;
      padding: 0.65rem 0.35rem;
    }

    .tab-day {
      font-family: font-family(mono);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      opacity: 0.7;
    }

    .tab-num {
      font-family: font-family(bigger);
      font-size: 1.75rem;
      line-height: 1;
      margin: 0.35rem 0;
    }

    .tab-month {
      font-family: font-family(mono);
      font-size: 0.6rem;
      text-transform: uppercase;
      opacity: 0.65;
    }

    .tab-slots {
      margin-top: 0.5rem;
      font-family: font-family(mono);
      font-size: 0.55rem;
      font-weight: 700;
      color: #10b981;
      white-space: nowrap;

      @include mq(phone) {
        display: block;
        font-size: 0.5rem;
        margin-top: 0.3rem;
      }
    }

    &:hover {
      border-color: color(secondary);
      background: rgba(var(--color-secondary-rgb, 0, 0, 0), 0.04);
      transform: translateY(-2px);
    }

    &.is-active {
      background: color(secondary);
      color: color(primary);
      border-color: color(secondary);

      .tab-day,
      .tab-month {
        color: color(primary);
        opacity: 0.9;
      }

      .tab-slots {
        color: #6ee7b7;
      }
    }
  }

  /* Time Slots */
  .time-slots-container {
    margin-bottom: 2.5rem;
  }

  .time-slots-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;

    @include mq(phone) {
      grid-template-columns: 1fr 1fr;
      gap: 0.45rem;
    }
  }

  .slot-chip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    background: transparent;
    border: 1px solid rgba(var(--color-secondary-rgb, 0, 0, 0), 0.2);
    color: color(secondary);
    font-family: font-family(mono);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);

    @include mq(phone) {
      padding: 0.65rem 0.25rem;
      font-size: 0.625rem;
      letter-spacing: -0.01em;
      gap: 0.25rem;
      justify-content: center;
      min-height: 44px;
      white-space: nowrap;
    }

    .chip-status {
      color: #10b981;
      font-size: 0.7rem;
    }

    &:hover {
      border-color: color(secondary);
      background: rgba(var(--color-secondary-rgb, 0, 0, 0), 0.04);
      transform: translateX(3px);
    }

    &.is-active {
      background: color(secondary);
      color: color(primary);
      border-color: color(secondary);

      .chip-status {
        color: #6ee7b7;
      }
    }
  }

  /* Blueprint */
  .agenda-blueprint {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px dashed rgba(var(--color-secondary-rgb, 0, 0, 0), 0.2);
  }

  .blueprint-title {
    font-family: font-family(mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.8;
    margin-bottom: 1rem;
  }

  .blueprint-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .blueprint-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.8rem;
  }

  .blueprint-index {
    font-family: font-family(mono);
    font-size: 0.7rem;
    font-weight: 700;
    opacity: 0.5;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

