---
const steps = [
  {
    code: '01',
    day: 'DAY 01',
    title: 'We talk. Thirty minutes.',
    desc: 'You show me what you sell and who buys it. I tell you straight whether I am the right person for it.',
    meta: ['Discovery Call', 'Zero Obligation', '30 Minutes'],
  },
  {
    code: '02',
    day: 'DAYS 02 — 04',
    title: 'I build. You watch.',
    desc: 'A live link on day two, changing daily. AI does the heavy lifting on code. The strategy, the taste and the conversion calls stay mine.',
    meta: ['Daily Live Link', 'Rapid Code Generation', 'Taste & Conversion Strategy'],
  },
  {
    code: '03',
    day: 'DAYS 05 — 06',
    title: 'You review. I fix.',
    desc: 'Two rounds of changes, on the live link. Say what you want moved and it is moved the same day.',
    meta: ['2 Change Rounds', 'Same-Day Revisions', 'Live Feedback Loop'],
  },
  {
    code: '04',
    day: 'DAY 07',
    title: 'You go live. Measured.',
    desc: 'Domain connected, analytics wired, scores verified in front of you. You own the code, the accounts, all of it.',
    meta: ['Domain & SSL Connected', 'Analytics & Scores Verified', '100% Code & Account Ownership'],
  },
]
---

<section id="process" class="s-steps" data-intersect>
  <div class="s__inner js-inner">
    <div class="s__steps-wrapper">
      <!-- Top Pill Header (1:1 with SAbout & SServices) -->
      <div class="s__steps-header">
        <span class="s__steps-header__tag">SPRINT WORKFLOW &bull; FOUR STEPS &bull; SEVEN DAYS</span>
      </div>

      <!-- Bento Grid (1:1 Architecture with SAbout & SServices) -->
      <div class="s__bento">
        <!-- Row 1: Section Header Banner -->
        <div class="s__cell s__cell--full js-step-cell">
          <div class="s__crosshair s__crosshair--tl">+</div>
          <div class="s__crosshair s__crosshair--tr">+</div>
          <div class="s__cell__content">
            <div class="s__cell__huge-title">FOUR STEPS. 7 DAYS.</div>
            <h3 class="s__cell__serif">"From Strategic Alignment to Live Launch in One Focused Week."</h3>
            <p class="s__cell__serif-sub">
              Rapid iteration, AI-accelerated build, daily transparency, zero agency fluff.
            </p>
          </div>
          <span class="s__cell__mask"></span>
        </div>

        <!-- Row 2: Step 01 & Step 02 -->
        <div class="s__row s__row--steps">
          <!-- Step 01 -->
          <div class="s__cell s__cell--step js-step-cell">
            <div class="s__crosshair s__crosshair--tl">+</div>
            <div class="s__crosshair s__crosshair--tr">+</div>
            <div class="s__cell__content">
              <div class="s__step-badge-row">
                <span class="s__step-code">[01]</span>
                <span class="s__step-day">DAY 01</span>
              </div>
              <h4 class="s__cell__serif s__step-title">We talk. Thirty minutes.</h4>
              <p class="s__cell__desc">
                You show me what you sell and who buys it. I tell you straight whether I am the right person for it.
              </p>
              <div class="s__cell__meta">
                <span>(Discovery Call)</span>
                <span>(Zero Obligation)</span>
                <span>(30 Minutes)</span>
              </div>
              <div class="s__step-action">
                <a href="#lab" class="s__step-schedule-btn" aria-label="Pay to Call on WhatsApp (₹100)">
                  <span>PAY TO CALL (₹100)</span>
                  <span class="btn-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
            <span class="s__cell__mask"></span>
          </div>

          <!-- Step 02 -->
          <div class="s__cell s__cell--step js-step-cell">
            <div class="s__crosshair s__crosshair--tl">+</div>
            <div class="s__crosshair s__crosshair--tr">+</div>
            <div class="s__cell__content">
              <div class="s__step-badge-row">
                <span class="s__step-code">[02]</span>
                <span class="s__step-day">DAYS 02 — 04</span>
              </div>
              <h4 class="s__cell__serif s__step-title">I build. You watch.</h4>
              <p class="s__cell__desc">
                A live link on day two, changing daily. AI does the heavy lifting on code. The strategy, the taste and the conversion calls stay mine.
              </p>
              <div class="s__cell__meta">
                <span>(Daily Live Link)</span>
                <span>(Rapid Code Generation)</span>
                <span>(Taste &amp; Conversion Calls)</span>
              </div>
            </div>
            <span class="s__cell__mask"></span>
          </div>
        </div>

        <!-- Row 3: Step 03 & Step 04 -->
        <div class="s__row s__row--steps">
          <!-- Step 03 -->
          <div class="s__cell s__cell--step js-step-cell">
            <div class="s__crosshair s__crosshair--tl">+</div>
            <div class="s__crosshair s__crosshair--tr">+</div>
            <div class="s__cell__content">
              <div class="s__step-badge-row">
                <span class="s__step-code">[03]</span>
                <span class="s__step-day">DAYS 05 — 06</span>
              </div>
              <h4 class="s__cell__serif s__step-title">You review. I fix.</h4>
              <p class="s__cell__desc">
                Two rounds of changes, on the live link. Say what you want moved and it is moved the same day.
              </p>
              <div class="s__cell__meta">
                <span>(2 Rounds of Changes)</span>
                <span>(Same-Day Fixes)</span>
                <span>(Live Feedback Loop)</span>
              </div>
            </div>
            <span class="s__cell__mask"></span>
          </div>

          <!-- Step 04 -->
          <div class="s__cell s__cell--step js-step-cell">
            <div class="s__crosshair s__crosshair--tl">+</div>
            <div class="s__crosshair s__crosshair--tr">+</div>
            <div class="s__cell__content">
              <div class="s__step-badge-row">
                <span class="s__step-code">[04]</span>
                <span class="s__step-day">DAY 07</span>
              </div>
              <h4 class="s__cell__serif s__step-title">You go live. Measured.</h4>
              <p class="s__cell__desc">
                Domain connected, analytics wired, scores verified in front of you. You own the code, the accounts, all of it.
              </p>
              <div class="s__cell__meta">
                <span>(Domain Connected)</span>
                <span>(Analytics Wired)</span>
                <span>(100% Full Ownership)</span>
              </div>
            </div>
            <span class="s__cell__mask"></span>
          </div>
        </div>

        <!-- Row 4: Bottom Signature Accent Row (Stripes + Guarantee + Stripes) -->
        <div class="s__row s__row--bottom">
          <div class="s__cell s__cell--stripes">
            <div class="s__stripes-pattern"></div>
          </div>

          <div class="s__cell s__cell--summary js-step-cell">
            <div class="s__crosshair s__crosshair--tl">+</div>
            <div class="s__crosshair s__crosshair--tr">+</div>
            <div class="s__cell__content">
              <div class="s__cell__bold">100% TRANSPARENT SPRINT</div>
              <div class="s__cell__meta">
                <span>(7 Calendar Days Guarantee)</span>
                <span>(Direct Founder &amp; Dev Access)</span>
                <span>(Code, Accounts, Hosting &bull; All Yours)</span>
              </div>
            </div>
            <span class="s__cell__mask"></span>
          </div>

          <div class="s__cell s__cell--stripes">
            <div class="s__stripes-pattern"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple intersection reveal to trigger entrance animations
  const section = document.getElementById('process')
  if (section) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add('is-revealed')
            observer.unobserve(section)
          }
        })
      },
      { threshold: 0.15 }
    )
    observer.observe(section)
  }
</script>

<style lang="scss">
  .s-steps {
    position: relative;
    z-index: 3;
    padding: 7rem 0 8rem;
    background: color(primary);
    border-bottom: 1px solid color(secondary);
    overflow: hidden;

    @include mq(tablet) {
      padding: 4rem 0 5rem;
    }

    .s__inner {
      position: relative;
      z-index: 2;
      margin: 0 auto;
      width: 38rem;
      max-width: calc(100% - 2.5rem);

      @include mq(tablet) {
        width: min(46rem, calc(100% - 2.5rem));
      }

      @include mq(phone) {
        width: 100%;
        max-width: calc(100% - 1.5rem);
      }
    }

    .s__steps-wrapper {
      position: relative;
      width: 100%;
    }

    /* Top Pill Header (1:1 with SAbout & SServices) */
    .s__steps-header {
      display: block;
      background: color(secondary);
      color: color(primary);
      text-align: center;
      padding: 0.45rem 1rem;
      border: 1px solid color(secondary);
      border-bottom: 0;

      &__tag {
        font: 700 0.6875rem / 1 font-family(fraktion);
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
    }

    /* Bento Grid (Black & White / Theme color, 1:1 Architecture with SAbout) */
    .s__bento {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .s__row {
      &--steps {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-top: -1px;

        > .s__cell {
          margin-top: 0;
        }

        > .s__cell:not(:first-child) {
          margin-left: -1px;
        }

        @include mq(phone) {
          grid-template-columns: 1fr;

          > .s__cell:not(:first-child) {
            margin-left: 0;
            margin-top: -1px;
          }
        }
      }

      &--bottom {
        display: grid;
        grid-template-columns: 1fr 1.65fr 1fr;
        margin-top: -1px;

        > .s__cell {
          margin-top: 0;
        }

        > .s__cell:not(:first-child) {
          margin-left: -1px;
        }

        @include mq(phone) {
          grid-template-columns: 1fr;

          > .s__cell:not(:first-child) {
            margin-left: 0;
            margin-top: -1px;
          }
        }
      }
    }

    .s__cell {
      position: relative;
      border: 1px solid color(secondary);
      margin-top: -1px;
      background: color(primary);
      overflow: hidden;
      cursor: default;

      &__content {
        position: relative;
        z-index: 2;
        color: color(secondary);
        transition: color 0.25s ease;
      }

      &__mask {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        background: color(secondary);
        scale: 0 1;
        transform-origin: 0 50%;
        transition: scale 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }

      @media (hover: hover) {
        &:hover {
          .s__cell__mask {
            scale: 1 1;
          }

          .s__cell__content {
            color: color(primary);
          }

          .s__crosshair {
            color: color(primary);
          }

          .s__step-day {
            background: color(primary);
            color: color(secondary);
          }

          .s__step-schedule-btn {
            border-color: color(primary);
            color: color(primary);

            &:hover {
              background: color(primary);
              color: color(secondary);
            }
          }
        }
      }

      &:active {
        transform: scale(0.99);
      }

      &--full {
        padding: 2.25rem 1.5rem;
        text-align: center;

        @include mq(phone) {
          padding: 1.75rem 1.25rem;
        }
      }

      &--step {
        padding: 1.75rem 1.5rem;
        display: flex;
        flex-direction: column;

        .s__cell__content {
          height: 100%;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
        }

        @include mq(phone) {
          padding: 1.5rem 1.25rem;
        }
      }

      &--summary {
        padding: 1.5rem 1.25rem;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;

        .s__cell__content {
          width: 100%;
        }

        .s__cell__meta {
          margin-top: 0.75rem;
        }
      }

      &--stripes {
        background: repeating-linear-gradient(
          45deg,
          transparent,
          transparent 5px,
          color(secondary) 5px,
          color(secondary) 6.2px
        );
        cursor: default;
        min-height: 5.5rem;
      }

      &__huge-title {
        font: 700 3.25rem / 0.9 font-family(bigger);
        text-transform: uppercase;
        letter-spacing: -0.02em;
        margin-bottom: 0.85rem;

        @include mq(phone) {
          font-size: 2.4rem;
        }
      }

      &__serif {
        font: 300 2rem / 1.18 font-family(editorial);
        letter-spacing: -0.01em;
        margin: 0;

        @include mq(phone) {
          font-size: 1.5rem;
        }
      }

      &__serif-sub {
        font: italic 300 1.25rem / 1.3 font-family(editorial);
        letter-spacing: -0.01em;
        margin: 0.45rem 0 0;
        opacity: 0.9;

        @include mq(phone) {
          font-size: 1.1rem;
        }
      }

      &__desc {
        font: 300 1.05rem / 1.55 font-family(editorial);
        letter-spacing: 0.01em;
        margin: 0;
        opacity: 0.95;

        @include mq(phone) {
          font-size: 0.95rem;
          line-height: 1.45;
        }
      }

      &__bold {
        font: 700 1.65rem / 0.95 font-family(bigger);
        text-transform: uppercase;
        letter-spacing: -0.02em;

        @include mq(phone) {
          font-size: 1.35rem;
        }
      }

      &__meta {
        font: 400 0.6875rem / 1.35 font-family(fraktion);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-top: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        opacity: 0.9;
      }
    }

    .s__step-badge-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .s__step-code {
      font: 700 1.25rem / 1 font-family(fraktion);
      letter-spacing: 0.05em;
    }

    .s__step-day {
      font: 700 0.625rem / 1 font-family(fraktion);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      background: color(secondary);
      color: color(primary);
      padding: 0.25rem 0.5rem;
      border-radius: 2px;
      transition: background 0.25s ease, color 0.25s ease;
    }

    .s__step-title {
      font-size: 1.65rem;
      line-height: 1.15;
      margin: 0.45rem 0 0.65rem;

      @include mq(phone) {
        font-size: 1.35rem;
      }
    }

    .s__step-action {
      margin-top: 1.25rem;
    }

    .s__step-schedule-btn {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: 100%;
      box-sizing: border-box;
      padding: 0.65rem 0.85rem;
      background: transparent;
      border: 1px solid color(secondary);
      color: color(secondary);
      font: 700 0.6875rem / 1 font-family(fraktion);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      text-align: left;
      transition: all 0.25s ease;

      .btn-arrow {
        font-size: 0.875rem;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      &:hover {
        background: color(secondary);
        color: color(primary);

        .btn-arrow {
          transform: translateX(4px);
        }
      }

      &:active {
        transform: scale(0.98);
      }
    }

    .s__crosshair {
      position: absolute;
      font: 400 12px / 1 font-family(fraktion);
      color: color(secondary);
      z-index: 2;
      transition: color 0.25s ease;

      &--tl {
        top: 6px;
        left: 8px;
      }

      &--tr {
        top: 6px;
        right: 8px;
      }
    }
  }
</style>
