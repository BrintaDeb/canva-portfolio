---
const {
  caption,
  cssClass = '',
  index = '0001',
  site = '#',
  src = '',
  modalSrc = '',
  type = 'video',
  poster = '',
  total = '25',
  tag = '',
} = Astro.props

const key = Math.random().toString(36).slice(2, 6) + '-' + index + '/' + total
const isVideo = type === 'video' || (typeof src === 'string' && src.endsWith('.mp4'))
const fullPreviewSrc = modalSrc || src
---

<a-work
  class={cssClass}
  data-type={isVideo ? 'video' : 'image'}
  data-caption={caption}
  data-tag={tag}
  data-site={site}
  data-src={fullPreviewSrc}
  data-poster={poster}
>
  <div class="a__inner">
    <a
      href={site !== '#' && site.startsWith('http') ? site : 'javascript:void(0)'}
      target={site.startsWith('http') ? '_blank' : '_self'}
      rel="noopener noreferrer"
      data-caption={caption}
      class="js-card-link"
    >
      {
        isVideo ? (
          <video
            data-src={src}
            poster={poster}
            class="a__video js-video"
            loop
            muted
            playsinline
          >
          </video>
        ) : (
          <img
            src={src}
            alt={caption}
            class="a__image js-image"
            loading="lazy"
          />
        )
      }

      <div class="a__caption">
        <div class="a__caption__text">
          {caption}
          {tag && <span class="a__caption__tag"> [{tag}]</span>}
        </div><!-- .a__caption__text -->

        <div class="a__caption__key">
          #{key}
        </div><!-- .a__caption__key -->
      </div><!-- .a__caption -->
    </a>
  </div><!-- .a__inner -->
</a-work>

<script>
  class AWork extends HTMLElement {
    static observedAttributes = ['progress']

    link: HTMLAnchorElement | null
    video: HTMLVideoElement | null
    image: HTMLImageElement | null

    isPlaying: boolean

    /**
     * Init
     */
    connectedCallback() {
      // Elements
      this.video = this.querySelector('.js-video')
      this.image = this.querySelector('.js-image')
      this.link = this.querySelector('.js-card-link')

      // Properties
      this.isPlaying = false

      // Events
      this.link?.addEventListener('click', this.onClick.bind(this))
    }

    /**
     * Attribute changed
     */
    attributeChangedCallback(name: string, _oldValue: string, newValue: string) {
      if (name === 'progress') {
        const val = parseFloat(newValue)
        this.style.setProperty('--progress', newValue)

        // Smooth fade-in / fade-out curve:
        // Full opacity in center (absVal <= 0.25)
        // Gentle fade between 0.25 and 0.85
        // Completely faded out and invisible beyond 0.85
        const absVal = Math.abs(val)
        let opacity = 0
        if (absVal <= 0.25) {
          opacity = 1
        } else if (absVal < 0.85) {
          opacity = 1 - (absVal - 0.25) / (0.85 - 0.25)
        } else {
          opacity = 0
        }

        this.style.setProperty('--card-opacity', opacity.toFixed(3))

        if (isNaN(val) || absVal >= 0.85) {
          if (this.isPlaying) {
            this.outView()
          }
          this.style.visibility = 'hidden'
          this.style.pointerEvents = 'none'
        } else {
          if (!this.isPlaying) {
            this.inView()
          }
          this.style.visibility = 'visible'
          this.style.pointerEvents = opacity > 0.4 ? 'auto' : 'none'
        }
      }
    }

    /**
     * Gets in view
     */
    inView() {
      if (this.video) {
        if (!this.video.src && this.video.dataset.src) {
          this.video.src = this.video.dataset.src
        }
        this.video.play().catch(() => {})
      }
      this.isPlaying = true
      this.classList.add('is-inview')
    }

    /**
     * Gets out view
     */
    outView() {
      if (this.video) {
        this.video.pause()
      }
      this.isPlaying = false
      this.classList.remove('is-inview')
    }

    /**
     * On click - open project in lightbox modal
     */
    onClick(event: MouseEvent) {
      const caption = this.dataset.caption || ''
      const tag = this.dataset.tag || ''
      const site = this.dataset.site || ''
      const src = this.dataset.src || ''
      const type = this.dataset.type || 'image'
      const poster = this.dataset.poster || ''

      // If card doesn't have an external URL, or user clicked to open lightbox
      event.preventDefault()
      window.dispatchEvent(new CustomEvent('open-project-lightbox', {
        detail: { caption, tag, site, src, type, poster }
      }))
    }
  }

  if (!customElements.get('a-work')) {
    customElements.define('a-work', AWork)
  }
</script>

<style lang="scss">
  a-work {
    position: relative;
    top: 0;
    left: 0;

    display: inline-flex;
    flex-direction: column;
    width: max-content;
    max-width: fit-content;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(secondary);
    opacity: var(--card-opacity, 0);
    visibility: hidden;

    transform-style: preserve-3d;
    border: 1px solid rgba(255, 240, 235, 0.18);
    border-radius: 6px;
    overflow: hidden;
    box-sizing: border-box;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);

    will-change: transform, opacity;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;

    &:hover {
      border-color: rgba(255, 240, 235, 0.38);
      box-shadow: 0 25px 55px rgba(0, 0, 0, 0.45);
    }

    @include mq(phone) {
      padding: 0.25rem 0.25rem 0;
    }

    a {
      display: flex;
      flex-direction: column;
      width: 100%;
      text-decoration: none;
    }

    .a__inner {
      display: flex;
      flex-direction: column;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .a__video,
    .a__image {
      display: block;
      width: auto;
      height: auto;
      max-width: 48vw;
      max-height: 52vh;
      object-fit: contain;
      border-radius: 2px;

      @include mq(phone) {
        max-width: 80vw;
        max-height: 70vh;
      }
    }

    .a__caption {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;

      width: 0;
      min-width: 100%;
      box-sizing: border-box;
      padding: 0.5rem 0.25rem;
      gap: 0.5rem;

      color: color(primary);
      font: 700 11px / 1.3 font-family(fraktion);
      letter-spacing: 0.08em;
      text-transform: uppercase;

      @include mq(phone) {
        display: none;
      }

      &__text {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      &__key {
        flex-shrink: 0;
        white-space: nowrap;
      }

      &__tag {
        color: color(primary);
        opacity: 0.7;
        font-weight: 400;
      }
    }

    &.is-inview {
      content-visibility: visible;
    }
  }
</style>
