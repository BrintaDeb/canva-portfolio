---

<footer class="site-foot">
  <div class="site-foot__inner">
    <button type="button" class="site-foot__resume-btn js-open-resume" aria-label="Open Curriculum Vitae / Resume Modal">
      <span class="btn-dot" aria-hidden="true"></span>
      <span>CURRICULUM VITAE &bull; ONE-PAGER</span>
      <span class="btn-arrow" aria-hidden="true">↗</span>
    </button>

    <div class="site-foot__sep" aria-hidden="true">&bull;</div>

    <a href="#" class="site-foot__link js-back-to-top" title="Back to Top" aria-label="Built with love by Brinta Deb — Back to top">
      <span class="site-foot__text">
        Built with <span class="site-foot__heart" aria-hidden="true">🖤</span> by <strong class="site-foot__author">Brinta Deb</strong>
      </span>
    </a>
  </div>
</footer>

<script>
  const backToTop = document.querySelector('.js-back-to-top')
  backToTop?.addEventListener('click', (e) => {
    e.preventDefault()
    if ((window as any).lenis) {
      ;(window as any).lenis.scrollTo(0, { duration: 1.2 })
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }
  })
</script>

<style lang="scss">
  .site-foot {
    position: relative;
    z-index: 3;
    padding: 3.5rem 1.5rem 8rem 1.5rem;
    border-top: 1px solid color(secondary);
    background: color(primary);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;

    @include mq(phone) {
      padding: 2.5rem 1rem 7rem 1rem;
    }

    &__inner {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;

      @include mq(phone) {
        gap: 0.75rem;
      }
    }

    &__sep {
      color: color(secondary);
      opacity: 0.5;
      font-size: 0.75rem;

      @include mq(phone) {
        display: none;
      }
    }

    &__resume-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      border: 1px solid color(secondary);
      color: color(secondary);
      font: 700 0.75rem / 1 font-family(fraktion);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.45rem 0.85rem;
      cursor: pointer;
      transition: all 0.25s ease;

      .btn-dot {
        width: 6px;
        height: 6px;
        background: #10b981;
        border-radius: 50%;
        display: inline-block;
      }

      .btn-arrow {
        font-size: 0.8125rem;
        transition: transform 0.2s ease;
      }

      &:hover {
        background: color(secondary);
        color: color(primary);

        .btn-arrow {
          transform: translate(2px, -2px);
        }
      }

      @include mq(phone) {
        font-size: 0.6875rem;
        padding: 0.4rem 0.65rem;
      }
    }

    &__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      outline: none;
      color: color(secondary);
      font: 400 0.875rem / 1.4 font-family(fraktion);
      letter-spacing: 0.08em;
      transition: opacity 0.25s ease;

      @include mq(phone) {
        font-size: 0.8125rem;
        letter-spacing: 0.06em;
      }
    }

    &__text {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      white-space: nowrap;
    }

    &__heart {
      display: inline-block;
      margin: 0 0.15rem;
      font-size: 0.95rem;
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      transform-origin: center;
    }

    &__author {
      font-weight: 700;
      color: color(secondary);
      letter-spacing: 0.06em;
      transition: color 0.25s ease;
    }

    &__link:hover {
      opacity: 0.9;

      .site-foot__heart {
        transform: scale(1.3);
      }

      .site-foot__author {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
    }

    &__link:active {
      .site-foot__heart {
        transform: scale(0.95);
      }
    }
  }
</style>
