                            <div class="s__type-scale">
                              <div class="s__type-row">
                                <span class="s__type-meta">DISPLAY 48PX</span>
                                <span class="s__type-sample s__type-sample--display">BRINTA STUDIO // 2026</span>
                              </div>
                              <div class="s__type-row">
                                <span class="s__type-meta">MONO 14PX</span>
                                <span class="s__type-sample s__type-sample--mono">0123456789 [BESPOKE ARTIFACT]</span>
