                      <span class="tier-level font-mono">{tier.tier}</span>
                    </div>
                    <div class="tier-price-row">
                      <span class="tier-price font-mono">{tier.price}</span>
                      {tier.period && <span class="tier-period font-mono">{tier.period}</span>}
                    </div>
