<script>
  import gsap from 'gsap'

  class ServicesSection {
    el: HTMLElement | null
    tiltFrames: NodeListOf<HTMLElement>
    switcherTabs: NodeListOf<HTMLElement>
    serviceViews: NodeListOf<HTMLElement>

    constructor() {
      this.el = document.getElementById('services')
      if (!this.el) return

      this.tiltFrames = this.el.querySelectorAll('.js-tilt-frame')
      this.switcherTabs = this.el.querySelectorAll('.js-switcher-tab')
      this.serviceViews = this.el.querySelectorAll('.js-service-view')

      this.initSmoothTilt()
      this.init3OptionSwitcher()
    }

    /**
     * Subtle & Smooth 3D Perspective Tilt Physics
     */
    initSmoothTilt() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      if (window.innerWidth < 900) return

      this.tiltFrames.forEach((frame) => {
        let bounds: DOMRect
        let isHovered = false

        const onMouseEnter = () => {
          bounds = frame.getBoundingClientRect()
          isHovered = true
        }

        const onMouseMove = (e: MouseEvent) => {
          if (!isHovered) return
          const mouseX = e.clientX - bounds.left
          const mouseY = e.clientY - bounds.top

          const xRatio = (mouseX / bounds.width - 0.5) * 2 // -1 to 1
          const yRatio = (mouseY / bounds.height - 0.5) * 2 // -1 to 1

          // Gentle smooth tilt: max 2.5 degrees
          const rotX = -yRatio * 2.5
          const rotY = xRatio * 2.5

          gsap.to(frame, {
            rotationX: rotX,
            rotationY: rotY,
            transformPerspective: 1600,
            ease: 'power2.out',
            duration: 0.6,
            overwrite: 'auto',
          })

          const specular = frame.querySelector('.glass-specular') as HTMLElement
          if (specular) {
            gsap.to(specular, {
              x: mouseX,
              y: mouseY,
              duration: 0.5,
              ease: 'power1.out',
              overwrite: 'auto',
            })
          }
        }

        const onMouseLeave = () => {
          isHovered = false
          gsap.to(frame, {
            rotationX: 0,
            rotationY: 0,
            ease: 'power3.out',
            duration: 0.9,
            overwrite: 'auto',
          })
        }

        frame.addEventListener('mouseenter', onMouseEnter)
        frame.addEventListener('mousemove', onMouseMove)
        frame.addEventListener('mouseleave', onMouseLeave)
      })
    }

    /**
     * 3-Option Category Switcher
     */
    init3OptionSwitcher() {
      this.switcherTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetId = tab.getAttribute('data-target')

          this.switcherTabs.forEach((t) => {
            const isActive = t === tab
            t.classList.toggle('is-active', isActive)
            t.setAttribute('aria-selected', isActive ? 'true' : 'false')
          })

          this.serviceViews.forEach((view) => {
            const viewCategory = view.getAttribute('data-category')
            if (viewCategory === targetId) {
              view.style.display = 'block'
              gsap.fromTo(
                view,
                { opacity: 0, y: 15 },
                {
                  opacity: 1,
                  y: 0,
                  duration: 0.45,
                  ease: 'power2.out',
                }
              )
            } else {
              gsap.to(view, {
                opacity: 0,
                y: -10,
                duration: 0.25,
                ease: 'power2.in',
                onComplete: () => {
                  view.style.display = 'none'
                },
              })
            }
          })
        })
      })
    }
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ServicesSection())
  } else {
    new ServicesSection()
  }
</script>

