                                <span class="s__clone-nav-link">REVIEWS</span>
                              </div>
                              <div class="s__clone-mobile-toggle" aria-hidden="true">
                                <span></span><span></span>
                              </div>
                              <button type="button" class="s__clone-cta-pill js-clone-cta" title="Live Project Discovery CTA">
                                <span>BOOK SPRINT</span>
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                              </button>
                            </div>

                            <!-- Clone Hero -->
                            <div class="s__clone-hero">
                              <div class="s__clone-hero-copy">
                                <div class="s__clone-status-ribbon">
                                  <span class="s__clone-pulse-dot"></span>
                                  <span>NEXT.JS 15 &bull; SUB-0.5s HYDRATION</span>
                                </div>
                                <h5 class="s__clone-h1">
                                  HIGH-CONVERSION <span class="s__clone-accent-text">3D DIGITAL EXPERIENCES</span>
                                </h5>
                                <p class="s__clone-desc">
                                  Bespoke WebGL animations, GSAP momentum physics & zero-latency edge delivery built to win premium clients.
                                </p>
                                <div class="s__clone-chips">
                                  <span class="s__clone-chip s__clone-chip--emerald">⚡ 0.42s LCP</span>
                                  <span class="s__clone-chip s__clone-chip--cyan">🔥 60 FPS WebGL</span>
                                  <span class="s__clone-chip s__clone-chip--gold">🛡️ 100/100 Audit</span>
                                </div>
                              </div>

                              <!-- Interactive 3D WebGL Artboard Box -->
                              <div class="s__clone-artboard">
                                <div class="s__artboard-grid-mesh"></div>
                                <div class="s__artboard-centerpiece">
                                  <div class="s__cyber-orb"></div>
                                  <div class="s__artboard-badge-text">
                                    <strong>INTERACTIVE 3D WEBGL ENGINE</strong>
                                    <small>THREE.JS &bull; GLSL SHADERS &bull; 60FPS LOCKED</small>
                                  </div>
                                </div>
                                <div class="s__artboard-telemetry">
                                  <span>VERTICES: 14.8K</span>
                                  <span>DRAWCALLS: 12</span>
                                  <span>MEM: 24MB</span>
                                </div>
                              </div>
                            </div>

                            <!-- Architecture Bento Grid -->
                            <div class="s__clone-bento">
                              <div class="s__clone-card">
                                <div class="s__clone-card-icon">⚡</div>
                                <div class="s__clone-card-info">
                                  <strong>Next.js 15 App Router</strong>
                                  <span>React Server Components & Turbopack</span>
                                </div>
                              </div>
                              <div class="s__clone-card">
                                <div class="s__clone-card-icon">✨</div>
                                <div class="s__clone-card-info">
                                  <strong>GSAP 3 Motion & Lenis</strong>
                                  <span>Butter-Smooth Momentum Scroll Physics</span>
                                </div>
                              </div>
                              <div class="s__clone-card">
                                <div class="s__clone-card-icon">🌍</div>
                                <div class="s__clone-card-info">
                                  <strong>Edge CDN & Turbo Cache</strong>
                                  <span>Global Sub-50ms TTFB Anywhere</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="s__sprint-pipeline">
                        <div class="s__pipeline-step">
                          <span class="s__pipeline-num">01</span>
                          <div class="s__pipeline-info">
                            <strong>₹100 Discovery</strong>
                            <span>UPI Instant Pre-fill</span>
                          </div>
                        </div>
                        <div class="s__pipeline-arrow">➔</div>
                        <div class="s__pipeline-step">
                          <span class="s__pipeline-num">02</span>
                          <div class="s__pipeline-info">
                            <strong>Figma Wireframe</strong>
                            <span>Design System & UI</span>
                          </div>
                        </div>
                        <div class="s__pipeline-arrow">➔</div>
                        <div class="s__pipeline-step">
                          <span class="s__pipeline-num">03</span>
                          <div class="s__pipeline-info">
                            <strong>High-Speed Code</strong>
                            <span>Next.js & Astro 5</span>
                          </div>
                        </div>
                        <div class="s__pipeline-arrow">➔</div>
                        <div class="s__pipeline-step is-highlight">
                          <span class="s__pipeline-num">04</span>
                          <div class="s__pipeline-info">
                            <strong>3 / 7 / 12 Rounds</strong>
                            <span>Structured Revisions</span>
                          </div>
                        </div>
                        <div class="s__pipeline-arrow">➔</div>
                        <div class="s__pipeline-step">
                          <span class="s__pipeline-num">05</span>
                          <div class="s__pipeline-info">
                            <strong>Live Deployment</strong>
                            <span>100% Code Ownership</span>
                          </div>
                        </div>
                      </div>
                    </div>
                    <span class="s__cell__mask"></span>
                  </div>
                )}

                {cat.id === 'graphic-design' && (
                  <div class="s__cell s__cell--full s__cell--visual-showcase js-cell">
                    <div class="s__cell__content s__visual-box">
                      <div class="s__visual-header">
                        <div class="s__visual-header-left">
                          <span class="s__visual-tag">[ BRAND DESIGN STUDIO & CANVA ARTIFACTS ]</span>
                          <span class="s__visual-status-pill"><span class="s__visual-pulse"></span>VECTOR ACCURACY &bull; 300 DPI READY</span>
                        </div>
                        <div class="s__visual-devices">
                          <span class="s__visual-device is-active">FIGMA MASTER</span>
                          <span class="s__visual-device">CANVA PRO EDITABLE</span>
                          <span class="s__visual-device">CMYK PRINT 300DPI</span>
                        </div>
                      </div>

                      <div class="s__artboard-studio">
                        <div class="s__artboard-left">
                          <div class="s__palette-cluster">
                            <span class="s__cluster-title">BRAND PALETTE TOKENS:</span>
                            <div class="s__palette-swatches">
                              <div class="s__swatch" style="background: #160000;">
                                <span class="s__swatch-hex">#160000</span>
                                <span class="s__swatch-name">Onyx Dark</span>
                              </div>
                              <div class="s__swatch" style="background: #FFF0EB; color: #160000;">
                                <span class="s__swatch-hex">#FFF0EB</span>
                                <span class="s__swatch-name">Warm Cream</span>
                              </div>
                              <div class="s__swatch" style="background: #E8C547; color: #160000;">
                                <span class="s__swatch-hex">#E8C547</span>
                                <span class="s__swatch-name">Champagne Gold</span>
                              </div>
                              <div class="s__swatch" style="background: #FF5500;">
                                <span class="s__swatch-hex">#FF5500</span>
                                <span class="s__swatch-name">Studio Ember</span>
                              </div>
                            </div>
                          </div>

                          <div class="s__typography-cluster">
