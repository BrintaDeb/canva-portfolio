      <span class="tag-num">[ 04 ]</span>
      <span class="tag-label">SERVICES &amp; PACKAGES</span>
    </div>
    <h2 class="s-services__title font-serif">
      Tailored Solutions <span class="title-amp font-sans">&amp;</span> Transparent Pricing
    </h2>
    <p class="s-services__desc font-mono">
      Choose a calibrated package or request a custom quotation tailored precisely to your project scope.
    </p>

    <!-- Interactive Category Filter Tabs -->
    <div class="s-services__tabs js-services-tabs" role="tablist">
      <button class="tab-btn is-active js-tab-btn" data-target="all" role="tab" aria-selected="true">
        <span class="tab-dot"></span> All Packages
      </button>
      <button class="tab-btn js-tab-btn" data-target="web-dev" role="tab" aria-selected="false">
        💻 Web Development
      </button>
      <button class="tab-btn js-tab-btn" data-target="graphic-design" role="tab" aria-selected="false">
        🎨 Graphic Design
      </button>
      <button class="tab-btn js-tab-btn" data-target="seo-management" role="tab" aria-selected="false">
        🚀 SEO Management
      </button>
    </div>
  </div>

  <div class="s-services__container">
    {
      categories.map((cat) => (
        <div class="service-category js-service-category" id={`category-${cat.id}`} data-category={cat.id}>
          <!-- 3D Perspective Glass Tilt Card Wrapper -->
          <div class="service-category__glass-card js-tilt-card">
            <div class="glass-glow-orb"></div>
            <div class="glass-reflection-line"></div>

            <div class="service-category__head">
