                  <div class="tier-card__specs">
                    {tier.specs.map((spec) => (
                      <div class="spec-row">
                        <span class="spec-label font-mono">{spec.label}</span>
                        <span class="spec-value font-mono">{spec.value}</span>
                      </div>
                    ))}
                  </div>

                  <div class="tier-card__action">
                    <a
                      href={`https://wa.me/917005581453?text=${encodeURIComponent(`Hi Brinta, I would like to request a quotation for: ${cat.title} - ${tier.name} (${tier.tier}) at ${tier.price}${tier.period}.`)}`}
