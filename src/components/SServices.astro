</section>

<script>
  import gsap from 'gsap'

  class ServicesSection {
    el: HTMLElement | null
    tiltCards: NodeListOf<HTMLElement>
    tabBtns: NodeListOf<HTMLElement>
    categories: NodeListOf<HTMLElement>

    constructor() {
      this.el = document.getElementById('services')
      if (!this.el) return

      this.tiltCards = this.el.querySelectorAll('.js-tilt-card')
      this.tabBtns = this.el.querySelectorAll('.js-tab-btn')
      this.categories = this.el.querySelectorAll('.js-service-category')

      this.initTilt()
      this.initTabs()
    }

    /**
     * 3D Perspective Tilt with Specular Reflection
     */
    initTilt() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      if (window.innerWidth < 768) return

      this.tiltCards.forEach((card) => {
        let bounds: DOMRect
        let isHovered = false

        const onMouseEnter = () => {
          bounds = card.getBoundingClientRect()
          isHovered = true
        }

        const onMouseMove = (e: MouseEvent) => {
          if (!isHovered) return
          const mouseX = e.clientX - bounds.left
          const mouseY = e.clientY - bounds.top

          const xPct = (mouseX / bounds.width - 0.5) * 2 // -1 to 1
          const yPct = (mouseY / bounds.height - 0.5) * 2 // -1 to 1

          const rotateX = -yPct * 6 // max 6deg tilt
          const rotateY = xPct * 6

          gsap.to(card, {
            rotationX: rotateX,
            rotationY: rotateY,
            transformPerspective: 1200,
            ease: 'power2.out',
            duration: 0.4,
          })

          const orb = card.querySelector('.glass-glow-orb') as HTMLElement
          if (orb) {
            gsap.to(orb, {
              x: mouseX,
              y: mouseY,
              duration: 0.3,
              ease: 'power1.out',
            })
          }
        }

        const onMouseLeave = () => {
          isHovered = false
          gsap.to(card, {
            rotationX: 0,
            rotationY: 0,
            ease: 'power3.out',
            duration: 0.8,
          })
        }

        card.addEventListener('mouseenter', onMouseEnter)
        card.addEventListener('mousemove', onMouseMove)
        card.addEventListener('mouseleave', onMouseLeave)
      })
    }

    /**
     * Category Tab Switcher
     */
    initTabs() {
      this.tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target')

          this.tabBtns.forEach((b) => {
            b.classList.toggle('is-active', b === btn)
            b.setAttribute('aria-selected', b === btn ? 'true' : 'false')
          })

          this.categories.forEach((cat) => {
            const catType = cat.getAttribute('data-category')
            if (target === 'all' || catType === target) {
              gsap.to(cat, {
                display: 'block',
                opacity: 1,
                y: 0,
                duration: 0.4,
                ease: 'power2.out',
              })
            } else {
              gsap.to(cat, {
                opacity: 0,
                y: 20,
                duration: 0.3,
                ease: 'power2.in',
                onComplete: () => {
                  cat.style.display = 'none'
                },
              })
            }
          })
        })
      })
    }
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ServicesSection())
  } else {
    new ServicesSection()
  }
</script>

<style lang="scss">
