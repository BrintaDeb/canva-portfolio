      </div>

      <h2 class="s-services__title">
        Bespoke Solutions <span class="title-amp">&amp;</span> Transparent Rates
      </h2>

      <p class="s-services__subtitle">
        Curated tiers engineered for scalable digital products, distinct branding, and search dominance.
      </p>

      <!-- 3 Options Switcher Bar (Only 3 Options) -->
      <div class="s-services__switcher js-services-switcher" role="tablist">
        {
          categories.map((cat, idx) => (
            <button
              class:list={['switcher-tab js-switcher-tab', { 'is-active': idx === 0 }]}
              data-target={cat.id}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="tab-code">[{cat.code}]</span>
              <span class="tab-emoji">{cat.emoji}</span>
              <span class="tab-label">{cat.title.replace(' Packages', '')}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Category Glass Cards Container -->
    <div class="s-services__deck">
      {
        categories.map((cat, idx) => (
          <div
            class:list={['service-view js-service-view', { 'is-active': idx === 0 }]}
            id={`category-${cat.id}`}
            data-category={cat.id}
          >
            <!-- 3D Perspective Glass Card with Subtle Physics -->
