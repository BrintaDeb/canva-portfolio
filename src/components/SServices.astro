---

<section id="services" class="s-services" data-intersect>
  <div class="s__inner js-inner">
    <div class="s__services-wrapper">
      <!-- Top Pill Header (Matches SAbout exactly) -->
      <div class="s__services-header">
        <span class="s__services-header__tag">SERVICES &amp; PACKAGES</span>
      </div>

      <!-- 3-Options Bento Tab Row -->
      <div class="s__tabs-bar" role="tablist">
        {
          categories.map((cat, idx) => (
            <button
              class:list={['s__tab-cell js-service-tab', { 'is-active': idx === 0 }]}
              data-target={cat.id}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="s__tab-code">[{cat.code}]</span>
              <span class="s__tab-name">{cat.navTitle}</span>
              <span class="s__cell__mask"></span>
            </button>
          ))
        }
      </div>

      <!-- Bento Grid (Black & White, 1:1 Architecture with SAbout) -->
      <div class="s__bento-container">
        {
          categories.map((cat, idx) => {
            const tier1 = cat.tiers[0]
            const tier2 = cat.tiers[1]
            const tier3 = cat.tiers[2]

            return (
              <div
                class:list={['s__bento s__bento--service js-service-bento', { 'is-active': idx === 0 }]}
                id={`bento-${cat.id}`}
                data-category={cat.id}
              >
                <!-- Row 1: Motto & Category Role -->
                <div class="s__cell s__cell--full js-cell">
                  <div class="s__cell__content">
                    <h3 class="s__cell__serif">"{cat.title}"</h3>
                    <p class="s__cell__serif-sub">{cat.tagline}</p>
                  </div>
                  <span class="s__cell__mask"></span>
                </div>

                <!-- Row 2: Split 2 Column (Tier 1 left, Tier 2 Stack right) -->
                <div class="s__row s__row--split">
                  <!-- Left: Tier 1 Tall Cell (Interactive Quotation Trigger) -->
                  <div
                    class="s__cell s__cell--tier-tall js-cell js-open-quote"
                    data-package={cat.title}
                    data-tier={tier1.name}
                    data-price={tier1.price + tier1.period}
                    data-specs={tier1.specs.map((s) => `${s.label}: ${s.value}`).join(' • ')}
                    role="button"
                    tabindex="0"
                    title={`Request Full Quotation for ${tier1.name}`}
                  >
                    <div class="s__cell__content">
                      <div class="s__cell__huge">
                        {tier1.price}<br />
                        <span class="s__cell__tiny-tier">{tier1.name}</span>
                      </div>
                      <div class="s__cell__meta">
                        {tier1.specs.map((s) => (
                          <span>({s.label}: {s.value})</span>
                        ))}
                      </div>
                      <div class="s__cell__cta-tag">
                        [ REQUEST FULL QUOTATION → ]
                      </div>
                    </div>
                    <span class="s__cell__mask"></span>
                  </div>

                  <!-- Right: Stacked Column (Tier 2 & Action) -->
                  <div class="s__col">
                    <!-- Top: Tier 2 (Most Popular / Recommended) -->
                    <div
                      class="s__cell s__cell--netmag js-cell js-open-quote"
                      data-package={cat.title}
                      data-tier={tier2.name}
                      data-price={tier2.price + tier2.period}
                      data-specs={tier2.specs.map((s) => `${s.label}: ${s.value}`).join(' • ')}
                      role="button"
                      tabindex="0"
                      title={`Request Full Quotation for ${tier2.name}`}
                    >
                      <div class="s__cell__content">
                        <div class="s__cell__badge-mono">★ {tier2.popularBadge} ★</div>
                        <h4 class="s__cell__serif">{tier2.name} — {tier2.price}</h4>
                        <p class="s__cell__serif-sub">
                          {tier2.specs[0].value} • {tier2.specs[1].value}
                        </p>
                      </div>
                      <span class="s__cell__mask"></span>
                    </div>

                    <!-- Bottom: Hatching stripes + Instant WhatsApp Trigger -->
                    <div class="s__subrow">
                      <div class="s__cell s__cell--stripes">
                        <div class="s__stripes-pattern"></div>
                      </div>

                      <div
                        class="s__cell s__cell--fwa js-cell js-open-quote"
                        data-package={cat.title}
                        data-tier={tier2.name}
                        data-price={tier2.price + tier2.period}
                        data-specs={tier2.specs.map((s) => `${s.label}: ${s.value}`).join(' • ')}
                        role="button"
                        tabindex="0"
                        title="Book Tier 2"
                      >
                        <div class="s__cell__content">
                          <div class="s__cell__bold">BOOK TIER 2</div>
                          <div class="s__cell__meta">
                            <span>(Full Quotation)</span>
                            <span>(WhatsApp Direct)</span>
                          </div>
                        </div>
                        <span class="s__cell__mask"></span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Row 3: Tier 3 Full Width Banner -->
                <div
                  class="s__cell s__cell--full s__cell--tier3 js-cell js-open-quote"
                  data-package={cat.title}
                  data-tier={tier3.name}
                  data-price={tier3.price + tier3.period}
                  data-specs={tier3.specs.map((s) => `${s.label}: ${s.value}`).join(' • ')}
                  role="button"
                  tabindex="0"
                  title={`Request Full Quotation for ${tier3.name}`}
                >
                  <div class="s__cell__content">
                    <h3 class="s__cell__serif">{tier3.name} — {tier3.price}{tier3.period}</h3>
                    <p class="s__cell__serif-sub">
                      {tier3.specs.map((s) => `(${s.label}: ${s.value})`).join(' • ')}
                    </p>
                    <div class="s__cell__cta-tag" style="margin-top: 0.5rem;">
                      [ CLICK FOR FULL DETAILED QUOTATION → ]
                    </div>
                  </div>
                  <span class="s__cell__mask"></span>
                </div>
              </div>
            )
          })
        }

        <!-- Row 4: Custom Project Scope Estimator & Quotation Builder -->
        <div class="s__cell s__cell--custom-quote js-cell no-tilt" data-no-tilt>
          <div class="s__custom-quote-header">
            <span class="s__custom-tag">[ INTERACTIVE PROJECT SCOPE & TIMELINE ESTIMATOR ]</span>
            <h4 class="s__custom-title">Build your tailored scope across Web, UI/UX, 3D Motion & SEO</h4>
            <p class="s__custom-subtitle">Toggle the deliverables you need below to calculate estimated turnaround and investment tier in real-time.</p>
          </div>

          <!-- Interactive Deliverables Matrix -->
          <div class="s__scope-section">
            <span class="s__scope-section-label">SELECT REQUIRED DELIVERABLES:</span>
            <div class="s__scope-matrix">
              <label class="scope-chip js-scope-chip is-selected" data-module="Fullstack Web App (Next.js / Astro)" data-days="5" data-cost="20000">
                <input type="checkbox" checked class="scope-checkbox" value="Fullstack Web App (Next.js / Astro)" />
                <span class="chip-check">✓</span>
                <span class="chip-icon">🌐</span>
                <span class="chip-label">Fullstack Web App (Next.js / Astro)</span>
                <span class="chip-badge">+5 Days</span>
              </label>

              <label class="scope-chip js-scope-chip is-selected" data-module="Bespoke Figma UI/UX & Design System" data-days="3" data-cost="12000">
                <input type="checkbox" checked class="scope-checkbox" value="Bespoke Figma UI/UX & Design System" />
                <span class="chip-check">✓</span>
                <span class="chip-icon">🎨</span>
                <span class="chip-label">Bespoke Figma UI/UX & Design System</span>
                <span class="chip-badge">+3 Days</span>
              </label>

              <label class="scope-chip js-scope-chip" data-module="3D Experience & GSAP Motion Systems" data-days="3" data-cost="15000">
                <input type="checkbox" class="scope-checkbox" value="3D Experience & GSAP Motion Systems" />
                <span class="chip-check">✓</span>
                <span class="chip-icon">✨</span>
                <span class="chip-label">3D Experience & GSAP Motion Systems</span>
                <span class="chip-badge">+3 Days</span>
              </label>

              <label class="scope-chip js-scope-chip" data-module="Gourmet Cart / Dynamic E-Commerce" data-days="4" data-cost="18000">
                <input type="checkbox" class="scope-checkbox" value="Gourmet Cart / Dynamic E-Commerce" />
                <span class="chip-check">✓</span>
                <span class="chip-icon">🛒</span>
                <span class="chip-label">Gourmet Cart / Dynamic E-Commerce</span>
                <span class="chip-badge">+4 Days</span>
              </label>

              <label class="scope-chip js-scope-chip" data-module="Cinematic Promo Reel & Video Editing" data-days="2" data-cost="10000">
                <input type="checkbox" class="scope-checkbox" value="Cinematic Promo Reel & Video Editing" />
                <span class="chip-check">✓</span>
                <span class="chip-icon">🎬</span>
                <span class="chip-label">Cinematic Promo Reel & Video Editing</span>
                <span class="chip-badge">+2 Days</span>
              </label>

              <label class="scope-chip js-scope-chip" data-module="Technical SEO & Core Web Vitals Audit" data-days="2" data-cost="8000">
                <input type="checkbox" class="scope-checkbox" value="Technical SEO & Core Web Vitals Audit" />
                <span class="chip-check">✓</span>
                <span class="chip-icon">⚡</span>
                <span class="chip-label">Technical SEO & Core Web Vitals Audit</span>
                <span class="chip-badge">+2 Days</span>
              </label>
            </div>

            <!-- Dynamic Live Calculation Bar -->
            <div class="s__estimator-telemetry">
              <div class="telemetry-card">
                <span class="telemetry-label">ESTIMATED TIMELINE</span>
                <span id="estimatorDays" class="telemetry-value">7 - 10 Business Days</span>
              </div>
              <div class="telemetry-card">
                <span class="telemetry-label">RECOMMENDED BRACKET</span>
                <span id="estimatorBracket" class="telemetry-value">Professional Tier (~₹32,000)</span>
              </div>
              <div class="telemetry-card">
                <span class="telemetry-label">SELECTED MODULES</span>
                <span id="estimatorCount" class="telemetry-value">2 Deliverables Selected</span>
              </div>
            </div>
          </div>

          <form id="customQuoteForm" class="s__quote-form js-quote-form">
            <!-- Upfront Fee Requirement Box -->
            <div class="custom-paygate-box">
              <div class="paygate-badge-row">
                <div class="paygate-badge-left">
                  <span class="paygate-lock-icon">🔒</span>
                  <span class="paygate-tag">₹100 UPFRONT RESERVATION REQUIRED TO SUBMIT QUOTATION</span>
                </div>
                <span class="paygate-refund-pill">50% REFUNDABLE</span>
              </div>
              <p class="paygate-quote">
                &ldquo;Upfront fee is required to value both our time and ensure custom scope calculations are reserved for serious clients. 50% refundable if not proceeding, or 100% credited against your final project invoice.&rdquo;
              </p>
              <div class="paygate-qr-preview">
                <img
                  src="/images/brinta-navi-upi-qr.jpg"
                  alt="Navi UPI QR - Brinta Deb"
                  class="paygate-mini-qr"
                  width="75"
                  height="108"
                  loading="lazy"
                />
                <div class="paygate-qr-info">
                  <span class="paygate-upi-label">SCAN WITH ANY UPI APP OR PAY DIRECT:</span>
                  <div class="paygate-upi-row">
                    <span class="paygate-upi-id js-custom-upi-val">brintadeb1453@nyes</span>
                    <button type="button" class="paygate-copy-btn js-custom-copy-upi" title="Copy UPI ID">
                      <span class="js-custom-copy-label">COPY</span> ⎘
                    </button>
                  </div>
                  <a
                    href="upi://pay?pa=brintadeb1453@nyes&pn=BRINTA%20DEB&am=100&cu=INR&tn=Custom%20Scope%20Quotation%20Fee"
                    class="paygate-app-link"
                    title="Open in UPI App on Mobile"
                  >
                    ⚡ OPEN IN UPI APP (GPAY / PHONEPE / PAYTM / NAVI) ↗
                  </a>
                </div>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="quoteClientName">YOUR NAME / COMPANY *</label>
                <input
                  type="text"
                  id="quoteClientName"
                  placeholder="e.g. Alex Morgan / Studio Pulse"
                  required
                />
              </div>

              <div class="form-group">
                <label for="quoteCategory">PRIMARY SERVICE *</label>
                <select id="quoteCategory">
                  <option value="Web Development & 3D Web">Web Development &amp; 3D Web</option>
                  <option value="UI/UX & Brand Identity">UI/UX &amp; Brand Identity</option>
                  <option value="SEO Management & Growth Retainer">SEO Management &amp; Retainer</option>
                  <option value="Full Creative Nomad Direction (Hybrid)">Full Creative Direction (Hybrid)</option>
                </select>
              </div>

              <div class="form-group">
                <label for="quotePhone">YOUR WHATSAPP NUMBER (IF SENDING ON WHATSAPP)</label>
                <input
                  type="tel"
                  id="quotePhone"
                  placeholder="+91 98765 43210"
                />
              </div>

              <div class="form-group">
                <label for="quoteBudget">ESTIMATED BUDGET / TIMELINE</label>
                <input
                  type="text"
                  id="quoteBudget"
                  placeholder="e.g. ₹40,000 / 2-3 Weeks"
                />
              </div>

              <div class="form-group form-group--full">
                <label for="quoteRequirements">PROJECT DETAILS &amp; KEY REQUIREMENTS *</label>
                <textarea
                  id="quoteRequirements"
                  rows="2"
                  placeholder="Describe pages, features, branding vision, or specific reference websites..."
                  required
                ></textarea>
              </div>

              <!-- Mandatory UTR Field for in-page custom quote -->
              <div class="form-group form-group--full form-group--utr">
                <label for="quoteUtr">
                  <span>UPI TRANSACTION REFERENCE / 12-DIGIT UTR *</span>
                  <span class="field-hint">Required to verify ₹100 reservation fee before dispatching</span>
                </label>
                <input
                  type="text"
                  id="quoteUtr"
                  class="js-quote-utr"
                  placeholder="e.g. 423589123456 or Transaction ID from UPI receipt"
                  required
                />
                <div id="quoteUtrError" class="modal-utr-error" style="display: none;">
                  ⚠️ Upfront ₹100 fee verification required. Please transfer via UPI and enter your 12-digit UTR to send this quotation.
                </div>
              </div>
            </div>

            <!-- Dual Dispatch Action Buttons -->
            <div class="custom-actions-row">
              <button type="button" class="custom-action-btn custom-action-btn--wa js-custom-send-wa">
                <span class="btn-icon">💬</span>
                <span>SEND QUOTATION ON WHATSAPP</span>
                <span class="btn-arrow">↗</span>
              </button>
              <button type="button" class="custom-action-btn custom-action-btn--mail js-custom-send-mail">
                <span class="btn-icon">✉️</span>
                <span>SEND QUOTATION ON EMAIL</span>
                <span class="btn-arrow">↗</span>
              </button>
            </div>

            <div class="custom-fee-guarantee">
              <span>🔒 Upfront ₹100 reservation fee required • 50% Refundable if not proceeding • 100% credited against project bill.</span>
            </div>
          </form>
        </div><!-- .s__cell--custom-quote -->

        <!-- Row 5: Detailed Terms & Quality Narrative -->
        <div class="s__cell s__cell--full s__cell--bio js-cell">
          <div class="s__cell__content">
            <p class="s__cell__bio-text">
              Transparent rates, rapid delivery, and direct pair-collaboration. Every project includes structured revisions, modern web performance optimization, and scalable source files.
            </p>
          </div>
          <span class="s__cell__mask"></span>
        </div>
      </div><!-- .s__bento-container -->
    </div><!-- .s__services-wrapper -->
  </div><!-- .s__inner -->

  <!-- Interactive Full Quotation Modal for Tier Clicks -->
  <div id="serviceQuoteModal" class="service-quote-modal hidden">
    <div class="modal-backdrop js-close-modal"></div>
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-header-tag">[ REQUEST OFFICIAL QUOTATION // UPFRONT COMMITMENT REQUIRED ]</div>
        <button class="modal-close-btn js-close-modal" aria-label="Close modal">✕</button>
      </div>

      <div class="modal-body">
        <div class="modal-summary-box">
          <div class="summary-line">
            <span class="summary-label">PACKAGE:</span>
            <span id="modalPackageName" class="summary-val">Web Development Packages</span>
          </div>
          <div class="summary-line">
            <span class="summary-label">TIER:</span>
            <span id="modalTierName" class="summary-val">Professional (Tier 2)</span>
          </div>
          <div class="summary-line">
            <span class="summary-label">ESTIMATED RATE:</span>
            <span id="modalTierPrice" class="summary-val font-bold">₹35,000</span>
          </div>
        </div>

        <!-- Upfront Fee Requirement Box -->
        <div class="modal-paygate-box">
          <div class="paygate-badge-row">
            <div class="paygate-badge-left">
              <span class="paygate-lock-icon">🔒</span>
              <span class="paygate-tag">₹100 UPFRONT FEE REQUIRED TO SEND QUOTATION</span>
            </div>
            <span class="paygate-refund-pill">50% REFUNDABLE</span>
          </div>
          <p class="paygate-quote">
            &ldquo;This nominal upfront reservation ensures quotation reviews and scopes are reserved strictly for serious clients. 50% refundable if not proceeding, or 100% credited against your final project invoice.&rdquo;
          </p>
          <div class="paygate-qr-preview">
            <img
              src="/images/brinta-navi-upi-qr.jpg"
              alt="Navi UPI QR - Brinta Deb"
              class="paygate-mini-qr"
              width="75"
              height="108"
              loading="lazy"
            />
            <div class="paygate-qr-info">
              <span class="paygate-upi-label">SCAN WITH ANY UPI APP OR PAY DIRECT:</span>
              <div class="paygate-upi-row">
                <span class="paygate-upi-id js-modal-upi-val">brintadeb1453@nyes</span>
                <button type="button" class="paygate-copy-btn js-modal-copy-upi" title="Copy UPI ID">
                  <span class="js-modal-copy-label">COPY</span> ⎘
                </button>
              </div>
              <a
                href="upi://pay?pa=brintadeb1453@nyes&pn=BRINTA%20DEB&am=100&cu=INR&tn=Quotation%20Submission%20Fee"
                class="paygate-app-link"
                title="Open in UPI App on Mobile"
              >
                ⚡ OPEN IN UPI APP (GPAY / PHONEPE / PAYTM / NAVI) ↗
              </a>
            </div>
          </div>
        </div>

        <form id="tierQuoteForm" class="modal-form">
          <div class="form-group">
            <label for="modalClientName">YOUR NAME / BRAND *</label>
            <input
              type="text"
              id="modalClientName"
              placeholder="e.g. John Doe / Acme Inc"
              required
            />
          </div>

          <div class="form-group">
            <label for="modalPhone">YOUR WHATSAPP NUMBER (IF SENDING ON WHATSAPP)</label>
            <input
              type="tel"
              id="modalPhone"
              placeholder="+91 98765 43210"
            />
          </div>

          <div class="form-group">
            <label for="modalTimeline">TARGET LAUNCH TIMELINE</label>
            <input
              type="text"
              id="modalTimeline"
              placeholder="e.g. Within 2-3 weeks / ASAP"
            />
          </div>

          <div class="form-group">
            <label for="modalNotes">SPECIFIC REQUIREMENTS OR NOTES</label>
            <textarea
              id="modalNotes"
              rows="2"
              placeholder="Any specific features, design preferences, or reference links..."
            ></textarea>
          </div>

          <!-- Mandatory UTR Field -->
          <div class="form-group form-group--utr">
            <label for="modalUtr">
              <span>UPI TRANSACTION REFERENCE / 12-DIGIT UTR *</span>
              <span class="field-hint">Required to verify ₹100 reservation fee</span>
            </label>
            <input
              type="text"
              id="modalUtr"
              class="js-modal-utr"
              placeholder="e.g. 423589123456 or PhonePe Transaction ID"
              required
            />
            <div id="modalUtrError" class="modal-utr-error" style="display: none;">
              ⚠️ Upfront ₹100 fee verification required. Please transfer via UPI and enter your 12-digit UTR to send this quotation.
            </div>
          </div>

          <!-- Dual Dispatch Action Buttons -->
          <div class="modal-actions-row">
            <button type="button" class="modal-action-btn modal-action-btn--wa js-send-quote-wa">
              <span class="btn-icon">💬</span>
              <span>SEND ON WHATSAPP</span>
              <span class="btn-arrow">↗</span>
            </button>
            <button type="button" class="modal-action-btn modal-action-btn--mail js-send-quote-mail">
              <span class="btn-icon">✉️</span>
              <span>SEND ON EMAIL</span>
              <span class="btn-arrow">↗</span>
            </button>
          </div>

          <div class="modal-fee-guarantee">
            <span>🔒 ₹100 Upfront Fee • 50% Refundable if not proceeding • 100% credited against project bill.</span>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Interactive Subtle Smiley Canvas Overlay -->
  <canvas class="s__canvas js-services-canvas"></canvas>
</section>

<script>
  import Emitter from '../utils/Emitter'
  import gsap from 'gsap'
  import { audioEngine } from '../utils/AudioEngine.js'

  class ServicesBento {
    el: HTMLElement | null
    tabButtons: NodeListOf<HTMLElement>
    bentoViews: NodeListOf<HTMLElement>
    cells: NodeListOf<HTMLElement>
    canvas: HTMLCanvasElement | null
    ctx: CanvasRenderingContext2D | null

    quoteModal: HTMLElement | null
    modalPackageName: HTMLElement | null
    modalTierName: HTMLElement | null
    modalTierPrice: HTMLElement | null
    tierQuoteForm: HTMLFormElement | null
    customQuoteForm: HTMLFormElement | null

    activeTierData: {
      package: string
      tier: string
      price: string
      specs: string
    }

    smileyImages: {
      main: HTMLImageElement
      contrasted: HTMLImageElement
    } | null

    smileys: any[]
    lastThrow: number
    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    isPaused: boolean

    constructor() {
      this.el = document.getElementById('services')
      if (!this.el) return

      this.tabButtons = this.el.querySelectorAll('.js-service-tab')
      this.bentoViews = this.el.querySelectorAll('.js-service-bento')
      this.cells = this.el.querySelectorAll('.js-cell, .js-service-tab')
      this.canvas = this.el.querySelector('.js-services-canvas')
      this.ctx = this.canvas?.getContext('2d') || null

      this.quoteModal = document.getElementById('serviceQuoteModal')
      if (this.quoteModal && this.quoteModal.parentElement !== document.body) {
        document.body.appendChild(this.quoteModal)
      }
      this.modalPackageName = document.getElementById('modalPackageName')
      this.modalTierName = document.getElementById('modalTierName')
      this.modalTierPrice = document.getElementById('modalTierPrice')
      this.tierQuoteForm = document.getElementById('tierQuoteForm') as HTMLFormElement
      this.customQuoteForm = document.getElementById('customQuoteForm') as HTMLFormElement

      this.activeTierData = {
        package: '',
        tier: '',
        price: '',
        specs: '',
      }

      this.smileys = []
      this.lastThrow = 0
      this.smileyImages = null
      this.isPaused = true

      this.bounding = {
        left: 0,
        top: 0,
        width: 0,
        height: 0,
      }

      this.initTabs()
      this.initSmileyEngine()
      this.initQuotationSystem()
      this.initScopeEstimator()
    }

    initTabs() {
      this.tabButtons.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target')

          this.tabButtons.forEach((t) => {
            const active = t === tab
            t.classList.toggle('is-active', active)
            t.setAttribute('aria-selected', active ? 'true' : 'false')
          })

          this.bentoViews.forEach((v) => {
            const cat = v.getAttribute('data-category')
            if (cat === target) {
              v.style.display = 'flex'
              gsap.fromTo(
                v,
                { opacity: 0, y: 10 },
                { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }
              )
            } else {
              v.style.display = 'none'
            }
          })
        })
      })
    }

    initQuotationSystem() {
      // Tier Cell Clicks -> Open Full Quotation Modal
      const quoteTriggers = this.el?.querySelectorAll('.js-open-quote')
      quoteTriggers?.forEach((trigger) => {
        const handleOpen = (e: Event) => {
          e.preventDefault()
          const pkg = trigger.getAttribute('data-package') || ''
          const tier = trigger.getAttribute('data-tier') || ''
          const price = trigger.getAttribute('data-price') || ''
          const specs = trigger.getAttribute('data-specs') || ''

          this.activeTierData = { package: pkg, tier, price, specs }

          if (this.modalPackageName) this.modalPackageName.textContent = pkg
          if (this.modalTierName) this.modalTierName.textContent = tier
          if (this.modalTierPrice) this.modalTierPrice.textContent = price

          // Pre-fill UTR if stored in session
          const savedUtr = sessionStorage.getItem('call_payment_utr')
          const modalUtr = document.getElementById('modalUtr') as HTMLInputElement | null
          if (modalUtr && savedUtr && !modalUtr.value) {
            modalUtr.value = savedUtr
          }
          const utrError = document.getElementById('modalUtrError')
          if (utrError) utrError.style.display = 'none'

          this.quoteModal?.classList.remove('hidden')
          document.body.style.overflow = 'hidden'

          setTimeout(() => {
            const clientInput = document.getElementById('modalClientName') as HTMLInputElement
            clientInput?.focus()
          }, 150)
        }

        trigger.addEventListener('click', handleOpen)
        trigger.addEventListener('keydown', (e: any) => {
          if (e.key === 'Enter' || e.key === ' ') {
            handleOpen(e)
          }
        })
      })

      // Close modal handlers
      this.quoteModal?.querySelectorAll('.js-close-modal').forEach((btn) => {
        btn.addEventListener('click', () => this.closeModal())
      })

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !this.quoteModal?.classList.contains('hidden')) {
          this.closeModal()
        }
      })

      // Copy UPI ID functionality for both Modal and In-Page Estimator
      const bindCopyUpi = (btnSelector: string, labelSelector: string) => {
        const btn = document.querySelector(btnSelector)
        const label = document.querySelector(labelSelector)
        if (!btn) return
        btn.addEventListener('click', async () => {
          const upiId = 'brintadeb1453@nyes'
          try { audioEngine?.playTone?.(750, 0.08) } catch (e) {}

          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(upiId)
            } else {
              const temp = document.createElement('textarea')
              temp.value = upiId
              document.body.appendChild(temp)
              temp.select()
              document.execCommand('copy')
              document.body.removeChild(temp)
            }
            if (label) {
              const orig = label.textContent
              label.textContent = '✓ COPIED'
              btn.classList.add('is-copied')
              setTimeout(() => {
                if (label) label.textContent = orig
                btn.classList.remove('is-copied')
              }, 2500)
            }
          } catch {
            if (label) label.textContent = 'COPIED'
          }
        })
      }

      bindCopyUpi('.js-modal-copy-upi', '.js-modal-copy-label')
      bindCopyUpi('.js-custom-copy-upi', '.js-custom-copy-label')

      // Pre-fill Custom Quote UTR if available in sessionStorage
      const savedSessionUtr = sessionStorage.getItem('call_payment_utr')
      const quoteUtrInput = document.getElementById('quoteUtr') as HTMLInputElement | null
      if (quoteUtrInput && savedSessionUtr && !quoteUtrInput.value) {
        quoteUtrInput.value = savedSessionUtr
      }

      // Input listener to auto-clear error banners when user types valid UTR
      const modalUtrInput = document.getElementById('modalUtr') as HTMLInputElement | null
      const modalUtrErr = document.getElementById('modalUtrError') as HTMLElement | null
      modalUtrInput?.addEventListener('input', () => {
        if (modalUtrInput.value.trim().length >= 6) {
          modalUtrInput.classList.remove('has-error')
          if (modalUtrErr) modalUtrErr.style.display = 'none'
        }
      })

      const customUtrInput = document.getElementById('quoteUtr') as HTMLInputElement | null
      const customUtrErr = document.getElementById('quoteUtrError') as HTMLElement | null
      customUtrInput?.addEventListener('input', () => {
        if (customUtrInput.value.trim().length >= 6) {
          customUtrInput.classList.remove('has-error')
          if (customUtrErr) customUtrErr.style.display = 'none'
        }
      })

      // Action Button Listeners for Modal Quotation
      this.quoteModal?.querySelector('.js-send-quote-wa')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendTierQuote('whatsapp')
      })
      this.quoteModal?.querySelector('.js-send-quote-mail')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendTierQuote('email')
      })
      this.tierQuoteForm?.addEventListener('submit', (e) => {
        e.preventDefault()
        this.validateAndSendTierQuote('whatsapp')
      })

      // Action Button Listeners for In-Page Custom Scope Form
      this.el?.querySelector('.js-custom-send-wa')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendCustomQuote('whatsapp')
      })
      this.el?.querySelector('.js-custom-send-mail')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendCustomQuote('email')
      })
      this.customQuoteForm?.addEventListener('submit', (e) => {
        e.preventDefault()
        this.validateAndSendCustomQuote('whatsapp')
      })
    }

    closeModal() {
      this.quoteModal?.classList.add('hidden')
      document.body.style.overflow = ''
      const utrErr = document.getElementById('modalUtrError')
      if (utrErr) utrErr.style.display = 'none'
      const modalUtr = document.getElementById('modalUtr') as HTMLInputElement | null
      modalUtr?.classList.remove('has-error')
    }

    validateAndSendTierQuote(channel: 'whatsapp' | 'email') {
      const clientInput = document.getElementById('modalClientName') as HTMLInputElement | null
      const phoneInput = document.getElementById('modalPhone') as HTMLInputElement | null
      const timelineInput = document.getElementById('modalTimeline') as HTMLInputElement | null
      const notesInput = document.getElementById('modalNotes') as HTMLTextAreaElement | null
      const utrInput = document.getElementById('modalUtr') as HTMLInputElement | null
      const utrErr = document.getElementById('modalUtrError') as HTMLElement | null

      const clientName = clientInput?.value.trim() || ''
      const phone = phoneInput?.value.trim() || ''
      const timeline = timelineInput?.value.trim() || 'Flexible / ASAP'
      const notes = notesInput?.value.trim() || 'Standard package deliverables.'
      const utr = utrInput?.value.trim() || ''

      if (!clientName) {
        clientInput?.focus()
        clientInput?.classList.add('has-error')
        setTimeout(() => clientInput?.classList.remove('has-error'), 2000)
        return
      }

      // STRICT VALIDATION: Upfront ₹100 reservation UTR is required
      if (!utr || utr.length < 6) {
        if (utrErr) utrErr.style.display = 'block'
        utrInput?.focus()
        utrInput?.classList.add('has-error')
        try { audioEngine?.playError?.() } catch (e) {}
        return
      }

      if (utrErr) utrErr.style.display = 'none'
      utrInput?.classList.remove('has-error')

      // Save verified UTR in session so user doesn't have to re-enter
      sessionStorage.setItem('call_payment_utr', utr)
      const customUtr = document.getElementById('quoteUtr') as HTMLInputElement | null
      if (customUtr && !customUtr.value) customUtr.value = utr

      try { audioEngine?.playSuccess?.() } catch (e) {}

      const pkg = this.activeTierData.package || 'Custom Web & Creative Service'
      const tier = this.activeTierData.tier || 'Selected Tier'
      const price = this.activeTierData.price || 'Market Rate'

      if (channel === 'whatsapp') {
        const waLines = [
          `*QUOTATION REQUEST // BRINTA DEB PORTFOLIO*`,
