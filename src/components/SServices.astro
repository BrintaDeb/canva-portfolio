<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import gsap from 'gsap'

  class ServicesBento {
    el: HTMLElement | null
    tabButtons: NodeListOf<HTMLElement>
    bentoViews: NodeListOf<HTMLElement>
    cells: NodeListOf<HTMLElement>
    canvas: HTMLCanvasElement | null
    ctx: CanvasRenderingContext2D | null

    smileyImages: {
      main: HTMLImageElement
      contrasted: HTMLImageElement
    } | null

    smileys: any[]
    lastThrow: number
    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    isPaused: boolean

    constructor() {
      this.el = document.getElementById('services')
      if (!this.el) return

      this.tabButtons = this.el.querySelectorAll('.js-service-tab')
      this.bentoViews = this.el.querySelectorAll('.js-service-bento')
      this.cells = this.el.querySelectorAll('.js-cell, .js-service-tab')
      this.canvas = this.el.querySelector('.js-services-canvas')
      this.ctx = this.canvas?.getContext('2d') || null

      this.smileys = []
      this.lastThrow = 0
      this.smileyImages = null
      this.isPaused = true

      this.bounding = {
        left: 0,
        top: 0,
        width: 0,
        height: 0,
      }

      this.initTabs()
      this.initSmileyEngine()
    }

    initTabs() {
      this.tabButtons.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target')

          this.tabButtons.forEach((t) => {
            const active = t === tab
            t.classList.toggle('is-active', active)
            t.setAttribute('aria-selected', active ? 'true' : 'false')
          })

          this.bentoViews.forEach((v) => {
            const cat = v.getAttribute('data-category')
            if (cat === target) {
              v.style.display = 'flex'
              gsap.fromTo(
                v,
                { opacity: 0, y: 10 },
                { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }
              )
            } else {
              v.style.display = 'none'
            }
          })
        })
      })
    }

    initSmileyEngine() {
      // Load smiley images
      const mainImg = new Image(100, 100)
      mainImg.src = '/images/asset-smiley--main.svg'

      const contrastedImg = new Image(100, 100)
      contrastedImg.src = '/images/asset-smiley--contrasted.svg'

      this.smileyImages = {
        main: mainImg,
        contrasted: contrastedImg,
      }

      this.setSize()

      // Bind resize & scroll
      Emitter.on('resize', () => this.setSize(), this)

      // Bind subtle hover throw on cells (very less: max 1-2 smileys with cooldown)
      this.cells.forEach((cell) => {
        const onHover = () => this.throwSubtleSmiley(cell)
        cell.addEventListener('mouseenter', onHover, { passive: true })
        cell.addEventListener('touchstart', onHover, { passive: true })
      })

      // Intersect observer to pause canvas rendering when offscreen
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            this.isPaused = !entry.isIntersecting
            if (!this.isPaused) {
              Emitter.on('tick', this.tick, this)
            } else {
              Emitter.off('tick', this.tick, this)
            }
          })
        },
        { threshold: 0.1 }
      )
      if (this.el) observer.observe(this.el)
    }

    setSize() {
      if (!this.el || !this.canvas) return
      const rect = this.el.getBoundingClientRect()
      this.bounding = {
        left: rect.left,
        top: rect.top,
        width: this.el.clientWidth,
        height: this.el.clientHeight,
      }
      this.canvas.width = this.bounding.width
      this.canvas.height = this.bounding.height
    }

    /**
     * Throw subtle & sparse smileys (1 or 2 max)
     */
    throwSubtleSmiley(cell: HTMLElement) {
      const now = Date.now()
      if (now - this.lastThrow < 280) return // Throttled to keep it "very less"
      this.lastThrow = now

      if (!this.el) return
      const cellRect = cell.getBoundingClientRect()
      const elRect = this.el.getBoundingClientRect()

      // Spawn only 1 or 2 small smileys
      const count = Math.random() > 0.6 ? 2 : 1

      for (let i = 0; i < count; i++) {
        const size = Math.random() * 10 + 20 // 20px - 30px
        const x = cellRect.left - elRect.left + Math.random() * cellRect.width
        const y = cellRect.top - elRect.top + Math.random() * (cellRect.height * 0.5)

        const velocity = {
          x: (Math.random() - 0.5) * 5,
          y: -Math.random() * 3.5 - 1.5,
        }

        this.smileys.push({
          x,
          y,
          size,
          velocity,
          gravity: 0.16,
          rotation: Math.random() * Math.PI * 2,
          rotationSpeed: (Math.random() - 0.5) * 0.12,
          opacity: 0.9,
        })
      }
    }

    updateSmileys() {
      if (!this.ctx || !this.smileyImages) return
      this.ctx.clearRect(0, 0, this.bounding.width, this.bounding.height)

      if (this.smileys.length === 0) return

      const isContrasted = document.documentElement.classList.contains('theme-contrasted')
      const img = isContrasted ? this.smileyImages.contrasted : this.smileyImages.main

      for (let i = this.smileys.length - 1; i >= 0; i--) {
        const s = this.smileys[i]
        s.x += s.velocity.x
        s.y += s.velocity.y
        s.velocity.y += s.gravity
        s.rotation += s.rotationSpeed
        s.opacity -= 0.014 // Smooth gentle fade

        if (s.opacity <= 0) {
          this.smileys.splice(i, 1)
          continue
        }

        this.ctx.save()
        this.ctx.globalAlpha = Math.max(0, s.opacity)
        this.ctx.translate(s.x, s.y)
        this.ctx.rotate(s.rotation)
        this.ctx.drawImage(img, -s.size / 2, -s.size / 2, s.size, s.size)
        this.ctx.restore()
      }
    }

    tick() {
      if (this.smileys.length > 0) {
        this.updateSmileys()
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ServicesBento())
  } else {
    new ServicesBento()
  }
</script>

<style lang="scss">
  .s-services {
    position: relative;
    z-index: 3;
    padding: 7rem 0 8rem;
    background: color(primary);
    border-bottom: 1px solid color(secondary);
    overflow: hidden;

    @include mq(tablet) {
      padding: 4rem 0 5rem;
    }

    .s__inner {
      position: relative;
      z-index: 2;
      margin: 0 auto;
      width: 38rem;
      max-width: calc(100% - 2.5rem);

      @include mq(phone) {
        width: 100%;
        max-width: calc(100% - 1.5rem);
      }
    }

    .s__services-wrapper {
      position: relative;
      width: 100%;
    }

    /* Top Pill Header (Matches SAbout 1:1) */
    .s__services-header {
      display: block;
      background: color(secondary);
      color: color(primary);
      text-align: center;
      padding: 0.45rem 1rem;
      border: 1px solid color(secondary);
      border-bottom: 0;

      &__tag {
        font: 700 0.6875rem / 1 font-family(fraktion);
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
    }

    /* 3-Option Bento Tab Bar */
    .s__tabs-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid color(secondary);
      border-bottom: 0;
      background: color(primary);

      @include mq(phone) {
        grid-template-columns: 1fr;
      }
    }

    .s__tab-cell {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.85rem 0.5rem;
      background: color(primary);
      border: none;
      border-right: 1px solid color(secondary);
      color: color(secondary);
      cursor: pointer;
      overflow: hidden;
      text-decoration: none;
      transition: color 0.25s ease;

      &:last-child {
        border-right: none;
      }

      @include mq(phone) {
        border-right: none;
        border-bottom: 1px solid color(secondary);

        &:last-child {
          border-bottom: none;
        }
      }

      .s__tab-code {
        font: 700 0.6875rem / 1 font-family(fraktion);
        letter-spacing: 0.1em;
        position: relative;
        z-index: 2;
      }

      .s__tab-name {
        font: 700 0.6875rem / 1 font-family(fraktion);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        position: relative;
        z-index: 2;
      }

      .s__cell__mask {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        background: color(secondary);
        scale: 0 1;
        transform-origin: 0 50%;
        transition: scale 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }

      &:hover:not(.is-active) {
        .s__cell__mask {
          scale: 1 1;
        }
        .s__tab-code,
        .s__tab-name {
          color: color(primary);
        }
      }

      &.is-active {
