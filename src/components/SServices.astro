---

<section id="services" class="s-services" data-intersect>
  <div class="s__inner js-inner">
    <div class="s__services-wrapper">
      <!-- Top Pill Header (Matches SAbout exactly) -->
      <div class="s__services-header">
        <span class="s__services-header__tag">SERVICES &amp; PACKAGES</span>
      </div>

      <!-- 3-Options Bento Tab Row -->
      <div class="s__tabs-bar" role="tablist">
        {
          categories.map((cat, idx) => (
            <button
              class:list={['s__tab-cell js-service-tab', { 'is-active': idx === 0 }]}
              data-target={cat.id}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="s__tab-code">[{cat.code}]</span>
              <span class="s__tab-name">{cat.navTitle}</span>
              <span class="s__cell__mask"></span>
            </button>
          ))
        }
      </div>

      <!-- Bento Grid (Black & White, 1:1 Architecture with SAbout) -->
      <div class="s__bento-container">
        {
          categories.map((cat, idx) => {
            const tier1 = cat.tiers[0]
            const tier2 = cat.tiers[1]
            const tier3 = cat.tiers[2]

            return (
              <div
                class:list={['s__bento s__bento--service js-service-bento', { 'is-active': idx === 0 }]}
                id={`bento-${cat.id}`}
                data-category={cat.id}
              >
                <!-- Row 1: Motto & Category Role -->
                <div class="s__cell s__cell--full js-cell">
                  <div class="s__cell__content">
                    <h3 class="s__cell__serif">"{cat.title}"</h3>
                    <p class="s__cell__serif-sub">{cat.tagline}</p>
                  </div>
                  <span class="s__cell__mask"></span>
                </div>

                <!-- Revision & Collaboration Transparency Banner (Eye-catching & Approachable) -->
                {cat.revisionPolicy && (
                  <div class="s__cell s__cell--full s__cell--rev-policy js-cell">
                    <div class="s__cell__content s__rev-policy-card">
                      <div class="s__rev-policy-top">
                        <div class="s__rev-policy-tag-wrap">
                          <span class="s__rev-policy-tag">[ {cat.revisionPolicy.tag} ]</span>
                          <span class="s__rev-policy-live-indicator"><span class="s__rev-policy-pulse"></span>ACTIVE POLICY</span>
                        </div>
                        <span class="s__rev-policy-extra-badge">⚡ EXTRA ITERATIONS: ₹400 / ROUND</span>
                      </div>
                      <h4 class="s__rev-policy-title">{cat.revisionPolicy.title}</h4>
                      <p class="s__rev-policy-desc">{cat.revisionPolicy.description}</p>
                      <div class="s__rev-policy-grid">
                        {cat.revisionPolicy.tiers.map((t: any) => (
                          <div class:list={['s__rev-policy-item', { 'is-popular': t.isPopular, 'is-extra': t.isExtra }]}>
                            <div class="s__rev-policy-item-top">
                              <span class="s__rev-policy-code">[{t.code}]</span>
                              <span class="s__rev-policy-badge">{t.badge}</span>
                            </div>
                            <div class="s__rev-policy-item-center">
                              <span class="s__rev-policy-icon">{t.icon}</span>
                              <div class="s__rev-policy-info">
                                <span class="s__rev-policy-name">{t.name}</span>
                                <span class="s__rev-policy-count">{t.count}</span>
                              </div>
                            </div>
                            <div class="s__rev-policy-item-bottom">
                              <span class="s__rev-policy-dots">{t.dots}</span>
                              <span class="s__rev-policy-sub">{t.subtitle}</span>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                    <span class="s__cell__mask"></span>
                  </div>
                )}

                <!-- Category Visual Showcase Architecture -->
                {cat.id === 'web-dev' && (
                  <div class="s__cell s__cell--full s__cell--visual-showcase js-cell">
                    <div class="s__cell__content s__visual-box">
                      <div class="s__visual-header">
                        <div class="s__visual-header-left">
                          <span class="s__visual-tag">[ ARCHITECTURE & PERFORMANCE RADAR ]</span>
                          <span class="s__visual-status-pill"><span class="s__visual-pulse"></span>SUB-0.5s SPEED GUARANTEED</span>
                        </div>
                        <div class="s__visual-devices" role="tablist" aria-label="Device Viewport Switcher">
                          <button type="button" class="s__visual-device js-device-btn is-active" data-device="desktop" role="tab" aria-selected="true">
                            <span class="device-icon">🖥️</span> DESKTOP 1440px
                          </button>
                          <button type="button" class="s__visual-device js-device-btn" data-device="tablet" role="tab" aria-selected="false">
                            <span class="device-icon">💻</span> TABLET 768px
                          </button>
                          <button type="button" class="s__visual-device js-device-btn" data-device="mobile" role="tab" aria-selected="false">
                            <span class="device-icon">📱</span> MOBILE 390px
                          </button>
                        </div>
                      </div>

                      <div class="s__browser-mockup js-browser-mockup is-mode-desktop">
                        <!-- Mobile Dynamic Island Notch (visible on mobile view) -->
                        <div class="s__phone-notch">
                          <span class="s__phone-speaker"></span>
                          <span class="s__phone-cam"></span>
                        </div>

                        <div class="s__browser-bar">
                          <div class="s__browser-dots">
                            <span class="s__browser-dot s__browser-dot--red"></span>
                            <span class="s__browser-dot s__browser-dot--yellow"></span>
                            <span class="s__browser-dot s__browser-dot--green"></span>
                          </div>
                          <div class="s__browser-url">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                            <span class="s__url-text js-browser-url-text">https://clientbrand.com/production-live</span>
                            <span class="s__browser-viewport js-browser-viewport">1440 × 900</span>
                            <span class="s__browser-ssl">SSL 256-BIT</span>
                          </div>
                          <div class="s__browser-speed">
                            <span class="s__speed-num">0.42s</span>
                            <span class="s__speed-lbl">LCP SPEED</span>
                          </div>
                        </div>

                        <div class="s__browser-body">
                          <!-- Lighthouse Live Scores -->
                          <div class="s__lighthouse-strip">
                            <div class="s__lh-card">
                              <div class="s__lh-dial is-100"><span class="s__lh-val">100</span></div>
                              <span class="s__lh-label">PERFORMANCE</span>
                            </div>
                            <div class="s__lh-card">
                              <div class="s__lh-dial is-100"><span class="s__lh-val">100</span></div>
                              <span class="s__lh-label">ACCESSIBILITY</span>
                            </div>
                            <div class="s__lh-card">
                              <div class="s__lh-dial is-100"><span class="s__lh-val">100</span></div>
                              <span class="s__lh-label">BEST PRACTICES</span>
                            </div>
                            <div class="s__lh-card">
                              <div class="s__lh-dial is-100"><span class="s__lh-val">100</span></div>
                              <span class="s__lh-label">SEO SCORE</span>
                            </div>
                          </div>

                          <!-- High-Fidelity Website Clone Screen Preview -->
                          <div class="s__clone-stage">
                            <!-- Clone Header / Nav -->
                            <div class="s__clone-navbar">
                              <div class="s__clone-logo">
                                <span class="s__clone-logo-badge">✦</span>
                                <span class="s__clone-brand-text">BRINTA<span class="s__clone-brand-dot">.DEV</span></span>
                              </div>
                              <div class="s__clone-nav-links">
                                <span class="s__clone-nav-link">WORKS</span>
                                <span class="s__clone-nav-link">SERVICES</span>
