---
const categories = [
  {
    id: 'web-dev',
    code: '01',
    navTitle: 'WEB DEV',
    title: 'Web Development Packages',
    tagline: 'High-performance responsive websites, bespoke UI/UX, and 3D digital experiences.',
    tiers: [
      {
        name: 'Starter (Tier 1)',
        price: '₹15,000',
        period: '',
        isPopular: false,
        specs: [
          { label: 'Pages', value: 'Up to 3 Pages' },
          { label: 'Design', value: 'Template-based UI' },
          { label: 'Device', value: 'Mobile & Tablet Friendly' },
          { label: 'Stack', value: 'Contact, CMS & Basic SEO' },
          { label: 'Support', value: '1 Month Support' },
        ],
      },
      {
        name: 'Professional (Tier 2)',
        price: '₹35,000',
        period: '',
        isPopular: true,
        popularBadge: 'MOST POPULAR',
        specs: [
          { label: 'Pages', value: 'Up to 8 Pages' },
          { label: 'Design', value: 'Custom UI/UX & 3D Assets' },
          { label: 'Speed', value: 'Fully Responsive & Ultra Fast' },
          { label: 'Stack', value: 'Advanced CMS + SEO Suite' },
          { label: 'Support', value: '1 Mo + 3 Mo Maintenance' },
        ],
      },
      {
        name: 'Custom / E-Commerce (Tier 3)',
        price: '₹65,000+',
        period: '',
        isPopular: false,
        specs: [
          { label: 'Scale', value: 'Unlimited Dynamic Pages' },
          { label: 'Design', value: 'Bespoke UI/UX & 3D Shaders' },
          { label: 'Ecommerce', value: 'Payment Gateway + CMS' },
          { label: 'Support', value: '1 Mo + 6 Mo Priority Support' },
        ],
      },
    ],
  },
  {
    id: 'graphic-design',
    code: '02',
    navTitle: 'GRAPHIC DESIGN',
    title: 'Graphic Design Packages',
    tagline: 'Brand identity systems, 3D renderings, and high-engagement social media assets.',
    tiers: [
      {
        name: 'Essential Brand (Tier 1)',
        price: '₹8,000',
        period: '',
        isPopular: false,
        specs: [
          { label: 'Identity', value: '1 Logo Concept + Business Card' },
          { label: 'Socials', value: '3 Custom Post Templates' },
          { label: 'Revisions', value: '2 Rounds of Revisions' },
          { label: 'Files', value: 'High-Res PNG & JPG' },
          { label: 'Timeline', value: '3 - 5 Business Days' },
        ],
      },
      {
        name: 'Complete Identity (Tier 2)',
        price: '₹18,000',
        period: '',
        isPopular: true,
        popularBadge: 'RECOMMENDED',
        specs: [
          { label: 'Identity', value: '3 Logo Concepts + Guidelines' },
          { label: 'Socials', value: '10 Post Templates + Banners' },
          { label: 'Revisions', value: '5 Rounds + Unlimited Minor' },
          { label: 'Files', value: 'Vector AI, PSD & SVG' },
          { label: 'Timeline', value: '7 - 10 Business Days' },
        ],
      },
      {
        name: 'The 3D Suite (Tier 3)',
        price: '₹30,000',
        period: '',
        isPopular: false,
        specs: [
          { label: 'Identity', value: 'Full Brand Kit + 3D Logo' },
          { label: 'Socials', value: '20 Posts + Animated UI Assets' },
          { label: 'Revisions', value: 'Unlimited Revisions' },
          { label: 'Files', value: 'All Source Files + 3D Models' },
        ],
      },
    ],
  },
  {
    id: 'seo-management',
    code: '03',
    navTitle: 'SEO MANAGEMENT',
    title: 'SEO Management (Monthly)',
    tagline: 'Dominant search engine rankings, technical performance audits, and high-authority backlinks.',
    tiers: [
      {
        name: 'Local Boost (Tier 1)',
        price: '₹10,000',
        period: '/mo',
        isPopular: false,
        specs: [
          { label: 'Keywords', value: '5 - 15 Target Keywords' },
          { label: 'On-Page', value: 'Meta Tags & Speed Fixes' },
          { label: 'Backlinks', value: '10 High-Quality Backlinks' },
          { label: 'Content', value: '1 Blog Post / month' },
          { label: 'Report', value: 'Monthly Analytics Report' },
        ],
      },
      {
        name: 'Growth Engine (Tier 2)',
        price: '₹22,000',
        period: '/mo',
        isPopular: true,
        popularBadge: 'HIGH GROWTH',
        specs: [
          { label: 'Keywords', value: '15 - 30 Target Keywords' },
          { label: 'Audits', value: 'Technical, Speed & Schema' },
          { label: 'Backlinks', value: '10 Backlinks + Guest Posts' },
          { label: 'Content', value: '3 Blog Posts / month' },
          { label: 'Strategy', value: 'Bi-Weekly Strategy Calls' },
        ],
      },
      {
        name: 'Market Dominance (Tier 3)',
        price: '₹45,000',
        period: '/mo',
        isPopular: false,
        specs: [
          { label: 'Keywords', value: '30+ High-Intent Keywords' },
          { label: 'Audits', value: 'Full Tech, UI/UX & Schema' },
          { label: 'Backlinks', value: '30 High-Authority Backlinks' },
          { label: 'Content', value: '3+ Blogs + Content Suite' },
          { label: 'Dashboard', value: 'Real-time Dashboard & Calls' },
        ],
      },
    ],
