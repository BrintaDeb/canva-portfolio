          `📝 *Requirements / Notes:* ${notes}`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `🧾 *Paid ₹100 UPI UTR / Ref:* ${utr}`,
          `_(50% refundable if not proceeding / 100% credited against invoice)_`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Sent directly from Brinta Deb Portfolio Quotation System`,
        ].filter(Boolean)

        // Obfuscated WhatsApp destination to prevent scraping
        const _waTarget = atob('OTE3MDA1NTgxNDUz')
        const targetUrl = `https://wa.me/${_waTarget}?text=${encodeURIComponent(waLines.join('\n'))}`
        window.open(targetUrl, '_blank', 'noopener,noreferrer')
        this.closeModal()
      } else {
        const mailLines = [
          `QUOTATION REQUEST — BRINTA DEB PORTFOLIO`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Service Package: ${pkg}`,
          `Selected Tier: ${tier}`,
          `Estimated Rate: ${price}`,
          `Client Name / Brand: ${clientName}`,
          phone ? `Client WhatsApp: ${phone}` : '',
          `Target Timeline: ${timeline}`,
          `Requirements / Notes: ${notes}`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Verified ₹100 UPI UTR / Transaction Reference: ${utr}`,
          `(50% refundable if not proceeding / 100% credited against invoice)`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Sent directly from Brinta Deb Portfolio Quotation System`,
        ].filter(Boolean)

        const subject = encodeURIComponent(`Quotation Request [PAID UPI REF: ${utr}]: ${pkg} - ${tier} (${clientName})`)
        const body = encodeURIComponent(mailLines.join('\n'))
        window.location.href = `mailto:brintadeb15@gmail.com?subject=${subject}&body=${body}`
        this.closeModal()
      }
    }

    validateAndSendCustomQuote(channel: 'whatsapp' | 'email') {
      const clientInput = document.getElementById('quoteClientName') as HTMLInputElement | null
      const catSelect = document.getElementById('quoteCategory') as HTMLSelectElement | null
      const phoneInput = document.getElementById('quotePhone') as HTMLInputElement | null
      const budgetInput = document.getElementById('quoteBudget') as HTMLInputElement | null
      const reqInput = document.getElementById('quoteRequirements') as HTMLTextAreaElement | null
      const utrInput = document.getElementById('quoteUtr') as HTMLInputElement | null
      const utrErr = document.getElementById('quoteUtrError') as HTMLElement | null

      const clientName = clientInput?.value.trim() || ''
      const category = catSelect?.value || 'Custom Scope'
      const phone = phoneInput?.value.trim() || ''
      const budget = budgetInput?.value.trim() || 'To be discussed'
      const requirements = reqInput?.value.trim() || ''
      const utr = utrInput?.value.trim() || ''

      if (!clientName) {
