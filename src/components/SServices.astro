          </div>

          <div class="form-group">
            <label for="modalTimeline">TARGET LAUNCH TIMELINE</label>
            <input
              type="text"
              id="modalTimeline"
              placeholder="e.g. Within 2-3 weeks / ASAP"
            />
          </div>

          <div class="form-group">
            <label for="modalNotes">SPECIFIC REQUIREMENTS OR NOTES</label>
            <textarea
              id="modalNotes"
              rows="2"
              placeholder="Any specific features, design preferences, or reference links..."
            ></textarea>
          </div>

          <!-- Mandatory UTR Field -->
          <div class="form-group form-group--utr">
            <label for="modalUtr">
              <span>UPI TRANSACTION REFERENCE / 12-DIGIT UTR *</span>
              <span class="field-hint">Required to verify ₹100 reservation fee</span>
            </label>
            <input
              type="text"
              id="modalUtr"
              class="js-modal-utr"
              placeholder="e.g. 423589123456 or PhonePe Transaction ID"
              required
            />
            <div id="modalUtrError" class="modal-utr-error" style="display: none;">
              ⚠️ Upfront ₹100 fee verification required. Please transfer via UPI and enter your 12-digit UTR to send this quotation.
            </div>
          </div>

          <!-- Dual Dispatch Action Buttons -->
          <div class="modal-actions-row">
            <button type="button" class="modal-action-btn modal-action-btn--wa js-send-quote-wa">
              <span class="btn-icon">💬</span>
              <span>SEND ON WHATSAPP</span>
              <span class="btn-arrow">↗</span>
            </button>
            <button type="button" class="modal-action-btn modal-action-btn--mail js-send-quote-mail">
              <span class="btn-icon">✉️</span>
              <span>SEND ON EMAIL</span>
              <span class="btn-arrow">↗</span>
            </button>
          </div>

          <div class="modal-fee-guarantee">
            <span>🔒 ₹100 Upfront Fee • 50% Refundable if not proceeding • 100% credited against project bill.</span>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Interactive Subtle Smiley Canvas Overlay -->
  <canvas class="s__canvas js-services-canvas"></canvas>
</section>

<script>
  import Emitter from '../utils/Emitter'
  import gsap from 'gsap'
  import { audioEngine } from '../utils/AudioEngine.js'

  class ServicesBento {
    el: HTMLElement | null
    tabButtons: NodeListOf<HTMLElement>
    bentoViews: NodeListOf<HTMLElement>
    cells: NodeListOf<HTMLElement>
    canvas: HTMLCanvasElement | null
    ctx: CanvasRenderingContext2D | null

    quoteModal: HTMLElement | null
    modalPackageName: HTMLElement | null
    modalTierName: HTMLElement | null
    modalTierPrice: HTMLElement | null
    modalTierRevisions: HTMLElement | null
    tierQuoteForm: HTMLFormElement | null
    customQuoteForm: HTMLFormElement | null

    activeTierData: {
      package: string
      tier: string
      price: string
      specs: string
      revisions: string
    }

    smileyImages: {
      main: HTMLImageElement
      contrasted: HTMLImageElement
    } | null

    smileys: any[]
    lastThrow: number
    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    isPaused: boolean

    constructor() {
      this.el = document.getElementById('services')
      if (!this.el) return

      this.tabButtons = this.el.querySelectorAll('.js-service-tab')
      this.bentoViews = this.el.querySelectorAll('.js-service-bento')
      this.cells = this.el.querySelectorAll('.js-cell, .js-service-tab')
      this.canvas = this.el.querySelector('.js-services-canvas')
      this.ctx = this.canvas?.getContext('2d') || null

      this.quoteModal = document.getElementById('serviceQuoteModal')
      if (this.quoteModal && this.quoteModal.parentElement !== document.body) {
        document.body.appendChild(this.quoteModal)
      }
      this.modalPackageName = document.getElementById('modalPackageName')
      this.modalTierName = document.getElementById('modalTierName')
      this.modalTierPrice = document.getElementById('modalTierPrice')
      this.modalTierRevisions = document.getElementById('modalTierRevisions')
      this.tierQuoteForm = document.getElementById('tierQuoteForm') as HTMLFormElement
      this.customQuoteForm = document.getElementById('customQuoteForm') as HTMLFormElement

      this.activeTierData = {
        package: '',
        tier: '',
        price: '',
        specs: '',
        revisions: '',
      }

      this.smileys = []
      this.lastThrow = 0
      this.smileyImages = null
      this.isPaused = true

      this.bounding = {
        left: 0,
        top: 0,
        width: 0,
        height: 0,
      }

      this.initTabs()
      this.initDeviceSwitcher()
      this.initSmileyEngine()
      this.initQuotationSystem()
      this.initScopeEstimator()
    }

    initDeviceSwitcher() {
      const deviceBtns = this.el?.querySelectorAll('.js-device-btn')
      const mockup = this.el?.querySelector('.js-browser-mockup')
      const urlText = this.el?.querySelector('.js-browser-url-text')
      const viewportText = this.el?.querySelector('.js-browser-viewport')

      if (!deviceBtns || !mockup) return

      const deviceData: Record<string, { url: string; viewport: string }> = {
        desktop: {
          url: 'https://clientbrand.com/production-live',
          viewport: '1440 × 900',
        },
        tablet: {
          url: 'https://clientbrand.com/tablet-responsive',
          viewport: '768 × 1024',
        },
        mobile: {
          url: 'https://clientbrand.com/mobile-pwa',
          viewport: '390 × 844',
        },
      }

      deviceBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault()
          const device = btn.getAttribute('data-device') || 'desktop'

          deviceBtns.forEach((b) => {
            const isActive = b === btn
            b.classList.toggle('is-active', isActive)
            b.setAttribute('aria-selected', isActive ? 'true' : 'false')
          })

          mockup.classList.remove('is-mode-desktop', 'is-mode-tablet', 'is-mode-mobile')
          mockup.classList.add(`is-mode-${device}`)

          const info = deviceData[device] || deviceData.desktop
          if (urlText) urlText.textContent = info.url
          if (viewportText) viewportText.textContent = info.viewport

          try {
            audioEngine?.play?.('click')
          } catch (_) {}
        })
      })

      // Interactive click feedback on clone CTA button
      const cloneCta = this.el?.querySelector('.js-clone-cta') as HTMLButtonElement | null
      if (cloneCta) {
        cloneCta.addEventListener('click', (e) => {
          e.preventDefault()
          cloneCta.style.transform = 'scale(0.95)'
          setTimeout(() => {
            cloneCta.style.transform = ''
          }, 150)
          const starterTrigger = this.el?.querySelector('.js-open-quote') as HTMLElement | null
          starterTrigger?.click()
        })
      }
    }

    initTabs() {
      this.tabButtons.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target')

          this.tabButtons.forEach((t) => {
            const active = t === tab
            t.classList.toggle('is-active', active)
            t.setAttribute('aria-selected', active ? 'true' : 'false')
          })

          this.bentoViews.forEach((v) => {
            const cat = v.getAttribute('data-category')
            if (cat === target) {
              v.style.display = 'flex'
              gsap.fromTo(
                v,
                { opacity: 0, y: 10 },
                { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }
              )
            } else {
              v.style.display = 'none'
            }
          })
        })
      })
    }

    initQuotationSystem() {
      // Tier Cell Clicks -> Open Full Quotation Modal
      const quoteTriggers = this.el?.querySelectorAll('.js-open-quote')
      quoteTriggers?.forEach((trigger) => {
        const handleOpen = (e: Event) => {
          e.preventDefault()
          const pkg = trigger.getAttribute('data-package') || ''
          const tier = trigger.getAttribute('data-tier') || ''
          const price = trigger.getAttribute('data-price') || ''
          const specs = trigger.getAttribute('data-specs') || ''
          const revisions = trigger.getAttribute('data-revisions') || ''

          this.activeTierData = { package: pkg, tier, price, specs, revisions }

          if (this.modalPackageName) this.modalPackageName.textContent = pkg
          if (this.modalTierName) this.modalTierName.textContent = tier
          if (this.modalTierPrice) this.modalTierPrice.textContent = price
          if (this.modalTierRevisions) {
            this.modalTierRevisions.textContent = revisions || 'Standard revisions included'
          }

          // Pre-fill UTR if stored in session
          const savedUtr = sessionStorage.getItem('call_payment_utr')
          const modalUtr = document.getElementById('modalUtr') as HTMLInputElement | null
          if (modalUtr && savedUtr && !modalUtr.value) {
            modalUtr.value = savedUtr
          }
          const utrError = document.getElementById('modalUtrError')
          if (utrError) utrError.style.display = 'none'

          this.quoteModal?.classList.remove('hidden')
          document.body.style.overflow = 'hidden'

          setTimeout(() => {
            const clientInput = document.getElementById('modalClientName') as HTMLInputElement
            clientInput?.focus()
          }, 150)
        }

        trigger.addEventListener('click', handleOpen)
        trigger.addEventListener('keydown', (e: any) => {
          if (e.key === 'Enter' || e.key === ' ') {
            handleOpen(e)
          }
        })
      })

      // Close modal handlers
      this.quoteModal?.querySelectorAll('.js-close-modal').forEach((btn) => {
        btn.addEventListener('click', () => this.closeModal())
      })

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !this.quoteModal?.classList.contains('hidden')) {
          this.closeModal()
        }
      })

      // Copy UPI ID functionality for both Modal and In-Page Estimator
      const bindCopyUpi = (btnSelector: string, labelSelector: string) => {
        const btn = document.querySelector(btnSelector)
        const label = document.querySelector(labelSelector)
        if (!btn) return
        btn.addEventListener('click', async () => {
          const upiId = 'brintadeb1453@nyes'
          try { audioEngine?.playTone?.(750, 0.08) } catch (e) {}

          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(upiId)
            } else {
              const temp = document.createElement('textarea')
              temp.value = upiId
              document.body.appendChild(temp)
              temp.select()
              document.execCommand('copy')
              document.body.removeChild(temp)
            }
            if (label) {
              const orig = label.textContent
              label.textContent = '✓ COPIED'
              btn.classList.add('is-copied')
              setTimeout(() => {
                if (label) label.textContent = orig
                btn.classList.remove('is-copied')
              }, 2500)
            }
          } catch {
            if (label) label.textContent = 'COPIED'
          }
        })
      }

      bindCopyUpi('.js-modal-copy-upi', '.js-modal-copy-label')
      bindCopyUpi('.js-custom-copy-upi', '.js-custom-copy-label')

      // Pre-fill Custom Quote UTR if available in sessionStorage
      const savedSessionUtr = sessionStorage.getItem('call_payment_utr')
      const quoteUtrInput = document.getElementById('quoteUtr') as HTMLInputElement | null
      if (quoteUtrInput && savedSessionUtr && !quoteUtrInput.value) {
        quoteUtrInput.value = savedSessionUtr
      }

      // Input listener to auto-clear error banners when user types valid UTR
      const modalUtrInput = document.getElementById('modalUtr') as HTMLInputElement | null
      const modalUtrErr = document.getElementById('modalUtrError') as HTMLElement | null
      modalUtrInput?.addEventListener('input', () => {
        if (modalUtrInput.value.trim().length >= 6) {
          modalUtrInput.classList.remove('has-error')
          if (modalUtrErr) modalUtrErr.style.display = 'none'
        }
      })

      const customUtrInput = document.getElementById('quoteUtr') as HTMLInputElement | null
      const customUtrErr = document.getElementById('quoteUtrError') as HTMLElement | null
      customUtrInput?.addEventListener('input', () => {
        if (customUtrInput.value.trim().length >= 6) {
          customUtrInput.classList.remove('has-error')
          if (customUtrErr) customUtrErr.style.display = 'none'
        }
      })

      // Action Button Listeners for Modal Quotation
      this.quoteModal?.querySelector('.js-send-quote-wa')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendTierQuote('whatsapp')
      })
      this.quoteModal?.querySelector('.js-send-quote-mail')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendTierQuote('email')
      })
      this.tierQuoteForm?.addEventListener('submit', (e) => {
        e.preventDefault()
        this.validateAndSendTierQuote('whatsapp')
      })

      // Action Button Listeners for In-Page Custom Scope Form
      this.el?.querySelector('.js-custom-send-wa')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendCustomQuote('whatsapp')
      })
      this.el?.querySelector('.js-custom-send-mail')?.addEventListener('click', (e) => {
        e.preventDefault()
        this.validateAndSendCustomQuote('email')
      })
      this.customQuoteForm?.addEventListener('submit', (e) => {
        e.preventDefault()
        this.validateAndSendCustomQuote('whatsapp')
      })
    }

    closeModal() {
      this.quoteModal?.classList.add('hidden')
      document.body.style.overflow = ''
      const utrErr = document.getElementById('modalUtrError')
      if (utrErr) utrErr.style.display = 'none'
      const modalUtr = document.getElementById('modalUtr') as HTMLInputElement | null
      modalUtr?.classList.remove('has-error')
    }

    validateAndSendTierQuote(channel: 'whatsapp' | 'email') {
      const clientInput = document.getElementById('modalClientName') as HTMLInputElement | null
      const phoneInput = document.getElementById('modalPhone') as HTMLInputElement | null
      const timelineInput = document.getElementById('modalTimeline') as HTMLInputElement | null
      const notesInput = document.getElementById('modalNotes') as HTMLTextAreaElement | null
      const utrInput = document.getElementById('modalUtr') as HTMLInputElement | null
      const utrErr = document.getElementById('modalUtrError') as HTMLElement | null

      const clientName = clientInput?.value.trim() || ''
      const phone = phoneInput?.value.trim() || ''
      const timeline = timelineInput?.value.trim() || 'Flexible / ASAP'
      const notes = notesInput?.value.trim() || 'Standard package deliverables.'
      const utr = utrInput?.value.trim() || ''

      if (!clientName) {
        clientInput?.focus()
        clientInput?.classList.add('has-error')
        setTimeout(() => clientInput?.classList.remove('has-error'), 2000)
        return
      }

      // STRICT VALIDATION: Upfront ₹100 reservation UTR is required
      if (!utr || utr.length < 6) {
        if (utrErr) utrErr.style.display = 'block'
        utrInput?.focus()
        utrInput?.classList.add('has-error')
        try { audioEngine?.playError?.() } catch (e) {}
        return
      }

      if (utrErr) utrErr.style.display = 'none'
      utrInput?.classList.remove('has-error')

      // Save verified UTR in session so user doesn't have to re-enter
      sessionStorage.setItem('call_payment_utr', utr)
      const customUtr = document.getElementById('quoteUtr') as HTMLInputElement | null
      if (customUtr && !customUtr.value) customUtr.value = utr

      try { audioEngine?.playSuccess?.() } catch (e) {}

      const pkg = this.activeTierData.package || 'Custom Web & Creative Service'
      const tier = this.activeTierData.tier || 'Selected Tier'
      const price = this.activeTierData.price || 'Market Rate'

      if (channel === 'whatsapp') {
        const waLines = [
          `*QUOTATION REQUEST // BRINTA DEB PORTFOLIO*`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `📦 *Package:* ${pkg}`,
          `⭐ *Selected Tier:* ${tier}`,
          `💰 *Estimated Rate:* ${price}`,
          this.activeTierData.revisions ? `🔄 *Revision Allocation:* ${this.activeTierData.revisions}` : '',
          `👤 *Client / Brand:* ${clientName}`,
          phone ? `📱 *Client WhatsApp:* ${phone}` : '',
          `⏱️ *Target Timeline:* ${timeline}`,
          `📝 *Requirements / Notes:* ${notes}`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `🧾 *Paid ₹100 UPI UTR / Ref:* ${utr}`,
          `_(50% refundable if not proceeding / 100% credited against invoice)_`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Sent directly from Brinta Deb Portfolio Quotation System`,
        ].filter(Boolean)

        // Obfuscated WhatsApp destination to prevent scraping
        const _waTarget = atob('OTE3MDA1NTgxNDUz')
        const targetUrl = `https://wa.me/${_waTarget}?text=${encodeURIComponent(waLines.join('\n'))}`
        window.open(targetUrl, '_blank', 'noopener,noreferrer')
        this.closeModal()
      } else {
        const mailLines = [
          `QUOTATION REQUEST — BRINTA DEB PORTFOLIO`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Service Package: ${pkg}`,
          `Selected Tier: ${tier}`,
          `Estimated Rate: ${price}`,
          this.activeTierData.revisions ? `Revision Allocation: ${this.activeTierData.revisions}` : '',
          `Client Name / Brand: ${clientName}`,
          phone ? `Client WhatsApp: ${phone}` : '',
          `Target Timeline: ${timeline}`,
          `Requirements / Notes: ${notes}`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Verified ₹100 UPI UTR / Transaction Reference: ${utr}`,
          `(50% refundable if not proceeding / 100% credited against invoice)`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Sent directly from Brinta Deb Portfolio Quotation System`,
        ].filter(Boolean)

        const subject = encodeURIComponent(`Quotation Request [PAID UPI REF: ${utr}]: ${pkg} - ${tier} (${clientName})`)
        const body = encodeURIComponent(mailLines.join('\n'))
        window.location.href = `mailto:brintadeb15@gmail.com?subject=${subject}&body=${body}`
        this.closeModal()
      }
    }

    validateAndSendCustomQuote(channel: 'whatsapp' | 'email') {
      const clientInput = document.getElementById('quoteClientName') as HTMLInputElement | null
      const catSelect = document.getElementById('quoteCategory') as HTMLSelectElement | null
      const phoneInput = document.getElementById('quotePhone') as HTMLInputElement | null
      const budgetInput = document.getElementById('quoteBudget') as HTMLInputElement | null
      const reqInput = document.getElementById('quoteRequirements') as HTMLTextAreaElement | null
      const utrInput = document.getElementById('quoteUtr') as HTMLInputElement | null
      const utrErr = document.getElementById('quoteUtrError') as HTMLElement | null

      const clientName = clientInput?.value.trim() || ''
      const category = catSelect?.value || 'Custom Scope'
      const phone = phoneInput?.value.trim() || ''
      const budget = budgetInput?.value.trim() || 'To be discussed'
      const requirements = reqInput?.value.trim() || ''
      const utr = utrInput?.value.trim() || ''

      if (!clientName) {
        clientInput?.focus()
        clientInput?.classList.add('has-error')
        setTimeout(() => clientInput?.classList.remove('has-error'), 2000)
        return
      }

      if (!requirements) {
        reqInput?.focus()
        reqInput?.classList.add('has-error')
        setTimeout(() => reqInput?.classList.remove('has-error'), 2000)
        return
      }

      // STRICT VALIDATION: Upfront ₹100 reservation UTR is required
      if (!utr || utr.length < 6) {
        if (utrErr) utrErr.style.display = 'block'
        utrInput?.focus()
        utrInput?.classList.add('has-error')
        try { audioEngine?.playError?.() } catch (e) {}
        return
      }

      if (utrErr) utrErr.style.display = 'none'
      utrInput?.classList.remove('has-error')

      // Save verified UTR in session
      sessionStorage.setItem('call_payment_utr', utr)
      const modalUtr = document.getElementById('modalUtr') as HTMLInputElement | null
      if (modalUtr && !modalUtr.value) modalUtr.value = utr

      try { audioEngine?.playSuccess?.() } catch (e) {}

      const selectedChips = Array.from(this.el?.querySelectorAll<HTMLLabelElement>('.js-scope-chip') || [])
      const selectedModules = selectedChips
        .filter((chip) => chip.querySelector<HTMLInputElement>('.scope-checkbox')?.checked)
        .map((chip) => `• ${chip.getAttribute('data-module') || ''} (+${chip.getAttribute('data-days')}d)`)

      const modulesSection = selectedModules.length > 0
        ? `Selected Scope Deliverables:\n${selectedModules.join('\n')}`
        : ''

      if (channel === 'whatsapp') {
        const waModulesSection = selectedModules.length > 0
          ? `🧩 *Selected Scope Deliverables:*\n${selectedModules.join('\n')}\n`
          : ''

        const waLines = [
          `*CUSTOM SCOPE QUOTATION // BRINTA DEB*`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `👤 *Client / Brand:* ${clientName}`,
          `🛠️ *Primary Service:* ${category}`,
          phone ? `📱 *Client WhatsApp:* ${phone}` : '',
          `💰 *Estimated Budget & Timeline:* ${budget}`,
          waModulesSection,
          `📝 *Project Details:* ${requirements}`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `🧾 *Paid ₹100 UPI UTR / Ref:* ${utr}`,
          `_(50% refundable if not proceeding / 100% credited against invoice)_`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Sent directly from Brinta Deb Portfolio Scope Estimator`,
        ].filter(Boolean)

        const _waTarget = atob('OTE3MDA1NTgxNDUz')
        const targetUrl = `https://wa.me/${_waTarget}?text=${encodeURIComponent(waLines.join('\n'))}`
        window.open(targetUrl, '_blank', 'noopener,noreferrer')
      } else {
        const mailLines = [
          `CUSTOM PROJECT QUOTATION — BRINTA DEB`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Client Name / Brand: ${clientName}`,
          `Requested Service: ${category}`,
          phone ? `Client WhatsApp: ${phone}` : '',
          `Estimated Investment & Timeline: ${budget}`,
          modulesSection,
          `Requirements & Scope: ${requirements}`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Verified ₹100 UPI UTR / Transaction Reference: ${utr}`,
          `(50% refundable if not proceeding / 100% credited against invoice)`,
          `━━━━━━━━━━━━━━━━━━━━━`,
          `Sent directly from Brinta Deb Portfolio Scope Estimator`,
        ].filter(Boolean)

        const subject = encodeURIComponent(`Custom Scope Quotation [PAID UPI REF: ${utr}]: ${category} - ${clientName}`)
        const body = encodeURIComponent(mailLines.join('\n'))
        window.location.href = `mailto:brintadeb15@gmail.com?subject=${subject}&body=${body}`
      }
    }

    initScopeEstimator() {
      const scopeChips = this.el?.querySelectorAll<HTMLLabelElement>('.js-scope-chip')
      const daysEl = document.getElementById('estimatorDays')
      const bracketEl = document.getElementById('estimatorBracket')
      const countEl = document.getElementById('estimatorCount')
      const budgetInput = document.getElementById('quoteBudget') as HTMLInputElement | null
      const reqTextarea = document.getElementById('quoteRequirements') as HTMLTextAreaElement | null

      if (!scopeChips || scopeChips.length === 0) return

      let hasUserEditedRequirements = false
      reqTextarea?.addEventListener('input', () => {
        hasUserEditedRequirements = true
      })

      const updateCalculations = () => {
        let totalDays = 0
        let totalCost = 0
        const selectedModules: string[] = []

        scopeChips.forEach((chip) => {
          const checkbox = chip.querySelector<HTMLInputElement>('.scope-checkbox')
          const isChecked = !!checkbox?.checked
          chip.classList.toggle('is-selected', isChecked)

          if (isChecked) {
            const days = parseInt(chip.getAttribute('data-days') || '2', 10)
            const cost = parseInt(chip.getAttribute('data-cost') || '10000', 10)
            const moduleName = chip.getAttribute('data-module') || checkbox?.value || ''

            totalDays += days
            totalCost += cost
            selectedModules.push(moduleName)
          }
        })

        const count = selectedModules.length
        let minDays = totalDays
        let maxDays = Math.ceil(totalDays * 1.3) + 2

        let timelineText = ''
        let bracketText = ''

        if (count === 0) {
          timelineText = '3 - 5 Business Days (Fast Sprint)'
          bracketText = 'Discovery / Advisory Tier (~₹8,000)'
          minDays = 3
          maxDays = 5
        } else if (totalCost <= 20000) {
          timelineText = `${minDays} - ${maxDays} Business Days`
          bracketText = `Starter Sprint Tier (~₹${totalCost.toLocaleString('en-IN')})`
        } else if (totalCost <= 35000) {
          timelineText = `${minDays} - ${maxDays} Business Days`
          bracketText = `Professional Growth Tier (~₹${totalCost.toLocaleString('en-IN')})`
        } else {
          timelineText = `${minDays} - ${maxDays} Business Days`
          bracketText = `Fullscale Enterprise Tier (~₹${totalCost.toLocaleString('en-IN')})`
        }

        if (daysEl) daysEl.textContent = timelineText
        if (bracketEl) bracketEl.textContent = bracketText
        if (countEl) countEl.textContent = `${count} Deliverable${count === 1 ? '' : 's'} Selected`

        if (budgetInput) {
          budgetInput.value = `~₹${(totalCost || 8000).toLocaleString('en-IN')} (${minDays}-${maxDays} Days)`
        }

        if (reqTextarea && !hasUserEditedRequirements) {
          if (selectedModules.length > 0) {
            reqTextarea.value = `Selected Scope: ${selectedModules.join('; ')}`
          } else {
            reqTextarea.value = ''
          }
        }
      }

      scopeChips.forEach((chip) => {
        const checkbox = chip.querySelector<HTMLInputElement>('.scope-checkbox')
        checkbox?.addEventListener('change', () => {
          updateCalculations()
        })
      })

      // Initial run to sync default checked values
      updateCalculations()
    }

    initSmileyEngine() {
      const mainImg = new Image(100, 100)
      mainImg.src = '/images/asset-smiley--main.svg'

      const contrastedImg = new Image(100, 100)
      contrastedImg.src = '/images/asset-smiley--contrasted.svg'

      this.smileyImages = {
        main: mainImg,
        contrasted: contrastedImg,
      }

      this.setSize()
      Emitter.on('resize', () => this.setSize(), this)

      this.cells.forEach((cell) => {
        const onHover = () => this.throwSubtleSmiley(cell)
        cell.addEventListener('mouseenter', onHover, { passive: true })
        cell.addEventListener('touchstart', onHover, { passive: true })
      })

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            this.isPaused = !entry.isIntersecting
            if (!this.isPaused) {
              Emitter.on('tick', this.tick, this)
            } else {
              Emitter.off('tick', this.tick, this)
            }
          })
        },
        { threshold: 0.1 }
      )
      if (this.el) observer.observe(this.el)
    }

    setSize() {
      if (!this.el || !this.canvas) return
      const rect = this.el.getBoundingClientRect()
      this.bounding = {
        left: rect.left,
        top: rect.top,
        width: this.el.clientWidth,
        height: this.el.clientHeight,
      }
      this.canvas.width = this.bounding.width
      this.canvas.height = this.bounding.height
    }

    throwSubtleSmiley(cell: HTMLElement) {
      const now = Date.now()
      if (now - this.lastThrow < 280) return
      this.lastThrow = now

      if (!this.el) return
      const cellRect = cell.getBoundingClientRect()
      const elRect = this.el.getBoundingClientRect()

      const count = Math.random() > 0.6 ? 2 : 1

      for (let i = 0; i < count; i++) {
        const size = Math.random() * 10 + 20
        const x = cellRect.left - elRect.left + Math.random() * cellRect.width
        const y = cellRect.top - elRect.top + Math.random() * (cellRect.height * 0.5)

        const velocity = {
          x: (Math.random() - 0.5) * 5,
          y: -Math.random() * 3.5 - 1.5,
        }

        this.smileys.push({
          x,
          y,
          size,
          velocity,
          gravity: 0.16,
          rotation: Math.random() * Math.PI * 2,
          rotationSpeed: (Math.random() - 0.5) * 0.12,
          opacity: 0.9,
        })
      }
    }

    updateSmileys() {
      if (!this.ctx || !this.smileyImages) return
      this.ctx.clearRect(0, 0, this.bounding.width, this.bounding.height)

      if (this.smileys.length === 0) return

      const isContrasted = document.documentElement.classList.contains('theme-contrasted')
      const img = isContrasted ? this.smileyImages.contrasted : this.smileyImages.main

      for (let i = this.smileys.length - 1; i >= 0; i--) {
        const s = this.smileys[i]
        s.x += s.velocity.x
        s.y += s.velocity.y
        s.velocity.y += s.gravity
        s.rotation += s.rotationSpeed
        s.opacity -= 0.014

        if (s.opacity <= 0) {
          this.smileys.splice(i, 1)
          continue
        }

        this.ctx.save()
        this.ctx.globalAlpha = Math.max(0, s.opacity)
        this.ctx.translate(s.x, s.y)
        this.ctx.rotate(s.rotation)
        this.ctx.drawImage(img, -s.size / 2, -s.size / 2, s.size, s.size)
        this.ctx.restore()
      }
    }

    tick() {
      if (this.smileys.length > 0) {
        this.updateSmileys()
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ServicesBento())
  } else {
    new ServicesBento()
  }
</script>

