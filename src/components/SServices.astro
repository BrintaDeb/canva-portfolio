<script>
  import gsap from 'gsap'

  class ServicesBento {
    container: HTMLElement | null
    tiltWrap: HTMLElement | null
    tabButtons: NodeListOf<HTMLElement>
    views: NodeListOf<HTMLElement>

    constructor() {
      this.container = document.getElementById('services')
      if (!this.container) return

      this.tiltWrap = this.container.querySelector('.js-tilt-container')
      this.tabButtons = this.container.querySelectorAll('.js-services-tab')
      this.views = this.container.querySelectorAll('.js-services-view')

      this.initTabs()
      this.initSmoothPhysics()
    }

    initTabs() {
      this.tabButtons.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target')

          this.tabButtons.forEach((t) => {
            const active = t === tab
            t.classList.toggle('is-active', active)
            t.setAttribute('aria-selected', active ? 'true' : 'false')
          })

          this.views.forEach((v) => {
            const cat = v.getAttribute('data-category')
            if (cat === target) {
              v.style.display = 'block'
              gsap.fromTo(
                v,
                { opacity: 0, y: 12 },
                { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }
              )
            } else {
              v.style.display = 'none'
            }
          })
        })
      })
    }

    initSmoothPhysics() {
      if (!this.tiltWrap) return
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      if (window.innerWidth < 1024) return

      let bounds: DOMRect
      let isHovered = false

      const onEnter = () => {
        bounds = this.tiltWrap!.getBoundingClientRect()
        isHovered = true
      }

      const onMove = (e: MouseEvent) => {
        if (!isHovered || !this.tiltWrap) return
        const xRel = (e.clientX - bounds.left) / bounds.width - 0.5
        const yRel = (e.clientY - bounds.top) / bounds.height - 0.5

        // Micro subtle tilt: 1.5 degrees max
        const rotX = -yRel * 1.8
        const rotY = xRel * 1.8

        gsap.to(this.tiltWrap, {
          rotationX: rotX,
          rotationY: rotY,
          transformPerspective: 1800,
          duration: 0.8,
          ease: 'power2.out',
          overwrite: 'auto',
        })
      }

      const onLeave = () => {
        isHovered = false
        if (!this.tiltWrap) return
        gsap.to(this.tiltWrap, {
          rotationX: 0,
          rotationY: 0,
          duration: 1.0,
          ease: 'power3.out',
          overwrite: 'auto',
        })
      }

      this.tiltWrap.addEventListener('mouseenter', onEnter)
      this.tiltWrap.addEventListener('mousemove', onMove)
      this.tiltWrap.addEventListener('mouseleave', onLeave)
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ServicesBento())
  } else {
    new ServicesBento()
  }
</script>

