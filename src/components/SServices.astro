<section id="services" class="s-services" data-intersect>
  <div class="s-services__inner js-services-inner">
    <!-- Top Pill Header (Identical to SAbout & SMyWay) -->
    <div class="s-services__pill-header">
      <span class="s-services__pill-tag">SERVICES &amp; PACKAGES</span>
    </div>

    <!-- 3-Options Bento Switcher Tab Bar -->
    <div class="s-services__tabs-row" role="tablist">
      {
        categories.map((cat, idx) => (
          <button
            class:list={['s-services__tab-cell js-services-tab', { 'is-active': idx === 0 }]}
            data-target={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span class="tab-code">[{cat.code}]</span>
            <span class="tab-title">{cat.navTitle}</span>
            <span class="tab-mask"></span>
          </button>
        ))
      }
    </div>

    <!-- Bento Grid Container -->
    <div class="s-services__bento-wrap js-tilt-container">
      {
        categories.map((cat, idx) => (
          <div
            class:list={['s-services__bento-view js-services-view', { 'is-active': idx === 0 }]}
            id={`services-${cat.id}`}
            data-category={cat.id}
          >
            <!-- Category Banner Cell -->
            <div class="s-services__cell s-services__cell--banner">
              <div class="banner-left">
                <h3 class="banner-title">
                  {cat.title}
                  {cat.subheading && <span class="banner-subheading">{cat.subheading}</span>}
                </h3>
                <p class="banner-tagline">{cat.tagline}</p>
              </div>
              <div class="banner-right">
                <span class="banner-badge">(CONTRACT &amp; FREELANCE)</span>
              </div>
            </div>

            <!-- 3-Tier Grid Row -->
            <div class="s-services__row--tiers">
              {cat.tiers.map((tier) => (
                <div class:list={['s-services__cell s-services__cell--tier js-tier-cell', { 'is-popular': tier.isPopular }]}>
                  {tier.isPopular && (
                    <div class="tier-popular-ribbon">
                      <span class="ribbon-text">{tier.popularBadge}</span>
                    </div>
                  )}

                  <div class="tier-cell-inner">
                    <div class="tier-cell-top">
                      <div class="tier-header-line">
                        <span class="tier-badge">[{tier.tier}]</span>
                        <h4 class="tier-title">{tier.name}</h4>
                      </div>

                      <div class="tier-price-box">
                        <span class="tier-price-num">{tier.price}</span>
                        {tier.period && <span class="tier-price-period">{tier.period}</span>}
                      </div>
                    </div>

                    <div class="tier-specs-list">
                      {tier.specs.map((spec) => (
                        <div class="spec-row">
                          <span class="spec-label">({spec.label})</span>
                          <span class="spec-val">{spec.value}</span>
                        </div>
                      ))}
                    </div>

                    <div class="tier-action-wrap">
                      <a
                        href={`https://wa.me/917005581453?text=${encodeURIComponent(`Hi Brinta, I would like to request a quotation for: ${cat.title} - ${tier.name} (${tier.tier}) at ${tier.price}${tier.period}.`)}`}
                        target="_blank"
                        rel="noopener"
                        class="tier-quote-btn"
                        title={`Request Quotation for ${tier.name}`}
                      >
                        <span class="btn-text">REQUEST QUOTATION</span>
                        <span class="btn-arrow">→</span>
                        <span class="btn-hover-mask"></span>
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div><!-- .s-services__row--tiers -->
          </div><!-- .s-services__bento-view -->
        ))
      }

      <!-- Bottom Bespoke Row (Matches SAbout .s__cell--full) -->
      <div class="s-services__cell s-services__cell--custom">
        <div class="custom-content">
          <div class="custom-meta">
            <span class="custom-tag">[ BESPOKE / HYBRID SCOPE ]</span>
