---

<section id="work" class="s-work" data-intersect>
  <div class="s__outer">
    <div class="s__stage js-stage">
      <div class="s__inner js-container">
        <h2 class="s__title">
          <span class="s__title__inner js-title">
            <span class="s__title__letter js-letter">W</span>
            <span class="s__title__letter js-letter">O</span>
            <span class="s__title__letter js-letter">R</span>
            <span class="s__title__letter js-letter">K</span>
          </span>
        </h2>

        <div class="s__scene js-scene">
          {
            worksList.map((work, index) => (
              <AWork
                cssClass="s__scene__work s__scene__work--card js-work"
                caption={work.caption}
                tag={work.tag}
                site={work.site}
                src={work.src}
                modalSrc={work.modalSrc}
                poster={work.poster}
                type={work.type}
                stack={work.stack}
                impact={work.impact}
                isLive={work.isLive}
                badge={work.badge}
                index={String(index + 1).padStart(4, '0')}
                total={String(worksList.length).padStart(2, '0')}
              />
            ))
          }
        </div><!-- .s__scene -->

        <canvas class="s__canvas js-canvas"></canvas>
      </div><!-- .s__inner -->

      <div class="s__mask js-mask">
        <svg class="s__mask__svg js-mask-svg">
          <defs>
            <clipPath id="workMaskLinesClip" clipPathUnits="userSpaceOnUse">
              <path class="js-lines-clip" clip-rule="evenodd" fill-rule="evenodd" d=""></path>
            </clipPath>
          </defs>
          <path class="s__mask__path-outer js-mask-path-outer" fill-rule="evenodd" d=""></path>
          <path class="s__mask__path-lines js-mask-path-lines" clip-path="url(#workMaskLinesClip)" d=""></path>
        </svg>
      </div><!-- .s__mask -->

      <div class="s__ruler js-ruler"></div>
    </div><!-- .s__stage -->
  </div><!-- .s__outer -->
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'

  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  class Section {
    el: HTMLElement
    stage: HTMLElement
    container: HTMLElement
    ruler: HTMLElement
    scene: HTMLElement
    canvas: HTMLCanvasElement
    ctx: CanvasRenderingContext2D | null
    title: HTMLElement
    videos: NodeListOf<HTMLVideoElement>

    mask: {
      width: number
      height: number
      maxScale: number
      lines: any[]
      el: HTMLElement
      svg: HTMLElement
      pathOuter: SVGPathElement
      pathLines: SVGPathElement
    }

    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    letters: any[]
    works: any[]
    points: any[]

    tl: gsap.core.Timeline | null
    animationProgress: number
    pointsProgress: number
    last: {
      animationProgress: number
      pointsProgress: number
    }
    scrollProgress: number
    smoothScrollProgress: number
    state: number
    speed: number
    isPaused: boolean
    loadIsStarted: boolean

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-work') as HTMLElement
      this.stage = this.el?.querySelector('.js-stage') as HTMLElement
      this.container = this.el?.querySelector('.js-container') as HTMLElement
      this.ruler = this.el?.querySelector('.js-ruler') as HTMLElement
      this.scene = this.container?.querySelector('.js-scene') as HTMLElement
      this.canvas = this.container?.querySelector('.js-canvas') as HTMLCanvasElement
      this.ctx = this.canvas?.getContext('2d')
      this.title = this.container?.querySelector('.js-title') as HTMLElement
      this.videos = this.container?.querySelectorAll('video') as NodeListOf<HTMLVideoElement>

      // Properties
      this.mask = {
        width: 0,
        height: 0,
        maxScale: 1,
        lines: [],
        el: this.el?.querySelector('.js-mask') as HTMLElement,
        svg: this.el?.querySelector('.js-mask-svg') as HTMLElement,
        pathOuter: this.el?.querySelector('.js-mask-path-outer') as SVGPathElement,
        pathLines: this.el?.querySelector('.js-mask-path-lines') as SVGPathElement,
      }

      this.letters = []
      this.title?.querySelectorAll('.js-letter').forEach((_letter) => {
        const letter = {
          el: _letter,
          ghosts: [] as any[],
          width: 0,
          height: 0,
          top: 0,
          left: 0,
          freq: 1,
          total: 0,
        }

        this.letters.push(letter)
      })

      this.works = []
      this.container?.querySelectorAll('.js-work').forEach((_work) => {
        const work = {
          el: _work,
        }

        this.works.push(work)
      })

      this.points = []

      this.scrollProgress = 0
      this.smoothScrollProgress = 0
      this.animationProgress = 0
      this.pointsProgress = 0
      this.state = 0
      this.speed = 1000
      this.last = {
        animationProgress: 0,
        pointsProgress: 0,
      }

      this.isPaused = true
      this.loadIsStarted = false
      this.tl = null

      // Init
      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    /**
     * Init
     */
    init() {
      this.setCtxStyle()
      this.setSize()
      this.setMask()
      this.setPoints()
      this.setLetters()
      this.setWorks()
      this.setTimeline()

      this.bindEvents()
    }

    /**
     * Bind events
     */
    bindEvents() {
      Emitter.on('contrastchange', this.setCtxStyle, this)
      Emitter.on('resize', this.onResize, this)

      this.el?.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })
    }

    /**
     * Resize handler
     */
    onResize(widthChanged: boolean) {
      if (widthChanged) {
        this.setCtxStyle()
        this.setSize()
        this.setMask()
        this.setPoints()
        this.setLetters()
        this.setWorks()
        this.setTimeline()
      }
    }

    /**
     * Intersect handler
     */
    onIntersect(e: any) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }

      if (!this.loadIsStarted) {
        this.loadNextVideo()
        this.loadIsStarted = true
      }
    }

    /**
     * Set canvas style
     */
    setCtxStyle() {
      if (!this.el) return
      const color = getComputedStyle(this.el).getPropertyValue('--color-primary')

      Ticker.nextTick(() => {
        if (this.ctx) this.ctx.strokeStyle = color
      })
    }

    /**
     * Set size
     */
    setSize() {
      if (!this.el || !this.container || !this.canvas) return

      const isMobile = (window.safeWidth || window.innerWidth) <= 767
      const heightMultiplier = isMobile ? 50 : 65
      this.el.style.setProperty('--height', (this.works.length * heightMultiplier + 160) + 'lvh')

      const bounding = this.container.getBoundingClientRect()

      this.bounding = {
        left: bounding.left,
        top: bounding.top,
        width: window.safeWidth || window.innerWidth,
        height: window.safeHeight || window.innerHeight,
      }

      this.canvas.width = this.bounding.width
      this.canvas.height = this.bounding.height

      this.speed = Math.hypot(this.bounding.width, this.bounding.height) * 4
    }

    /**
     * Set mask
     */
    setMask() {
      const { mask, el } = this
      if (!mask.el || !el || !this.bounding) return

      const width = this.bounding.width || window.innerWidth
      const height = this.bounding.height || window.innerHeight

      mask.width = width
      mask.height = height

      mask.svg.style.width = width + 'px'
      mask.svg.style.height = height + 'px'
      mask.svg.setAttribute('viewBox', `0 0 ${width} ${height}`)

      const isMobile = width <= 767
      const isTablet = width > 767 && width <= 1024

      const rulerWidth = isMobile ? width * 0.5 : (isTablet ? width * 0.3333 : Math.min(width * 0.16667, 314))
      const rulerHeight = height * 0.8
      const offsetX = (width - rulerWidth) / 2
      const offsetY = height * 0.1

      const dOuter = `M -2 -2 L ${width + 4} -2 L ${width + 4} ${height + 4} L -2 ${height + 4} Z`

      const corners = {
        tl: { x: offsetX, y: offsetY },
        tr: { x: offsetX + rulerWidth, y: offsetY },
        br: { x: offsetX + rulerWidth, y: offsetY + rulerHeight },
        bl: { x: offsetX, y: offsetY + rulerHeight },
      }

      let size = (corners.tr.x - corners.tl.x) / 2
      // Compute diagonal from center to screen corner to guarantee mask completely exits viewport
      const distToCorner = Math.hypot(width * 0.5, height * 0.5)
      mask.maxScale = Math.max(16, (distToCorner / (size || 1)) * 2.2)

      let dInner = `M ${corners.tl.x} ${corners.tl.y + size} L ${corners.bl.x} ${corners.bl.y - size} A ${size} ${size} 0 0 0 ${corners.br.x} ${corners.br.y - size} L ${corners.tr.x} ${corners.tr.y + size} A ${size} ${size} 0 0 0 ${corners.tl.x} ${corners.tl.y + size} Z`
      const linesClip = `${dOuter} ${dInner}`

      mask.pathOuter?.setAttribute('d', linesClip)

      const linesClipEl = this.el?.querySelector('.js-lines-clip')
      if (linesClipEl) {
        linesClipEl.setAttribute('d', linesClip)
      }

      mask.lines = []
      const vLines = isMobile ? 8 : 12
      const gapX = width / vLines
      const gapY = height * 0.1
      const hLines = Math.ceil(height / (gapY || 1))

      for (let i = 1; i < vLines; i++) {
        const x = gapX * i
        if (x > offsetX && x < offsetX + rulerWidth) {
          mask.lines.push({
            p1: { x, y: 0 },
            p2: { x, y: offsetY },
          })
          mask.lines.push({
            p1: { x, y: offsetY + rulerHeight },
            p2: { x, y: height },
          })
        } else {
          mask.lines.push({
            p1: { x, y: 0 },
            p2: { x, y: height },
          })
        }
      }

      for (let i = 0; i < hLines; i++) {
        const y = gapY * i
        if (y > offsetY && y < offsetY + rulerHeight) {
          mask.lines.push({
            p1: { x: 0, y },
            p2: { x: offsetX, y },
          })
          mask.lines.push({
            p1: { x: offsetX + rulerWidth, y },
            p2: { x: width, y },
          })
        } else {
          mask.lines.push({
            p1: { x: 0, y },
            p2: { x: width, y },
          })
        }
      }

      let dLines = ''
      mask.lines.forEach((line) => {
        dLines += `M ${line.p1.x} ${line.p1.y} L ${line.p2.x} ${line.p2.y} `
      })

      mask.pathLines?.setAttribute('d', dLines)
    }

    /**
     * Set letters
     */
    setLetters() {
      const { letters, scene } = this
      if (!scene || !this.bounding) return

      letters.forEach((letter, j) => {
        letter.ghosts.forEach((ghost: any) => {
          ghost.el.remove()
        })
        letter.ghosts = []

        const bounding = letter.el.getBoundingClientRect()

        letter.width = bounding.width
        letter.height = bounding.height
        letter.top = bounding.top - this.bounding.top
        letter.left = bounding.left

        letter.freq = 1 + Math.random()

        const multiplier = (window.safeWidth || window.innerWidth) > 767 ? 0.75 : 0.5

        letter.total =
          Math.round(((this.bounding.width || 1000) / (letter.width || 100)) * multiplier) + 2

        for (let i = 0; i < letter.total; i++) {
          const el = document.createElement('span')
          el.classList.add('s__scene__letter', 'js-letter')
          el.innerText = letter.el.innerText
          el.dataset.letter = letter.el.innerText

          scene.appendChild(el)

          const ghost = {
            el,
            x: letter.left,
            y: letter.top,
            z: Math.random() * 100,
            i: i - letter.total * 0.5,
            p: (i / letter.total - 0.5) * 2,
            ap: Math.abs(i / letter.total - 0.5) * 2,
          }

          el.style.top = ghost.y + 'px'
          el.style.left = ghost.x + 'px'
          el.style.zIndex = String(j !== 1 && j !== 2 && (j + letters.length + i) % 5 === 0 ? 3 : 1)
          el.style.setProperty('--ix', String(ghost.i))
          el.style.setProperty(
            '--iy',
            String(((j + 1) / (letters.length + 1) - 0.5) * 2)
          )
          el.style.setProperty('--ap', String(ghost.ap))
          el.style.setProperty('--p', String(ghost.p))

          letter.ghosts.push(ghost)
        }
      })
    }

    /**
     * Set works
     */
    setWorks() {
      this.works.forEach((work, i) => {
        const el = work.el
        el.style.setProperty('--size', String(0.7 + Math.random() * 0.3))
        el.style.setProperty(
          '--y',
          String((0.25 + Math.random() * 0.35) * (i % 2 ? -1 : 1))
        )
      })
    }

    /**
     * Set timeline
     */
    setTimeline() {
      const { el, container, works, scene, mask } = this
      if (!el || !container || !scene || !mask.el) return

      if (this.tl) {
        this.tl.kill()
      }

      this.tl = gsap.timeline({
        scrollTrigger: {
          trigger: el,
          start: 'top top',
          end: 'bottom bottom',
          pin: this.stage,
          pinSpacing: false,
          scrub: 1,
        },
        onUpdate: () => {
          scene.style.setProperty('--state', String(this.state))
        },
      })

      const introDuration = 0.5
      const enterDuration = 0.6
      const glideDuration = 1.3
      const exitDuration = 0.6
      const stepDuration = 1.9

      // Initial intro transition: Expand aperture smoothly to reveal WORK universe with graceful fade
      this.tl.fromTo(
        mask.el,
        { scale: 1, opacity: 1 },
        { scale: mask.maxScale, opacity: 0, duration: introDuration, ease: 'power2.inOut' },
        0
      )

      this.tl.fromTo(
        scene,
        { scale: 0.75 },
        { scale: 1, duration: introDuration, ease: 'power2.inOut' },
        0
      )

      this.tl.fromTo(
        this,
        { pointsProgress: 0 },
        { pointsProgress: 1, duration: introDuration, ease: 'power2.inOut' },
        0
      )

      this.tl.fromTo(
        this,
        { state: 0 },
        { state: 1, duration: introDuration, ease: 'power2.inOut' },
        0
      )

      // Sequentially animate each project:
      // Enter smoothly from right (1.15 -> 0.25) -> Glide gently across center (0.25 -> -0.25) -> Exit smoothly to left (-0.25 -> -1.15)
      // Never a hard dead-stop; smooth continuous motion with slide delay and zero overlapping!
      works.forEach((work, i) => {
        const workEl = work.el
        const startTime = introDuration + i * stepDuration

        gsap.set(workEl, { attr: { progress: 1.15 } })

        // 1. Enter from right towards center (Fading in)
        this.tl!.fromTo(
          workEl,
          { attr: { progress: 1.15 } },
          {
            attr: { progress: 0.25 },
            duration: enterDuration,
            ease: 'power2.out',
          },
          startTime
        )

        // 2. Luxurious glide across center (Active spotlight focus, smooth organic drift)
        this.tl!.to(
          workEl,
          {
            attr: { progress: -0.25 },
            duration: glideDuration,
            ease: 'sine.inOut',
          },
          startTime + enterDuration
        )

        // 3. Exit to left (Fading out)
        this.tl!.to(
          workEl,
          {
            attr: { progress: -1.15 },
            duration: exitDuration,
            ease: 'power2.in',
          },
          startTime + enterDuration + glideDuration
        )
      })

      const outroStart = introDuration + (works.length - 1) * stepDuration + enterDuration + glideDuration + 0.4

      this.tl.fromTo(
        this,
        { animationProgress: 0 },
        { animationProgress: 30000, duration: this.tl.totalDuration(), ease: 'none' },
        0
      )

      this.tl.fromTo(
        this,
        { state: 1 },
        { state: 0, duration: introDuration, ease: 'power2.inOut', immediateRender: false },
        outroStart
      )

      this.tl.fromTo(
        mask.el,
        { scale: mask.maxScale, opacity: 0 },
        { scale: 1, opacity: 1, duration: introDuration, ease: 'power2.inOut', immediateRender: false },
        outroStart
      )

      this.tl.fromTo(
        scene,
        { scale: 1 },
        { scale: 0.75, duration: introDuration, ease: 'power2.inOut', immediateRender: false },
        outroStart
      )

      this.tl.fromTo(
        this,
        { pointsProgress: 1 },
        { pointsProgress: 0, duration: introDuration, ease: 'power2.inOut' },
        outroStart
      )
    }

    /**
     * Load next video
     */
    loadNextVideo() {
      if (!this.videos) return
      const video = Array.from(this.videos).find(
        (v) => !v.classList.contains('is-loaded')
      )

      if (video) {
        if (video.readyState >= 3) {
          this.videoLoaded(video)
        } else {
          video.addEventListener(
            'canplaythrough',
            () => {
              this.videoLoaded(video)
            },
            { once: true }
          )

          const dataSrc = video.getAttribute('data-src')
          if (dataSrc) {
            video.setAttribute('src', dataSrc)
            video.load()
          }
        }
      }
    }

    /**
     * Video loaded
     */
    videoLoaded(video: HTMLVideoElement) {
      video.classList.add('is-loaded')
      this.loadNextVideo()
    }

    /**
     * Move letters
     */
    moveLetters() {
      const { speed, letters, animationProgress } = this

      letters.forEach((letter) => {
        const letterSpeed = speed * letter.freq
        letter.ghosts.forEach((ghost: any, index: number) => {
          let progress =
            (((animationProgress % letterSpeed) / letterSpeed +
              index / letter.total) %
              1) /
              0.7 -
            0.15

          ghost.el.style.setProperty('--progress', String(progress))
        })
      })
    }

    /**
     * Set points
     */
    setPoints() {
      const { bounding } = this
      if (!bounding) return

      this.points = []

      const gap = 24
      const cols = Math.ceil((bounding.width * 1.2) / gap)
      const rows = Math.ceil((bounding.height * 1.2) / gap)

      const offsetX = (bounding.width - cols * gap) * 0.5
      const offsetY = (bounding.height - rows * gap) * 0.5

      const hWidth = bounding.width * 0.5
      const hHeight = bounding.height * 0.5

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const x = i * gap + offsetX
          const y = j * gap + offsetY

          const dx = hWidth - x
          const dy = hHeight - y

          this.points.push({
            x,
            y,
            dx,
            dy,
            flowX: 0,
          })
        }
      }
    }

    /**
     * Move points
     */
    movePoints() {
      const { points, animationProgress } = this

      points.forEach((p) => {
        p.flowX = (animationProgress * -0.05) % 24
      })
    }

    /**
     * Draw points
     */
    drawPoints() {
      const { bounding, ctx, points, animationProgress, pointsProgress, last } =
        this
      if (!ctx || !bounding) return

      const rAnimationProgress = Math.round(animationProgress * 100) / 100
      const rPointsProgress = Math.round(pointsProgress * 100) / 100

      if (
        rPointsProgress === last.pointsProgress &&
        rAnimationProgress === last.animationProgress
      )
        return

      ctx.clearRect(0, 0, bounding.width, bounding.height)
      ctx.beginPath()

      points.forEach((point) => {
        const x = point.x + point.dx * (1 - pointsProgress) * 0.2 + point.flowX
        const y = point.y + point.dy * (1 - pointsProgress) * 0.2

        ctx.rect(x, y, 0.5, 0.5)
      })

      ctx.stroke()

      last.pointsProgress = rPointsProgress
      last.animationProgress = rAnimationProgress
    }

    /**
     * Tick
     */
    tick() {
      if (!this.el) return

      this.scrollProgress =
        Math.max(
          Math.min(1, ScrollTrigger.positionInViewport(this.el, 'top')),
          0
        ) *
          -1 +
        (1 -
          Math.max(
            Math.min(1, ScrollTrigger.positionInViewport(this.el, 'bottom')),
            0
          ))
      this.smoothScrollProgress +=
        (this.scrollProgress - this.smoothScrollProgress) * 0.1

      this.el.style.setProperty(
        '--scroll-progress',
        String(this.scrollProgress)
      )

      this.movePoints()
      this.moveLetters()
      this.drawPoints()
    }
  }

  new Section()
</script>

