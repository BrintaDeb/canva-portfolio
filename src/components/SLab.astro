    code: '01',
    category: 'FULLSTACK WEB',
    title: 'Fullstack Web & 3D Motion Architecture',
    desc: 'Review tech stack fit (Astro, Next.js, GSAP motion, Three.js WebGL), site performance, and responsive frontend feasibility.',
    icon: '🌐',
    badge: '3D & SPEED',
