<section id="lab" class="s-lab s-pay-to-call" data-intersect>
  <div class="s-lab__wrapper">
    <!-- Top Pill Header (1:1 with Portfolio Bento Standard) -->
    <div class="s-lab__pill-header">
      <span class="s-lab__pill-text">SECTION // 05 &bull; PAY TO CALL &bull; 1-ON-1 WHATSAPP CONSULTATION &bull; ₹100 INR</span>
    </div>

    <!-- Outer Bento Grid with Hairline Collapsed Borders -->
    <div class="s-lab__bento">
      <!-- Row 1: Full-Width Section Header Cell -->
      <div class="s-lab__cell s-lab__cell--hero">
        <div class="s-lab__crosshair s-lab__crosshair--tl">+</div>
        <div class="s-lab__crosshair s-lab__crosshair--tr">+</div>
        <div class="s-lab__crosshair s-lab__crosshair--bl">+</div>
        <div class="s-lab__crosshair s-lab__crosshair--br">+</div>

        <div class="s-lab__hero-content">
          <div class="s-lab__coords-badge">
            <span class="pulse-dot"></span>
            <span>22.57° N, 88.36° E • KOLKATA // DEPLOYING GLOBALLY &bull; ACTIVE CONSULTATION LINE</span>
          </div>

          <h2 class="s-lab__title">
            PAY &amp; GET TO CALL. <span class="s-lab__title--italic">WhatsApp Direct</span>
          </h2>

          <p class="s-lab__lead">
            &ldquo;This upfront reservation fee is in place to ensure our time together is focused, dedicated, and strictly reserved for serious clients. If after our call you feel we are not the right fit or decide not to work together, 50% is immediately refundable — zero hassle.&rdquo;
          </p>

          <!-- Top Metrics Summary Strip -->
          <div class="pay-metrics-strip">
            <div class="pay-metric">
              <span class="pay-metric__label">UPFRONT FEE</span>
              <span class="pay-metric__val">₹100 INR ONLY</span>
            </div>
            <div class="pay-metric">
              <span class="pay-metric__label">GUARANTEE</span>
              <span class="pay-metric__val">50% REFUNDABLE</span>
            </div>
            <div class="pay-metric">
              <span class="pay-metric__label">PROJECT REBATE</span>
              <span class="pay-metric__val">100% FEE DEDUCTED</span>
            </div>
            <div class="pay-metric">
              <span class="pay-metric__label">CHANNEL</span>
              <span class="pay-metric__val">WHATSAPP CALL / CHAT</span>
            </div>
          </div>
        </div>
        <span class="s-lab__cell-mask"></span>
      </div>

      <!-- Row 2: 2-Column Split Terminal (UPI Scanner Gateway on Left, Call Connect Form on Right) -->
      <div class="s-lab__split-row">
        <!-- Left Cell: UPI Scanner Gateway Terminal -->
        <div class="s-lab__cell s-lab__cell--scanner js-lab-cell">
          <div class="s-lab__crosshair s-lab__crosshair--tl">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--tr">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--bl">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--br">+</div>

          <div class="terminal-content">
            <div class="terminal-header">
              <div class="terminal-header__left">
                <span class="step-num">[ STEP 01 ]</span>
                <span class="terminal-title">UPI SCANNER GATEWAY</span>
              </div>
              <div class="terminal-header__badge">
                <span class="pulse-green"></span>
                <span>LIVE &bull; ₹100</span>
              </div>
            </div>

            <p class="terminal-instruction">
              Scan with <strong>Google Pay, PhonePe, Paytm, BHIM, Cred</strong> or any UPI app to pay the ₹100 call reservation fee:
            </p>

            <!-- Interactive QR Scanner Display with Animated Laser Sweep -->
            <div class="scanner-frame">
              <!-- Corner Crosshair / Registration L-Brackets -->
              <div class="frame-bracket frame-bracket--tl"></div>
              <div class="frame-bracket frame-bracket--tr"></div>
              <div class="frame-bracket frame-bracket--bl"></div>
              <div class="frame-bracket frame-bracket--br"></div>

              <!-- Animated Laser Scanline -->
              <div class="scanner-laser-line"></div>

              <!-- QR Code Asset Frame: High-Resolution Official Navi UPI QR Code -->
              <div class="qr-wrapper">
                <img
                  src="/images/brinta-navi-upi-qr.jpg"
                  alt="UPI QR Code - Brinta Deb (₹100 Call Reservation)"
                  class="qr-code-img js-qr-code-img"
                  loading="eager"
                  width="260"
                  height="390"
                />
                <div class="qr-verified-tag">
                  <span class="amount-tag">₹100</span>
                  <span class="upi-tag">NAVI &bull; UPI VERIFIED</span>
                </div>
              </div>
            </div>

            <!-- Copyable UPI ID Box -->
            <div class="upi-id-box">
              <div class="upi-id-text-wrap">
                <span class="upi-id-label">OR PAY DIRECTLY TO UPI ID:</span>
                <span class="upi-id-value js-upi-id-val">brintadeb1453@nyes</span>
              </div>
              <button type="button" class="copy-upi-btn js-copy-upi" aria-label="Copy UPI ID to clipboard">
                <span class="copy-label js-copy-upi-label">COPY UPI ID</span>
                <span class="copy-icon">⎘</span>
              </button>
            </div>

            <!-- Direct Mobile UPI Deep-Link -->
            <a
              href="upi://pay?pa=brintadeb1453@nyes&pn=BRINTA%20DEB&am=100&cu=INR&tn=Consultation%20Call%20Booking"
              class="upi-direct-app-btn"
              title="Open directly inside your UPI App on Mobile"
            >
              <span>⚡ OPEN IN UPI APP (GPAY / PHONEPE / PAYTM / NAVI)</span>
              <span class="btn-arrow">↗</span>
            </a>

            <!-- Accepted Payment Apps Pill Grid -->
            <div class="accepted-modes">
              <span class="modes-label">ACCEPTED PAYMENT APPS:</span>
              <div class="modes-pills">
                <span class="mode-pill">Google Pay</span>
                <span class="mode-pill">PhonePe</span>
                <span class="mode-pill">Paytm</span>
                <span class="mode-pill">Navi UPI</span>
                <span class="mode-pill">BHIM UPI</span>
                <span class="mode-pill">Cred</span>
                <span class="mode-pill">Any UPI App</span>
              </div>
            </div>

            <!-- Quick Trigger to Unlock Call -->
            <button type="button" class="scanner-paid-trigger js-trigger-paid" title="Click after transferring ₹100">
              <span class="paid-trigger-check">✓</span>
              <span>I HAVE TRANSFERRED ₹100 &bull; ENTER UTR TO UNLOCK CALL</span>
              <span class="paid-trigger-arrow">→</span>
            </button>
          </div>
          <span class="s-lab__cell-mask"></span>
        </div><!-- .s-lab__cell--scanner -->

        <!-- Right Cell: Locked Gate & Unlocked Call System -->
        <div class="s-lab__cell s-lab__cell--form js-lab-cell">
          <div class="s-lab__crosshair s-lab__crosshair--tl">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--tr">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--bl">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--br">+</div>

          <!-- State 1: Locked System Gate (Default - Payment Required) -->
          <div class="terminal-content js-gate-locked">
            <div class="terminal-header">
              <div class="terminal-header__left">
                <span class="step-num">[ STEP 02 // CALL GATE ]</span>
                <span class="terminal-title">PAYMENT VERIFICATION</span>
              </div>
              <div class="terminal-header__badge terminal-header__badge--locked">
                <span class="lock-pulse-dot"></span>
                <span>🔒 CALL SYSTEM LOCKED</span>
              </div>
            </div>

            <!-- Brutalist Locked Notice Card -->
            <div class="lock-notice-box">
              <div class="lock-notice-top">
                <div class="lock-icon-badge">🔒</div>
                <div class="lock-notice-headings">
                  <h4 class="lock-notice-title">ONLY OPENS WHEN UPFRONT FEE IS PAID</h4>
                  <p class="lock-notice-sub">
                    Direct WhatsApp call &amp; messaging is strictly pay-gated to filter spam and reserve dedicated time for genuine, serious inquiries. Unlocks immediately after your ₹100 payment is verified.
                  </p>
                </div>
              </div>

              <div class="lock-checklist">
                <div class="checklist-item">
                  <span class="checklist-num">01</span>
                  <span>Scan the UPI QR code on the left &amp; transfer ₹100.</span>
                </div>
                <div class="checklist-item">
                  <span class="checklist-num">02</span>
                  <span>Enter your 12-digit UPI UTR / Transaction Ref from your receipt below.</span>
                </div>
                <div class="checklist-item">
                  <span class="checklist-num">03</span>
                  <span>Click Unlock — the direct WhatsApp call line opens instantly.</span>
                </div>
              </div>

              <div class="refund-guarantee-notice">
                <span class="refund-badge">50% REFUNDABLE</span>
                <span>If after our call you are not interested or decide not to work together, 50% is refunded immediately. If you proceed, 100% is credited toward your project bill.</span>
              </div>
            </div>

            <!-- UTR Verification Input & Unlock Button -->
            <div class="gate-unlock-form">
              <div class="field-wrap field-wrap--full">
                <label for="gateUtrInput" class="field-label">
                  <span>ENTER 12-DIGIT UPI REFERENCE / UTR NUMBER *</span>
                  <span class="field-sub">From GPay, PhonePe, Paytm, Navi or Bank receipt</span>
                </label>
                <input
                  type="text"
                  id="gateUtrInput"
                  class="field-input js-gate-utr-input"
                  placeholder="e.g. 423589123456 or Paid via PhonePe"
                  required
                />
                <div class="gate-error js-gate-error" style="display: none;">
                  ⚠️ Please enter your UPI UTR / Transaction Reference to unlock the call system.
                </div>
              </div>

              <button type="button" class="gate-unlock-btn js-btn-unlock-gate">
                <span class="btn-glow-bar"></span>
                <span class="btn-content">
                  <span class="btn-lock-icon">🔓</span>
                  <span class="btn-text">PAYMENT DONE &bull; UNLOCK CALL SYSTEM NOW</span>
                </span>
                <span class="btn-arrow-icon">→</span>
              </button>

              <div class="gate-disclaimer">
                <span>Direct client guarantee: 50% refundable if not proceeding, or 100% credited against your final project invoice.</span>
              </div>
            </div>
          </div><!-- .js-gate-locked -->

          <!-- State 2: Unlocked Call System (Opens only after payment is logged) -->
          <div class="terminal-content js-gate-unlocked" style="display: none;">
            <div class="terminal-header">
              <div class="terminal-header__left">
                <span class="step-num">[ STEP 03 // CALL SYSTEM OPEN ]</span>
                <span class="terminal-title">1-ON-1 WHATSAPP CALL</span>
              </div>
              <div class="terminal-header__badge terminal-header__badge--wa">
                <span class="wa-dot"></span>
                <span>🟢 UNLOCKED &bull; VIP LINE ACTIVE</span>
              </div>
            </div>

            <!-- Verified Payment Success Ribbon -->
            <div class="verified-ribbon">
              <div class="verified-ribbon__left">
                <span class="verified-badge-icon">✓</span>
                <div class="verified-info">
                  <span class="verified-status-label">₹100 PAYMENT LOGGED &bull; CALL SYSTEM OPEN</span>
                  <span class="verified-utr-text">TRANSACTION REF: <strong class="js-display-utr">--</strong></span>
                </div>
              </div>
              <button type="button" class="relock-btn js-btn-relock" title="Change payment reference or relock">
                CHANGE REF / RELOCK ↺
              </button>
            </div>

            <p class="terminal-instruction">
              Payment verified! Fill your details below to connect directly with Brinta Deb on WhatsApp:
            </p>

            <form id="payToCallForm" class="call-booking-form js-call-form" novalidate>
              <input type="hidden" id="callUtr" name="utrRef" class="js-input-utr" />

              <div class="form-fields">
                <!-- Client Name / Brand -->
                <div class="field-wrap">
                  <label for="callName" class="field-label">
                    <span>YOUR NAME / BRAND *</span>
                    <span class="field-sub">e.g. Alex Morgan / Studio Pulse</span>
                  </label>
                  <input
                    type="text"
                    id="callName"
                    name="clientName"
                    class="field-input js-input-name"
                    placeholder="Enter your name or business"
                    required
                  />
                </div>

                <!-- WhatsApp Phone Number -->
                <div class="field-wrap">
                  <label for="callPhone" class="field-label">
                    <span>YOUR WHATSAPP NUMBER *</span>
                    <span class="field-sub">with country code</span>
                  </label>
                  <input
                    type="tel"
                    id="callPhone"
                    name="clientPhone"
                    class="field-input js-input-phone"
                    placeholder="+91 98765 43210"
                    required
                  />
                </div>

                <!-- Discussion Focus / Topic -->
                <div class="field-wrap field-wrap--full">
                  <label for="callTopicSelect" class="field-label">
                    <span>SELECT CALL DISCUSSION TOPIC *</span>
                    <span class="field-sub">Select discussion focus for the consultation</span>
                  </label>
                  <div class="select-container">
                    <select id="callTopicSelect" name="callTopic" class="field-select js-select-topic">
                      {callTopics.map((topic, i) => (
                        <option value={topic.title} data-topic-id={topic.id} selected={i === 0}>
                          [{topic.code}] {topic.title}
                        </option>
                      ))}
                    </select>
                    <span class="select-arrow">▼</span>
                  </div>
                </div>
              </div>

              <!-- Main Submit CTA Button -->
              <div class="submit-wrap">
                <button type="submit" class="call-submit-btn js-btn-connect">
                  <span class="btn-glow-bar"></span>
                  <span class="btn-content">
                    <span class="btn-phone-icon">📞</span>
                    <span class="btn-text">INITIATE WHATSAPP CALL NOW</span>
                  </span>
                  <span class="btn-arrow-icon">→</span>
                </button>
              </div>

              <!-- Success Feedback Box -->
              <div class="call-feedback-box js-call-feedback" style="display: none;">
                <span class="feedback-badge">✓</span>
                <span class="feedback-msg js-feedback-msg">Connecting to Brinta Deb on WhatsApp...</span>
              </div>

              <!-- Privacy & Direct Guarantee Notice -->
              <div class="form-disclaimer">
                <span class="lock-icon">🔒</span>
                <span>
                  Direct end-to-end encrypted connection to Brinta Deb on WhatsApp. 
                  Unlocked exclusively for verified clients after upfront reservation. 
                  If on an active client call, I will reply with your exact call slot in &lt;15 minutes.
                </span>
              </div>
            </form>
          </div><!-- .js-gate-unlocked -->
        </div><!-- .s-lab__cell--form -->
      </div><!-- .s-lab__split-row -->

      <!-- Row 3: 4 Guarantees & Perks -->
      <div class="s-lab__perks-row">
        {consultationGuarantees.map((item) => (
          <div class="s-lab__cell s-lab__cell--perk js-lab-cell">
            <div class="s-lab__crosshair s-lab__crosshair--tl">+</div>
            <div class="s-lab__crosshair s-lab__crosshair--tr">+</div>
            <div class="s-lab__crosshair s-lab__crosshair--bl">+</div>
            <div class="s-lab__crosshair s-lab__crosshair--br">+</div>

            <div class="perk-content">
              <div class="perk-header">
                <span class="perk-code">[{item.num}]</span>
                <span class="perk-tag">{item.code}</span>
              </div>
              <h5 class="perk-title">{item.title}</h5>
              <p class="perk-desc">{item.desc}</p>
            </div>
            <span class="s-lab__cell-mask"></span>
          </div>
        ))}
      </div>
    </div><!-- .s-lab__bento -->
  </div><!-- .s-lab__wrapper -->
</section>

<script>
  import gsap from 'gsap'
  import { audioEngine } from '../utils/AudioEngine.js'

  class PayToCallStation {
    el: HTMLElement | null
    form: HTMLFormElement | null
    nameInput: HTMLInputElement | null
    phoneInput: HTMLInputElement | null
    topicSelect: HTMLSelectElement | null
    utrInput: HTMLInputElement | null
    feedbackBox: HTMLElement | null
    feedbackMsg: HTMLElement | null
    copyBtn: HTMLButtonElement | null
    copyLabel: HTMLElement | null
    cells: NodeListOf<HTMLElement>
    gateLocked: HTMLElement | null
    gateUnlocked: HTMLElement | null
    gateUtrInput: HTMLInputElement | null
    gateError: HTMLElement | null
    unlockGateBtn: HTMLButtonElement | null
    relockBtn: HTMLButtonElement | null
    verifiedUtrDisplay: HTMLElement | null
    quickUnlockTrigger: HTMLElement | null

    constructor() {
      this.el = document.getElementById('lab')
      if (!this.el) return

      this.form = this.el.querySelector('.js-call-form')
      this.nameInput = this.el.querySelector('.js-input-name')
      this.phoneInput = this.el.querySelector('.js-input-phone')
      this.topicSelect = this.el.querySelector('.js-select-topic')
      this.utrInput = this.el.querySelector('.js-input-utr')
      this.feedbackBox = this.el.querySelector('.js-call-feedback')
      this.feedbackMsg = this.el.querySelector('.js-feedback-msg')
      this.copyBtn = this.el.querySelector('.js-copy-upi')
      this.copyLabel = this.el.querySelector('.js-copy-upi-label')
      this.cells = this.el.querySelectorAll('.js-lab-cell')

      this.gateLocked = this.el.querySelector('.js-gate-locked')
      this.gateUnlocked = this.el.querySelector('.js-gate-unlocked')
      this.gateUtrInput = this.el.querySelector('.js-gate-utr-input')
      this.gateError = this.el.querySelector('.js-gate-error')
      this.unlockGateBtn = this.el.querySelector('.js-btn-unlock-gate')
      this.relockBtn = this.el.querySelector('.js-btn-relock')
      this.verifiedUtrDisplay = this.el.querySelector('.js-display-utr')
      this.quickUnlockTrigger = this.el.querySelector('.js-trigger-paid')

      this.init()
    }

    init() {
      this.bindCellHover()
      this.bindCopyUPI()
      this.initPaymentGate()
      this.bindForm()
    }

    /**
     * Payment Gate: Only open call system when payment is completed & verified
     */
    initPaymentGate() {
      // Check session storage for existing verified payment
      try {
        const savedUtr = sessionStorage.getItem('call_payment_utr')
        if (savedUtr) {
          this.unlockCallSystem(savedUtr, false)
        }
      } catch (e) {}

      // Unlock button handler
      this.unlockGateBtn?.addEventListener('click', () => {
        const utrVal = this.gateUtrInput?.value.trim()
        if (!utrVal || utrVal.length < 3) {
          if (this.gateError) this.gateError.style.display = 'block'
          this.gateUtrInput?.focus()
          this.gateUtrInput?.classList.add('has-error')
          try { audioEngine?.playError?.() } catch (e) {}
          setTimeout(() => this.gateUtrInput?.classList.remove('has-error'), 2500)
          return
        }

        if (this.gateError) this.gateError.style.display = 'none'
        this.unlockCallSystem(utrVal, true)
      })

      // Enter key on UTR input
      this.gateUtrInput?.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') {
          e.preventDefault()
          this.unlockGateBtn?.click()
        }
      })

      // Relock / Change UTR handler
      this.relockBtn?.addEventListener('click', () => {
        try {
          sessionStorage.removeItem('call_payment_utr')
        } catch (e) {}

        if (this.utrInput) this.utrInput.value = ''
        if (this.gateUtrInput) this.gateUtrInput.value = ''

        try { audioEngine?.playTone?.(400, 0.08) } catch (e) {}

        if (this.gateUnlocked && this.gateLocked) {
          gsap.to(this.gateUnlocked, {
            opacity: 0,
            duration: 0.2,
            onComplete: () => {
              if (this.gateUnlocked) this.gateUnlocked.style.display = 'none'
              if (this.gateLocked) {
                this.gateLocked.style.display = 'block'
                gsap.fromTo(
                  this.gateLocked,
                  { opacity: 0, y: 8 },
                  { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out' }
                )
                this.gateUtrInput?.focus()
              }
            }
          })
        }
      })

      // Quick trigger from scanner terminal
      this.quickUnlockTrigger?.addEventListener('click', () => {
        try { audioEngine?.playTone?.(550, 0.08) } catch (e) {}
        if (this.gateLocked && this.gateLocked.style.display !== 'none') {
          this.gateUtrInput?.focus()
          this.gateUtrInput?.scrollIntoView({ behavior: 'smooth', block: 'center' })
          this.gateUtrInput?.classList.add('pulse-focus')
          setTimeout(() => this.gateUtrInput?.classList.remove('pulse-focus'), 1500)
        } else {
          this.nameInput?.focus()
          this.nameInput?.scrollIntoView({ behavior: 'smooth', block: 'center' })
        }
      })
    }

    unlockCallSystem(utr: string, playSound = true) {
      if (playSound) {
        try { audioEngine?.playSuccess?.() } catch (e) {}
      }

      try {
        sessionStorage.setItem('call_payment_utr', utr)
      } catch (e) {}

      if (this.utrInput) this.utrInput.value = utr
      if (this.verifiedUtrDisplay) this.verifiedUtrDisplay.textContent = utr

      if (this.gateLocked && this.gateUnlocked) {
        gsap.to(this.gateLocked, {
          opacity: 0,
          duration: 0.22,
          onComplete: () => {
            if (this.gateLocked) this.gateLocked.style.display = 'none'
            if (this.gateUnlocked) {
              this.gateUnlocked.style.display = 'block'
              gsap.fromTo(
                this.gateUnlocked,
                { opacity: 0, y: 14 },
                { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }
              )
              setTimeout(() => this.nameInput?.focus(), 250)
            }
          }
        })
      }
    }

    /**
     * Subtle Cell Hover Masks
     */
    bindCellHover() {
      this.cells.forEach((cell) => {
        const mask = cell.querySelector('.s-lab__cell-mask') as HTMLElement
        if (!mask) return

        cell.addEventListener('mouseenter', (e: MouseEvent) => {
          const rect = cell.getBoundingClientRect()
          const x = e.clientX - rect.left
          const y = e.clientY - rect.top

          gsap.killTweensOf(mask)
          gsap.fromTo(
            mask,
            { opacity: 0, scale: 0.85, transformOrigin: `${x}px ${y}px` },
            { opacity: 1, scale: 1, duration: 0.4, ease: 'power2.out' }
          )
        })

        cell.addEventListener('mouseleave', () => {
          gsap.to(mask, { opacity: 0, duration: 0.3, ease: 'power2.in' })
        })
      })
    }

    /**
     * Copy UPI ID Button
     */
    bindCopyUPI() {
      if (!this.copyBtn) return

      this.copyBtn.addEventListener('click', async () => {
        const upiId = 'brintadeb1453@nyes'
        audioEngine?.playTone(750, 0.08)

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(upiId)
          } else {
            const temp = document.createElement('textarea')
            temp.value = upiId
            document.body.appendChild(temp)
            temp.select()
            document.execCommand('copy')
            document.body.removeChild(temp)
          }

          if (this.copyLabel) {
            const orig = this.copyLabel.textContent
            this.copyLabel.textContent = '✓ COPIED TO CLIPBOARD'
            this.copyBtn?.classList.add('is-copied')

            setTimeout(() => {
              if (this.copyLabel) this.copyLabel.textContent = orig
              this.copyBtn?.classList.remove('is-copied')
            }, 2500)
          }
        } catch {
          if (this.copyLabel) this.copyLabel.textContent = 'brintadeb1453@nyes'
        }
      })
    }

    /**
     * Form Submission: Generates Pre-filled WhatsApp Call Request
     */
    bindForm() {
      if (!this.form) return

      this.form.addEventListener('submit', (e: Event) => {
        e.preventDefault()

        const name = this.nameInput?.value.trim() || 'Client'
        const phone = this.phoneInput?.value.trim() || ''
        const topic = this.topicSelect?.value || 'Consultation & Strategy Call'
        const utr = this.utrInput?.value.trim() || 'Paid via UPI (₹100)'

        if (!phone) {
          if (this.phoneInput) {
            this.phoneInput.focus()
            this.phoneInput.classList.add('has-error')
            setTimeout(() => this.phoneInput?.classList.remove('has-error'), 2000)
          }
          return
        }

        try { audioEngine?.playSuccess?.() } catch (e) {}

        const messageLines = [
          `*PAY TO CALL // 1-ON-1 WHATSAPP CONSULTATION (₹100)*`,
          ``,
          `Hi Brinta! I have paid ₹100 via UPI scanner for a 1-on-1 consultation call.`,
          ``,
          `👤 *Name / Brand:* ${name}`,
          `📞 *WhatsApp:* ${phone}`,
          `🎯 *Call Topic:* ${topic}`,
          `🧾 *UPI Ref / UTR:* ${utr}`,
          ``,
          `Please confirm my booking and let me know your immediate availability for the call!`,
        ]

        const encoded = encodeURIComponent(messageLines.join('\n'))
        // Phone number is obfuscated so it is not visible in plain text anywhere in source or DOM
        const _waTarget = atob('OTE3MDA1NTgxNDUz')
        const targetUrl = `https://wa.me/${_waTarget}?text=${encoded}`

        if (this.feedbackBox && this.feedbackMsg) {
          this.feedbackBox.style.display = 'flex'
          this.feedbackMsg.textContent = `✓ Payment logged for ${name}! Connecting to Brinta Deb on WhatsApp...`
          gsap.fromTo(
            this.feedbackBox,
            { opacity: 0, y: 8 },
            { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }
          )
        }

        setTimeout(() => {
          window.open(targetUrl, '_blank', 'noopener,noreferrer')
        }, 350)
      })
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new PayToCallStation())
  } else {
    new PayToCallStation()
  }
</script>

