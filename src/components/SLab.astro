  },
  {
    id: 'nextjs',
    category: 'architecture',
    categoryLabel: '03 / ARCHITECTURE',
    code: '07',
    name: 'Next.js 15 & React',
    role: 'Fullstack App Router',
    desc: 'Server actions, SSR caching, API routes & production-grade web deployments.',
    icon: '▲',
    accent: '#160000',
    badge: 'FULLSTACK',
    exp: '3+ Yrs',
  },
  {
    id: 'webgl',
    category: '3d-motion',
    categoryLabel: '01 / 3D & MOTION',
    code: '08',
