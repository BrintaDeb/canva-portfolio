---

<section id="lab" class="s-lab" data-intersect>
  <div class="s-lab__wrapper">
    <!-- Top Pill Header (1:1 with SAbout, SSteps, SServices) -->
    <div class="s-lab__pill-header">
      <span class="s-lab__pill-text">SECTION // 05 &bull; THE NOMAD TECH RADAR &bull; AESTHETIC STUDIO</span>
    </div>

    <!-- Outer Bento Grid with Hairline Collapsed Borders -->
    <div class="s-lab__bento">
      <!-- Row 1: Full-Width Section Header Cell -->
      <div class="s-lab__cell s-lab__cell--hero">
        <div class="s-lab__crosshair s-lab__crosshair--tl">+</div>
        <div class="s-lab__crosshair s-lab__crosshair--tr">+</div>
        
        <div class="s-lab__hero-content">
          <div class="s-lab__coords-badge">
            <span class="pulse-dot"></span>
            <span>22.57° N, 88.36° E • KOLKATA // DEPLOYING GLOBALLY</span>
          </div>

          <h2 class="s-lab__title">
            THE CREATIVE <span class="s-lab__title--italic">Nomad Lab</span>
          </h2>

          <p class="s-lab__lead">
            "Most developers can’t design. Most designers can’t write code. I live at the intersection — turning static Canva decks, Figma blueprints, and raw imagination into tactile, production-grade digital reality."
          </p>
        </div>
      </div>

      <!-- Row 2: 2-Column Split (Tech Radar on Left, Chromatic Morpher on Right) -->
      <div class="s-lab__split-row">
        <!-- Left Cell: Tech Capability Deck -->
        <div class="s-lab__cell s-lab__cell--radar">
          <div class="s-lab__crosshair s-lab__crosshair--tl">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--tr">+</div>

          <!-- Architectural Toolbar -->
          <div class="s-lab__toolbar">
            <div class="s-lab__filter-tabs" role="tablist">
              <button class="s-lab__filter-btn is-active js-filter-btn" data-filter="all" type="button">ALL [10]</button>
              <button class="s-lab__filter-btn js-filter-btn" data-filter="3d-motion" type="button">3D &amp; MOTION</button>
              <button class="s-lab__filter-btn js-filter-btn" data-filter="design-systems" type="button">DESIGN</button>
              <button class="s-lab__filter-btn js-filter-btn" data-filter="architecture" type="button">ENGINE</button>
            </div>

            <div class="s-lab__view-toggle">
              <button class="s-lab__toggle-btn is-active js-view-mode" data-mode="grid" type="button" title="Architectural Bento Grid View">
                <span>⊞ BENTO</span>
              </button>
              <button class="s-lab__toggle-btn js-view-mode" data-mode="zero-g" type="button" title="Zero-Gravity Magnetic Float Playground">
                <span>⚛ ZERO-G</span>
              </button>
            </div>
          </div>

          <!-- View 1: Bento Grid Cards -->
          <div class="s-lab__cards-grid js-grid-view">
            {
              techStack.map((item) => (
                <div
                  class="tech-card js-tilt-card"
                  data-category={item.category}
                  style={`--card-accent: ${item.accent};`}
                >
                  <span class="tech-card__mask"></span>
                  <div class="tech-card__sheen js-card-sheen"></div>
                  
                  <div class="tech-card__content">
                    <div class="tech-card__top">
                      <span class="tech-card__code">[{item.code}]</span>
                      <span class="tech-card__badge">{item.badge}</span>
                      <span class="tech-card__exp">{item.exp}</span>
                    </div>

                    <div class="tech-card__body">
                      <div class="tech-card__icon-box">
                        <span class="tech-card__icon">{item.icon}</span>
                      </div>
                      <div class="tech-card__names">
                        <h3 class="tech-card__title">{item.name}</h3>
                        <span class="tech-card__role">{item.role}</span>
                      </div>
                    </div>

                    <p class="tech-card__desc">{item.desc}</p>

                    <div class="tech-card__foot">
                      <span class="tech-card__cat-label">{item.categoryLabel}</span>
                      <span class="tech-card__arrow">→</span>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <!-- View 2: Zero-G Magnetic Floating Field -->
          <div class="s-lab__zerog-container js-zerog-view" style="display: none;">
            <div class="s-lab__zerog-bar">
              <span class="s-lab__zerog-status">
                <span class="pulse-dot"></span>
                <span>MAGNETIC FIELD ACTIVE: DRAG, THROW &amp; BOUNCE TECH NODES</span>
              </span>
              <button class="s-lab__realign-btn js-realign-zerog" type="button">RE-ORBIT NODES</button>
            </div>

            <div class="s-lab__arena js-zerog-canvas" id="zerog-arena">
              {
                techStack.map((item) => (
                  <div
                    class="zerog-badge js-zerog-node"
                    data-name={item.name}
                    style={`--node-accent: ${item.accent};`}
                  >
                    <span class="zerog-icon">{item.icon}</span>
                    <div class="zerog-info">
                      <strong class="zerog-title">{item.name}</strong>
                      <small class="zerog-role">{item.role}</small>
                    </div>
                    <span class="zerog-indicator"></span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right Cell: Aesthetic Chromatic Studio -->
        <div class="s-lab__cell s-lab__cell--studio">
          <div class="s-lab__crosshair s-lab__crosshair--tl">+</div>
          <div class="s-lab__crosshair s-lab__crosshair--tr">+</div>

          <div class="studio-header">
            <div class="studio-header__left">
              <span class="studio-tag">AESTHETIC THEME ENGINE</span>
              <h3 class="studio-title">CHROMATIC MORPHER</h3>
            </div>
            <span class="studio-badge">LIVE COLORWAYS</span>
          </div>

          <p class="studio-desc">
            Shift the portfolio through different aesthetic lenses. Selecting a palette dynamically re-skins the typography, SVG paths, and WebGL canvases across all sections in real time:
          </p>

          <!-- Palettes Deck -->
          <div class="studio-palettes">
            <!-- 1. Editorial Sepia -->
            <button
              class="palette-tile is-active js-theme-switch"
              data-theme="sepia"
              data-primary="#fff2ed"
              data-secondary="#160000"
              data-accent="#ff4d6d"
              type="button"
            >
              <div class="palette-swatch" style="background: linear-gradient(135deg, #fff2ed 50%, #160000 50%); border-color: #160000;"></div>
              <div class="palette-text">
                <div class="palette-top">
                  <strong class="palette-name">Editorial Sepia</strong>
                  <span class="palette-status">DEFAULT</span>
                </div>
                <span class="palette-notes">Warm cream, deep espresso &amp; editorial serif</span>
                <span class="palette-specimen">Aa Bb 123 • 21:1 AAA</span>
              </div>
            </button>

            <!-- 2. Cyberpunk Neon -->
            <button
              class="palette-tile js-theme-switch"
              data-theme="cyberpunk"
              data-primary="#00f0ff"
              data-secondary="#090a0f"
              data-accent="#ff007f"
              type="button"
            >
              <div class="palette-swatch" style="background: linear-gradient(135deg, #00f0ff 50%, #090a0f 50%); border-color: #00f0ff;"></div>
              <div class="palette-text">
                <div class="palette-top">
                  <strong class="palette-name">Cyberpunk Neon</strong>
                  <span class="palette-status">NEON GLOW</span>
                </div>
                <span class="palette-notes">Obsidian dark, laser cyan &amp; electric magenta</span>
                <span class="palette-specimen">Aa Bb 123 • 18:1 AAA</span>
              </div>
            </button>

            <!-- 3. Acid Lime -->
            <button
              class="palette-tile js-theme-switch"
              data-theme="acidlime"
              data-primary="#d4ff00"
              data-secondary="#0d0f0d"
              data-accent="#00ff88"
              type="button"
            >
              <div class="palette-swatch" style="background: linear-gradient(135deg, #d4ff00 50%, #0d0f0d 50%); border-color: #d4ff00;"></div>
              <div class="palette-text">
                <div class="palette-top">
                  <strong class="palette-name">Acid Lime</strong>
                  <span class="palette-status">BRUTALIST</span>
                </div>
                <span class="palette-notes">High-voltage brutalist black &amp; electric neon lime</span>
                <span class="palette-specimen">Aa Bb 123 • 19:1 AAA</span>
              </div>
            </button>

            <!-- 4. Pure Monochrome -->
            <button
              class="palette-tile js-theme-switch"
              data-theme="monochrome"
              data-primary="#f0f0f0"
              data-secondary="#000000"
              data-accent="#999999"
              type="button"
            >
              <div class="palette-swatch" style="background: linear-gradient(135deg, #ffffff 50%, #000000 50%); border-color: #160000;"></div>
              <div class="palette-text">
                <div class="palette-top">
                  <strong class="palette-name">Pure Monochrome</strong>
                  <span class="palette-status">MINIMAL</span>
                </div>
                <span class="palette-notes">Carbon black, architectural white &amp; starkness</span>
                <span class="palette-specimen">Aa Bb 123 • 22:1 AAA</span>
              </div>
            </button>
          </div>

          <!-- Architectural Telemetry Box -->
          <div class="studio-telemetry">
            <div class="telemetry-row">
              <span class="telemetry-label">ACTIVE MATRIX:</span>
              <span class="telemetry-val js-telemetry-values">PRIMARY: #fff2ed | SECONDARY: #160000</span>
            </div>
            <p class="telemetry-quote">
              "Design without technical rigor is just an image. Code without aesthetic nuance is just logic. I merge both into digital art."
            </p>
            <div class="telemetry-footer">
              <span>BRINTA DEB // CREATIVE NOMAD</span>
              <span>4+ YRS EXPERIENCE</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { themeManager } from '../utils/ThemeManager.js'
  import { audioEngine } from '../utils/AudioEngine.js'

  class LabProMax {
    constructor() {
      this.root = document.getElementById('lab')
      if (!this.root) return

      // Mode toggling
      this.viewBtns = this.root.querySelectorAll('.js-view-mode')
      this.gridView = this.root.querySelector('.js-grid-view')
      this.zeroGView = this.root.querySelector('.js-zerog-view')

      // Filtering
      this.filterBtns = this.root.querySelectorAll('.js-filter-btn')
      this.cards = this.root.querySelectorAll('.tech-card')

      // Theme Studio
      this.themeBtns = this.root.querySelectorAll('.js-theme-switch')
      this.telemetryEl = this.root.querySelector('.js-telemetry-values')

      // Zero-G Physics
      this.arena = document.getElementById('zerog-arena')
      this.nodes = Array.from(this.root.querySelectorAll('.js-zerog-node')) as HTMLElement[]
      this.realignBtn = this.root.querySelector('.js-realign-zerog')

      this.zeroGItems = [] as any[]
      this.animId = 0
      this.isZeroGActive = false

      this.init()
    }

    init() {
      this.initCardTilt()
      this.initFilters()
      this.initViewToggle()
      this.initThemes()
      this.initZeroGPhysics()
    }

    /* 3D Holographic Gyroscopic Card Tilt */
    initCardTilt() {
      if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return

      this.cards.forEach((card) => {
        const sheen = card.querySelector('.js-card-sheen') as HTMLElement

        card.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = card.getBoundingClientRect()
          const x = e.clientX - rect.left
          const y = e.clientY - rect.top

          const centerX = rect.width / 2
          const centerY = rect.height / 2

          const rotateX = ((y - centerY) / centerY) * -8
          const rotateY = ((x - centerX) / centerX) * 8

          card.style.transform = `perspective(700px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-3px)`

          if (sheen) {
            sheen.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255, 255, 255, 0.22) 0%, transparent 65%)`
          }
        })

        card.addEventListener('mouseleave', () => {
          card.style.transform = 'perspective(700px) rotateX(0deg) rotateY(0deg) translateY(0)'
          if (sheen) {
            sheen.style.background = 'none'
          }
        })

        card.addEventListener('mouseenter', () => {
          audioEngine.playTab()
        })
      })
    }

    /* Domain Filtering */
    initFilters() {
      this.filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter')
          this.filterBtns.forEach((b) => b.classList.remove('is-active'))
          btn.classList.add('is-active')
          audioEngine.playSnap()

          this.cards.forEach((card) => {
            const cat = card.getAttribute('data-category')
            if (filter === 'all' || cat === filter) {
              card.style.display = 'block'
              card.style.opacity = '1'
            } else {
              card.style.display = 'none'
              card.style.opacity = '0'
            }
          })
        })
      })
    }

    /* Bento Grid vs Zero-G Switcher */
    initViewToggle() {
      this.viewBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-mode')
          this.viewBtns.forEach((b) => b.classList.remove('is-active'))
          btn.classList.add('is-active')
          audioEngine.playChime()

          if (mode === 'zero-g') {
            if (this.gridView) this.gridView.style.display = 'none'
            if (this.zeroGView) this.zeroGView.style.display = 'block'
            this.isZeroGActive = true
            this.realignZeroG()
          } else {
            if (this.gridView) this.gridView.style.display = 'grid'
            if (this.zeroGView) this.zeroGView.style.display = 'none'
            this.isZeroGActive = false
          }
        })
      })
    }

    /* Theme Studio */
    initThemes() {
      const activeTheme = themeManager.getTheme()
      this.updateActiveThemeUI(activeTheme)

      this.themeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const themeId = btn.getAttribute('data-theme')
          if (!themeId) return
          themeManager.setTheme(themeId)
          this.updateActiveThemeUI(themeId)
          audioEngine.playSnap()
        })
      })

      window.addEventListener('theme:change', ((e: CustomEvent) => {
        if (e.detail.theme) {
          this.updateActiveThemeUI(e.detail.theme)
        }
      }) as EventListener)
    }

    updateActiveThemeUI(themeId: string) {
      this.themeBtns.forEach((btn) => {
        const id = btn.getAttribute('data-theme')
        if (id === themeId) {
          btn.classList.add('is-active')
          const p = btn.getAttribute('data-primary')
          const s = btn.getAttribute('data-secondary')
          if (this.telemetryEl && p && s) {
            this.telemetryEl.textContent = `PRIMARY: ${p} | SECONDARY: ${s}`
          }
        } else {
          btn.classList.remove('is-active')
        }
      })
    }

    /* Zero-Gravity Floating Physics Engine */
    initZeroGPhysics() {
      if (!this.arena || this.nodes.length === 0) return

      const arenaRect = this.arena.getBoundingClientRect()
      const w = arenaRect.width || 600
      const h = arenaRect.height || 420

      this.zeroGItems = this.nodes.map((el, i) => {
        const nw = el.offsetWidth || 140
        const nh = el.offsetHeight || 48

        const cols = 3
        const row = Math.floor(i / cols)
        const col = i % cols

        const targetX = 30 + col * ((w - 60) / 3) + (Math.random() * 20 - 10)
        const targetY = 30 + row * 95 + (Math.random() * 20 - 10)

        const item = {
          el,
          x: Math.max(10, Math.min(w - nw - 10, targetX)),
          y: Math.max(10, Math.min(h - nh - 10, targetY)),
          originX: targetX,
          originY: targetY,
          vx: (Math.random() - 0.5) * 1.2,
          vy: (Math.random() - 0.5) * 1.2,
          w: nw,
          h: nh,
          floatPhase: Math.random() * Math.PI * 2,
          isDragging: false,
        }

        this.bindZeroGDrag(item)
        return item
      })

      this.realignBtn?.addEventListener('click', () => {
        this.realignZeroG()
        audioEngine.playChime()
      })

      this.runZeroGLoop()
    }

    realignZeroG() {
      if (!this.arena) return
      const rect = this.arena.getBoundingClientRect()
      const w = rect.width || 600
      const h = rect.height || 420

      this.zeroGItems.forEach((item, i) => {
        const cols = 3
        const row = Math.floor(i / cols)
        const col = i % cols
        item.x = 30 + col * ((w - 60) / 3)
        item.y = 30 + row * 95
        item.vx = (Math.random() - 0.5) * 0.5
        item.vy = (Math.random() - 0.5) * 0.5
      })
    }

    bindZeroGDrag(item: any) {
      const el = item.el
      let offX = 0
      let offY = 0

      const onPointerDown = (e: MouseEvent | TouchEvent) => {
        const cx = 'touches' in e ? e.touches[0].clientX : e.clientX
        const cy = 'touches' in e ? e.touches[0].clientY : e.clientY
        const aRect = this.arena?.getBoundingClientRect()
        if (!aRect) return

        offX = cx - aRect.left - item.x
        offY = cy - aRect.top - item.y

        item.isDragging = true
        el.classList.add('is-dragging')
        audioEngine.playClick()

        const onPointerMove = (me: MouseEvent | TouchEvent) => {
          if (!item.isDragging) return
          const mcx = 'touches' in me ? me.touches[0].clientX : me.clientX
          const mcy = 'touches' in me ? me.touches[0].clientY : me.clientY
          const arenaRect = this.arena?.getBoundingClientRect()
          if (!arenaRect) return

          const newX = mcx - arenaRect.left - offX
          const newY = mcy - arenaRect.top - offY

          item.vx = (newX - item.x) * 0.45
          item.vy = (newY - item.y) * 0.45
          item.x = newX
          item.y = newY
        }

        const onPointerUp = () => {
          item.isDragging = false
          el.classList.remove('is-dragging')
          window.removeEventListener('mousemove', onPointerMove)
          window.removeEventListener('mouseup', onPointerUp)
          window.removeEventListener('touchmove', onPointerMove)
          window.removeEventListener('touchend', onPointerUp)
          audioEngine.playTab()
        }

        window.addEventListener('mousemove', onPointerMove)
        window.addEventListener('mouseup', onPointerUp)
        window.addEventListener('touchmove', onPointerMove)
        window.addEventListener('touchend', onPointerUp)
      }

      el.addEventListener('mousedown', onPointerDown)
      el.addEventListener('touchstart', onPointerDown, { passive: true })
    }

    runZeroGLoop() {
      const tick = () => {
        if (this.isZeroGActive && this.arena) {
          const rect = this.arena.getBoundingClientRect()
          const w = rect.width
          const h = rect.height

          for (let i = 0; i < this.zeroGItems.length; i++) {
            const item = this.zeroGItems[i]

            if (!item.isDragging) {
              item.floatPhase += 0.02
              const floatOffsetY = Math.sin(item.floatPhase) * 0.35

              item.x += item.vx
              item.y += item.vy + floatOffsetY
              item.vx *= 0.97
              item.vy *= 0.97

              // Inter-Node Repulsion
              for (let j = i + 1; j < this.zeroGItems.length; j++) {
                const other = this.zeroGItems[j]
                const dx = other.x - item.x
                const dy = other.y - item.y
                const dist = Math.hypot(dx, dy)
                const minDist = 90
                if (dist < minDist && dist > 0.1) {
                  const force = (minDist - dist) * 0.03
                  const fx = (dx / dist) * force
                  const fy = (dy / dist) * force
                  if (!item.isDragging) {
                    item.vx -= fx
                    item.vy -= fy
                  }
                  if (!other.isDragging) {
                    other.vx += fx
                    other.vy += fy
                  }
                }
              }

              // Elastic boundary walls
              const pad = 10
              if (item.x < pad) {
                item.x = pad
                item.vx = -item.vx * 0.8
              } else if (item.x + item.w > w - pad) {
                item.x = w - item.w - pad
                item.vx = -item.vx * 0.8
              }

              if (item.y < pad) {
                item.y = pad
                item.vy = -item.vy * 0.8
              } else if (item.y + item.h > h - pad) {
                item.y = h - item.h - pad
                item.vy = -item.vy * 0.8
              }
            }

            item.el.style.transform = `translate3d(${item.x.toFixed(1)}px, ${item.y.toFixed(1)}px, 0)`
          }
        }

        this.animId = requestAnimationFrame(tick)
      }
      this.animId = requestAnimationFrame(tick)
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new LabProMax())
  } else {
    new LabProMax()
  }
</script>

