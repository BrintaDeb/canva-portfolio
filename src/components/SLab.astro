---
/**
 * SLab.astro
 * The Creative Nomad Lab & Tech Radar
 * Redesigned 1:1 to adhere to the website's Architectural Swiss-Bento UI/UX Theory:
 * - Warm Cream Primary Canvas: color(primary)
 * - Sharp Espresso Hairline Borders: 1px solid color(secondary)
 * - Corner Crosshairs (+) & Monospace Technical Indexing
 * - Kinetic Hover Inversion: cells invert to color(secondary) on hover
 * - 3D Gyroscopic Tilt & Holographic Specular Sheen
 * - Dual Mode: Architectural Bento Grid vs Zero-G Magnetic Floating Field
 * - Chromatic Morpher Studio matching the editorial aesthetic
 */
const techStack = [
  {
    id: 'threejs',
    category: '3d-motion',
    categoryLabel: '01 / 3D & MOTION',
    code: '01',
    name: 'Three.js',
    role: 'WebGL & 3D Shaders',
    desc: 'Interactive 3D viewports, procedural geometries, camera choreography & lighting.',
    icon: '🌐',
    accent: '#00c8d7',
    badge: '3D CORE',
    exp: '3+ Yrs',
  },
  {
    id: 'canva',
    category: 'design-systems',
    categoryLabel: '02 / DESIGN SYSTEMS',
    code: '02',
    name: 'Canva Pro',
    role: 'Brand Systems & Decks',
    desc: 'Bespoke corporate presentation decks, brand toolkits & marketing systems.',
    icon: '🎨',
    accent: '#7d2ae8',
    badge: 'SIGNATURE',
    exp: '4+ Yrs',
  },
  {
    id: 'figma',
    category: 'design-systems',
    categoryLabel: '02 / DESIGN SYSTEMS',
    code: '03',
    name: 'Figma',
    role: 'UI/UX Architecture',
    desc: 'Design tokens, auto-layout components, interactive wireframes & prototypes.',
    icon: '📐',
    accent: '#f24e1e',
    badge: 'WIREFRAMES',
    exp: '4+ Yrs',
  },
  {
    id: 'astro',
    category: 'architecture',
    categoryLabel: '03 / ARCHITECTURE',
    code: '04',
    name: 'Astro 5',
    role: 'Zero-JS Islands Engine',
    desc: 'High-speed content collections, static generation & sub-1s LCP loading.',
    icon: '🚀',
    accent: '#e64a00',
    badge: 'ULTRA FAST',
    exp: '2+ Yrs',
  },
  {
    id: 'gsap',
    category: '3d-motion',
    categoryLabel: '01 / 3D & MOTION',
    code: '05',
    name: 'GSAP Motion',
    role: 'ScrollTrigger Timelines',
    desc: 'Physics scrubbers, kinetic typography, magnetic cursors & smooth pinning.',
    icon: '✨',
    accent: '#6ea800',
    badge: 'KINETIC FX',
    exp: '3+ Yrs',
  },
  {
    id: 'procreate',
    category: 'design-systems',
    categoryLabel: '02 / DESIGN SYSTEMS',
    code: '06',
    name: 'Procreate',
    role: 'Digital Art & Sketching',
    desc: 'Custom anime character art, textured brushes & bespoke visual illustrations.',
    icon: '🖌️',
